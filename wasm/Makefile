# javelina WASM runtime — build + differential test suite.
# `make test` reproduces the whole pipeline: opgen generates the interpreter +
# stencils + JIT metadata from spec/wasm.def; jitterator turns the compiled
# stencils into the stencil table; then every gate builds and runs (interp == JIT).

# ── the BBQ toolchain ──────────────────────────────────────────────
# Everything generated here comes out of BBQ, which ships as a submodule at the
# repo root. Point BBQ elsewhere to build against another checkout: on the
# command line, in the environment, or in a config.mk beside the root Makefile.
-include ../config.mk
BBQ        ?= ../BBQ

OPGEN      := $(BBQ)/build/opgen/opgen
JITTERATOR := $(BBQ)/build/jitterator/jitterator
BBQC       := $(BBQ)/build/bbqc
PEGC       := $(BBQ)/build/pegc/pegc
ASDL       := $(BBQ)/build/asdl/asdl
BURGC      := $(BBQ)/build/burgc/burgc
PEG_FRAMES := spec/peg_frames   # javelina's OWN copy of the pegc C frames; WAT-specific frame
                                # tweaks (the §6.2.5 annotation skip) live here, NOT the shared template
RT         := $(BBQ)/backends/c/runtime
JITRT      := $(BBQ)/jitterator/runtime
CRT        := $(BBQ)/crt
PEGRT      := $(BBQ)/pegc/runtime
BBQ_TEMPLATES := $(BBQ)/backends/render/templates

# An absent BBQ is the one state make cannot fix for itself: fetching it is a
# network operation, and which checkout to use is the user's call. Say so here
# rather than letting it surface as "No rule to make target '../BBQ/crt/…'".
# An UNBUILT BBQ is not an error at all — see the toolchain rule below. Only
# `clean` and `help` are exempt, since neither reads the toolchain.
ifneq ($(filter-out clean help,$(or $(MAKECMDGOALS),all)),)
ifeq ($(wildcard $(BBQ)/CMakeLists.txt),)
$(error no BBQ toolchain at '$(BBQ)' — javelina is generated by BBQ \
        (https://github.com/dan-eicher/BBQ), vendored as a submodule: run \
        `git submodule update --init BBQ` at the repo root, or set BBQ=<path> \
        to another checkout)
endif
endif

# TOML reader (pinched from yoctojc) — used by test_instr to read the
# spec-derived opcode table spec/instructions.toml. Vendored generated parser +
# resolver, and -Werror like everything else: generated code that warns is a
# GENERATOR bug, not a reason to stop reading warnings here.
TOML_OBJS   = $(B)/toml_parser.o $(B)/toml_doc.o   # bbq_arena.o is in OBJS (test_instr links both)
TOML_INC   := -Isrc -Isrc/gen -Iinclude -I$(PEGRT) -I$(CRT)   # -Isrc: toml_doc.h lives beside toml_doc.c (not a public header)

CC      := clang
# The VM substrate (frame_t/vm_t/heap_t) is named to opgen by the `backend "jav_frame.h"`
# directive in spec/wasm.def, which opgen #includes into the generated runtime_api.h.
# -MMD -MP: emit a .d dependency file per object listing EVERY included header — including
# the BBQ runtime headers under $(RT)/$(CRT) that live outside this tree — so a change to,
# say, bbq_read.h rebuilds the objects that include it. No more manual cleans to pick up
# upstream header edits. The .d files are pulled in via the -include at the bottom.
# -Iinclude: jav_limits.h — the per-frame caps the engine enforces and javelinac must respect.
# -g at -O2 changes no code, and without it a profile cannot attribute anything
# inside this engine: callgrind collapses the static functions of a TU onto
# whichever symbol is nearest, so `jit_compile` appears to call functions its
# source never mentions. The compiler's own TUs already build this way.
CFLAGS  := -g -O2 -std=c11 -Wall -Werror -MMD -MP -Isrc -Isrc/gen -Isrc/immix -Iinclude -I$(RT) -I$(JITRT) -I$(CRT)
# -fno-vectorize/-fno-slp-vectorize: a copy-and-patch stencil must be position-independent
# and relocation-free, but clang's auto-vectorizer emits .rodata vector constants (mask
# tables) the JIT can't relocate (jitterator rejects them). Keeping the SIMD lane loops
# SCALAR in the stencils is the "supported" tier — correct, both tiers; hardware-SIMD
# codegen (the "optimized" tier) is deferred. The interp (gen_interp.c) still vectorizes.
STENCIL_CFLAGS := -O2 -Wall -Werror -fno-stack-protector -fno-asynchronous-unwind-tables -fno-vectorize -fno-slp-vectorize -MMD -MP -Isrc -Isrc/gen -Isrc/immix -Iinclude -I$(RT) -I$(CRT)

GEN     := src/gen
B       := build
# SAN=1 — engine, runtime and tests under AddressSanitizer, in their own
# build dir. STENCIL_CFLAGS is deliberately untouched: the stencils are
# extracted MACHINE CODE, and a sanitizer call baked into copied bytes is a
# landmine, not a detector — the stamped code's raw slot accesses simply go
# unchecked while every C path around them is checked. The link recipes pass
# $(CFLAGS), so the runtime links in without extra plumbing.
ifeq ($(SAN),1)
CFLAGS += -fsanitize=address -fno-omit-frame-pointer
B      := build-asan
endif
# PROFILE=1 — -O0 with frame pointers, its own build dir: the -O2 inliner
# smears costs across callers and erases the call counts a recompute-vs-cache
# question needs, so a profile of the optimized build attributes work to the
# wrong functions and misses N-times-what-should-be-once entirely.
ifeq ($(PROFILE),1)
CFLAGS := $(filter-out -O2,$(CFLAGS)) -O0 -fno-omit-frame-pointer
B      := build-prof
endif
GC_OBJS := $(B)/immix_line_map.o $(B)/immix_block.o $(B)/immix_block_allocator.o \
           $(B)/immix_space.o $(B)/jav_gc.o
# The VM engine — the runtime, with NO owning reader/writer: the VM loads via the c-lite
# zero-copy reader, never the owning tree. The owning reader/writer are a separate group
# (water + the owning-reader tests link them; the c-lite load path test_load does not).
ENGINE_OBJS := $(B)/interp.o $(B)/jav_runtime.o $(B)/gen_interp.o $(B)/validate.o \
               $(B)/jav_subtype.o $(B)/jit_driver.o $(B)/jav_ttree.o $(B)/jav_tile.o \
               $(B)/jav_eqsat.o $(B)/egraph.o \
               $(B)/bbq_arena.o $(B)/bbq_hmap.o $(B)/bbq_htree.o \
               $(GC_OBJS)
OWNING_OBJS := $(B)/jav_reader.o $(B)/jav_writer.o $(B)/jav_utf8.o
OBJS    := $(ENGINE_OBJS) $(OWNING_OBJS)
# The c-lite load path: the self-contained zero-copy reader + nav + its runtime,
# linked with $(ENGINE_OBJS) (NOT the owning reader) into the VM's overlay-driven
# load tests (test_load / test_skeleton / test_div).
CLITE_SRCS := src/jav_view_nav.c src/jav_module_index.c src/jav_module_validate.c src/jav_instance.c src/jav_extern.c src/jav_error.c $(GEN)/jav_view_reader.c $(RT)/bbq_lite.c src/jav_utf8.c


# The validated gates (interp == JIT differential + interp execution).
TESTS   := test_ops test_locals test_control test_brtable test_globals_mem test_probe \
           test_call test_host test_tiers test_trap_reason test_jit_holes \
           test_jit_numeric test_jit_native test_jit_libm test_jit_sweep \
           test_jit_control test_jit_brtable test_jit_trap test_jit_trunc test_jit_tier2 \
           test_eqsat \
           test_jit_trunc_sat test_const_expr test_multivalue test_typecheck \
           test_call_indirect test_reftypes test_table_ops test_br_on test_i31 test_gc_roots \
           test_struct test_struct_gc test_array test_array_gc test_refcast test_br_on_cast test_gc_ctors test_gc_packed test_gc_segments test_refmore test_bulk_mem test_subword_memops test_select test_call_ref test_simd_loadext test_simd_compute test_typemodel test_exceptions test_depth test_tailcall test_simd test_multimem test_memory64 test_carrier_addr_tag

.PHONY: all test clean gen water
all: $(OBJS) water

# ── the BBQ toolchain, built on demand ─────────────────────────────
# Every generator below is a prerequisite of a generation rule, so make needs a
# rule that BUILDS them: a checked-out-but-unbuilt submodule is a state to fix,
# not to report. One cmake build produces all four, so they are a GROUPED
# target (&:) — ungrouped, a parallel make would launch one cmake per missing
# generator. No prerequisites: this fires only when a binary is ABSENT, so a
# built toolchain is never rebuilt behind your back. `make bbq` at the root is
# the explicit rebuild after editing BBQ itself.
$(OPGEN) $(JITTERATOR) $(BBQC) $(PEGC) $(ASDL) $(BURGC) &:
	cmake -S $(BBQ) -B $(BBQ)/build
	cmake --build $(BBQ)/build -j$$(nproc)

# ── code generation ────────────────────────────────────────────────
# opgen: one declarative spec -> interpreter handlers + stencils + JIT metadata.
gen: $(GEN)/gen_interp.c $(GEN)/jav_reader.c $(GEN)/jav_trap_reason.h
# opgen writes ALL of these from one invocation — a GROUPED target (&:) so make knows every
# one derives from wasm.def and regenerates them together. Without this, only gen_interp.c
# was a known output, so jav_stencils.c / runtime_api.h / jav_jit_meta.h changes after a
# wasm.def edit weren't tracked → stale stencil table + objects (the bug this fixes).
$(GEN)/gen_interp.c $(GEN)/gen_interp.h $(GEN)/jav_stencils.c $(GEN)/opcodes.h \
$(GEN)/opcode_tables.c $(GEN)/runtime_api.h $(GEN)/jav_jit_meta.h $(GEN)/jav_valtype.h \
$(GEN)/jav_type_meta.h $(GEN)/jav_jit_symbols.h $(GEN)/jav_sigtab.h \
$(GEN)/jav_ttree.asdl &: spec/wasm.def $(OPGEN) $(B)/tier2_n.stamp
	$(OPGEN) -i spec/wasm.def -prefix jav -tier2 $(TIER2_N) -o $(GEN)

# The tiling grammar. NOT an opgen output: a rule's cost is the size of the code
# it stamps, and that size does not exist until the stencils are compiled and
# jitterator has measured them — downstream of opgen. Generating it from the
# measurement is also what makes §2.5's omission rule automatic: a (signature,
# state) pair the variant family does not provide simply has no rule.
# TIER2_N is Ertl's cache size — ONE number for the whole tier: opgen emits the
# variant family for it, and the grammar is generated against the table that
# produces. They cannot differ, or the tiling picks a state whose stencil was
# never generated.
#
# The default is the SHIPPING cache size, and the checked-in generated files are
# its output — so a plain `make`/`make test` reproduces the tree it was built from
# and gates the engine that ships. It defaulted to 0 (tier-1 only), which meant an
# ordinary `make test` regenerated the whole variant family at 0, printed the same
# "conformance [tier-2]: ... 0 mismatched" it prints at any n, and left the working
# tree rewritten — a green measuring an engine nobody ships, for anyone who did not
# know to pass the flag. Override it to sweep sizes (`make TIER2_N=3 test`); 0 is
# tier-1 only.
TIER2_N ?= 8

# The JIT tiers the corpus runs on — EVERY one of them, beside the interpreter leg.
# This named a single tier and was set to 2, which left tier-1 — the DEFAULT tier, the
# one that ships — as the only engine the 60,113 execution assertions never executed.
# G1's gate is tier-1 against tier-2, and neither is checked by not being run.
#
# Tier-2 runs at every cache size: the tree builds and the cover runs regardless of how
# many registers there are, and at TIER2_N=0 the stitch meters report the zeroes rather
# than the run reporting a tier it did not exercise.
#
# Tier-3 is tier-2 with the eq-sat rewrite between build and reduce; with the
# rule set empty its code must be tier-2's byte for byte, and test.mk compares
# the two runs' code lines as PIN B-1's other half.
JIT_TIERS := 1 2 3

# ...and it has to be a DEPENDENCY, not just a variable. `make TIER2_N=1` on a
# tree built at 0 rebuilt nothing, so the tier appeared to pass the whole
# conformance corpus while the artifacts under test were still tier-1's. A
# generated file that does not depend on the number that generated it is a green
# measuring the wrong build.
# The phony driver is what makes this work: a stamp with no prerequisites is
# "up to date" the moment it exists, so its recipe would run exactly once and
# never notice the value changing again. This re-checks every run and rewrites
# the file ONLY when the number differs, so the mtime moves when — and only
# when — the generated outputs are genuinely stale.
.PHONY: tier2-stamp
tier2-stamp: | $(B)
	@[ "$$(cat $(B)/tier2_n.stamp 2>/dev/null)" = "$(TIER2_N)" ] \
	  || echo "$(TIER2_N)" > $(B)/tier2_n.stamp
$(B)/tier2_n.stamp: tier2-stamp ;
# jav_ttree.h is a real prerequisite, not an incidental include: it defines the
# packing the ACTION writes and the stitcher reads. Leave it out and the two ends
# disagree silently — the generator emits one width, the reader unpacks another,
# and every slot decodes as some other class.
$(B)/gen_tile_burg: tools/gen_tile_burg.c src/jav_ttree.h $(GEN)/jav_tnode.h $(GEN)/jav_sigtab.h $(GEN)/jav_stencil_table.h | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror -Isrc -Isrc/gen -I$(RT) -I$(CRT) $< -o $@
$(GEN)/jav_tile.burg: $(B)/gen_tile_burg $(B)/tier2_n.stamp
	$(B)/gen_tile_burg -n $(TIER2_N) -o $@

# The matcher itself: burgc's C backend over the grammar. Aho-Ganapathi-Tjiang
# labelling picks the minimum-cost cover, and the costs are the measured stencil
# sizes, so "cheapest cover" means "fewest bytes stamped".
$(GEN)/jav_tile.c $(GEN)/jav_tile.h &: $(GEN)/jav_tile.burg $(BURGC)
	$(BURGC) -i $(GEN)/jav_tile.burg -lang c -frames $(BBQ)/burgc/frames -o $(GEN)/jav_tile.h

# The tier-2 tiling grammar's coverage claim. burgc's shape enumeration is only a
# real claim when the IR schema is AST-shaped — each ASDL constructor's node
# fields matching the burg pattern's children — otherwise burgc detects the arity
# mismatch and falls back to a heuristic filter that checks nothing. Both come out
# of the same opgen walk, which is what makes the match hold.
$(GEN)/jav_ttree.json: $(GEN)/jav_ttree.asdl $(ASDL)
	$(ASDL) -i $< --json $@
# The tree node the tier-2 builder allocates, generated from the SAME schema the
# tiling grammar's coverage is checked against — one artifact reaching C twice,
# instead of a hand-written struct the schema merely resembled. The local inja
# template (the compiler's SIR precedent) holds the representation choice: one
# uniform node over the schema's seven typed sums, tag values == sigtab indices
# because sigemit renumbers the ids into the schema's own declaration order.
$(GEN)/jav_tnode.h: $(GEN)/jav_ttree.asdl spec/templates/jav_tnode.inja $(ASDL)
	$(ASDL) -i $(GEN)/jav_ttree.asdl -t spec/templates/jav_tnode.inja -o $@ -l c
.PHONY: tile-coverage
# --asdl-strict because both files come out of ONE opgen walk: a terminal whose
# constructor arity disagrees with its pattern is a generator bug, not a
# slot-based IR, and without the flag burgc quietly demotes it to the heuristic
# filter and passes.
tile-coverage: $(GEN)/jav_tile.burg $(GEN)/jav_ttree.json $(BURGC)
	$(BURGC) -i $(GEN)/jav_tile.burg -asdl $(GEN)/jav_ttree.json --coverage --strict --asdl-strict

# Note: spec/instructions.toml (the §5.4 opcode table consumed by test_instr) is
# a committed artifact, generated once from the spec reference decoder via the
# offline tool tools/gen_instr_toml.py — deliberately NOT a build step.

# The execution-trap vocabulary. UNLIKE the toml itself this IS a build step: it
# joins instructions.toml's `traps` (the canonical §7.10 message text) with the
# `error:` guard names wasm.def declares, and fails the build if wasm.def names a
# reason the spec table doesn't carry — so it has to run on every wasm.def edit,
# not offline.
$(B)/gen_trap_reasons: tools/gen_trap_reasons.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -Isrc/gen \
	  tools/gen_trap_reasons.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o -o $@
$(GEN)/jav_trap_reason.h: spec/instructions.toml spec/wasm.def $(B)/gen_trap_reasons
	$(B)/gen_trap_reasons spec/instructions.toml spec/wasm.def $(GEN)/jav_trap_reason.h

# bbqc again for the §7.7.1 name section — its grammar runs over a name
# custom section's PAYLOAD, so it is its own little reader beside the module
# one, with its own prefix. Only the reader is linked; water reads names for
# identifiers and never writes them (§7.7.3: the @custom annotation carries
# the section itself).
$(GEN)/jnm_reader.c $(GEN)/jnm_reader.h $(GEN)/jnm_types.h: spec/wasm_names.bbq $(BBQC) $(BBQ_TEMPLATE_SRCS)
	$(BBQC) spec/wasm_names.bbq -backend c -prefix jnm -templates $(BBQ_TEMPLATES) -o $(GEN)/

# ── water's render tree (wasm → wat) ───────────────────────────────────────
# The module half's authority is spec/wat_module.asdl, hand-authored; the json
# sidecar is how tools read it (asdl's own parse, never a hand scan).
$(GEN)/wat_module.json: spec/wat_module.asdl $(ASDL)
	$(ASDL) -i $< --json $@
$(B)/gen_wat_ir: tools/gen_wat_ir.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -Isrc/gen \
	  tools/gen_wat_ir.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o -o $@
# ONE walk, four projections (schema ⊕ per-instruction constructors, grammar
# with own-literal costs, render rows made of the same literals, the
# production inventory) — they cannot disagree because they are one loop, and
# test_wast's `wat width honesty` counter gates the width sum against emitted
# bytes anyway.
$(GEN)/wat_ir.asdl $(GEN)/wat_layout.burg $(GEN)/wat_render.h &: \
		spec/wat_module.asdl $(GEN)/wat_module.json spec/instructions.toml $(B)/gen_wat_ir
	$(B)/gen_wat_ir spec/wat_module.asdl $(GEN)/wat_module.json spec/instructions.toml $(GEN)
$(GEN)/wat_ir.json: $(GEN)/wat_ir.asdl $(ASDL)
	$(ASDL) -i $< --json $@
# The node the builder allocates, generated from the SAME schema the layout
# grammar's coverage is checked against, exactly as jav_tnode.h is for the
# tiling grammar. Tag values == burg TERM ids by declaration order;
# test_wat_layout compares the ends name-for-name.
$(GEN)/wat_tnode.h: $(GEN)/wat_ir.asdl spec/templates/wat_tnode.inja $(ASDL)
	$(ASDL) -i $(GEN)/wat_ir.asdl -t spec/templates/wat_tnode.inja -o $@ -l c
$(GEN)/wat_layout.c $(GEN)/wat_layout.h &: $(GEN)/wat_layout.burg $(BURGC)
	$(BURGC) -i $(GEN)/wat_layout.burg -lang c -frames $(BBQ)/burgc/frames -o $(GEN)/wat_layout.h
.PHONY: wat-coverage
# Mirrors tile-coverage verbatim, for the same reason: both sides of the check
# come out of one generator walk, so an arity disagreement is a generator bug
# and --asdl-strict keeps burgc from demoting it to the heuristic filter.
wat-coverage: $(GEN)/wat_layout.burg $(GEN)/wat_ir.json $(BURGC)
	$(BURGC) -i $(GEN)/wat_layout.burg -asdl $(GEN)/wat_ir.json --coverage --strict --asdl-strict

# ── tier-3: the eq-sat pass's generated artifacts ─────────────────────────
# The e-node admission fence, from the same spec table (D2 of the tier-3 plan:
# one authority, never a hand list in jav_eqsat.c).
$(B)/gen_eqsat_ops: tools/gen_eqsat_ops.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -Isrc/gen \
	  tools/gen_eqsat_ops.c $(B)/toml_parser.o $(B)/toml_doc.o $(B)/bbq_arena.o -o $@
$(GEN)/jav_eqsat_ops.h: spec/instructions.toml $(B)/gen_eqsat_ops
	$(B)/gen_eqsat_ops spec/instructions.toml $@
# The saturating pass over the axiom file: one matcher per rule plus
# jav_eqsat_rewrite_region(egraph*, eg_caps). A separate burgc INVOCATION from
# the tiler's — the two grammars share nothing but the terminal vocabulary,
# and the emitted header defines its functions, so exactly one translation
# unit (jav_eqsat.c) includes it.
$(GEN)/jav_rewrite.h: spec/jav_axioms.burg $(BURGC)
	$(BURGC) -i spec/jav_axioms.burg --rewrite -name jav_eqsat -lang c -o $@
# The e-graph runtime, straight from BBQ (C11, bbq_vec) — linked like any crt
# object, per the tool boundary: generated output and runtime files only.
$(B)/egraph.o: $(BBQ)/burgc/runtime/egraph.c $(BBQ)/burgc/runtime/egraph.h | $(B)
	$(CC) $(CFLAGS) -I$(BBQ)/burgc/runtime -c $< -o $@
$(B)/jav_eqsat.o: src/jav_eqsat.c src/jav_eqsat.h src/jav_ttree.h $(GEN)/jav_rewrite.h \
                  $(GEN)/jav_eqsat_ops.h $(GEN)/jav_tnode.h $(GEN)/opcodes.h | $(B)
	$(CC) $(CFLAGS) -I$(BBQ)/burgc/runtime -c $< -o $@

# The inja templates bbqc renders through are as much an input as the grammar and the
# binary: editing one changes the emitted C. Listing them keeps a template edit from
# leaving a stale reader in $(GEN) that builds and passes.
BBQ_TEMPLATE_SRCS := $(wildcard $(BBQ_TEMPLATES)/*.inja)

# bbqc: the module container grammar -> reader + writer + types (one source: wasm.bbq).
$(GEN)/jav_reader.c $(GEN)/jav_reader.h $(GEN)/jav_writer.c $(GEN)/jav_writer.h $(GEN)/jav_types.h: spec/wasm.bbq $(BBQC) $(BBQ_TEMPLATE_SRCS)
	$(BBQC) spec/wasm.bbq -backend c -prefix jav -templates $(BBQ_TEMPLATES) -o $(GEN)/

# bbqc c-lite: the zero-copy span-index reader — the VM's module-load read path
# (mmap + decode-on-access, no owning tree). A distinct -prefix so it coexists
# with the owning reader above; the runtime is $(RT)/bbq_lite.c.
$(GEN)/jav_view_reader.c $(GEN)/jav_view_reader.h: spec/wasm.bbq $(BBQC) $(BBQ_TEMPLATE_SRCS)
	$(BBQC) spec/wasm.bbq -backend c-lite -prefix jav_view -templates $(BBQ_TEMPLATES) -o $(GEN)/

# The .wat reader's mnemonic table, generated from the SAME instructions.toml the
# compiler's wasm_ops.h and jav_trap_reason.h come from. It used to be read at
# RUNTIME, which is why `water` carried an -i/--instrs flag and every .wat gate had
# to run from a cwd where the relative path resolved. Build-time now; `water` is a
# standalone binary. (test_instr still reads the toml at runtime, deliberately: it
# walks the table as DATA to sweep every instruction.)
$(GEN)/wat_mnemonics.h: spec/instructions.toml tools/gen_wat_mnemonics.py
	python3 tools/gen_wat_mnemonics.py spec/instructions.toml > $@

# pegc: the §6 text grammar -> the .wat reader, building the SAME jav_module_t
# the binary reader produces (struct is the contract; oracle = struct-equivalence).
# The frame files are real inputs — pegc splices them into the emitted parser —
# so a frame edit regenerates it (a frame/runtime API drift once surfaced only
# as a build break on the NEXT unrelated regeneration).
$(GEN)/wat_parser.c $(GEN)/wat_parser.h: spec/wat.peg $(PEGC) $(GEN)/wat_mnemonics.h \
                                         $(wildcard spec/peg_frames/*.frame)
	$(PEGC) spec/wat.peg -lang c -frames $(PEG_FRAMES) -prefix wat -o $(GEN)/

# jitterator: compiled stencils -> the copy-and-patch stencil table. opgen emits
# both the per-opcode stencils and the machine-boundary machinery (entry/halt/
# resync/trap) into jav_stencils.c, so jitterator runs on it directly.
$(GEN)/jav_stencil_table.h: $(GEN)/jav_stencils.c src/jav_frame.h $(GEN)/gen_interp.c $(GEN)/jav_trap_reason.h $(JITTERATOR) | $(B)
	$(CC) $(STENCIL_CFLAGS) -c $(GEN)/jav_stencils.c -o $(B)/jav_stencils.o
	$(JITTERATOR) $(B)/jav_stencils.o -o $(GEN)/jav_stencil_table.h

# ── objects ────────────────────────────────────────────────────────
# The toolchain probe, run once per build tree (this recipe fires only when $(B)
# is created, so it costs one compiler invocation per `make clean`).
#
# The interpreter and every copy-and-patch stencil are threaded: each handler
# musttail-jumps to its successor, so `__attribute__((musttail))` is load-bearing
# — without the guaranteed tail call the chain becomes ordinary calls and a long
# function body overflows the C stack. GCC did not support the attribute until
# 15, and what it emits instead is
#
#     src/interp.c:24:10: error: expected identifier or '(' before 'return'
#
# from inside a header chain, which reads as a corrupt source tree rather than as
# a compiler that is missing a feature. Say the real thing instead.
define TOOLCHAIN_PROBE
printf '%s\n' 'void g(void);' 'void f(void){ __attribute__((musttail)) return g(); }' \
  | $(CC) -std=c11 -xc - -c -o /dev/null 2>/dev/null \
  || { echo ""; \
       echo "  $(CC) does not support __attribute__((musttail))."; \
       echo ""; \
       echo "  javelina's interpreter and JIT stencils are threaded — each handler"; \
       echo "  musttail-jumps to the next — so the attribute is required, not preferred."; \
       echo "  Build with clang 13 or newer (or GCC 15+):   make CC=clang"; \
       echo ""; exit 1; }
endef
$(B):
	@$(TOOLCHAIN_PROBE)
	mkdir -p $(B)
$(B)/interp.o:       src/interp.c       $(GEN)/gen_interp.c $(GEN)/jav_trap_reason.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/jav_runtime.o: src/jav_runtime.c $(GEN)/gen_interp.c $(GEN)/jav_trap_reason.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/validate.o:     src/validate.c     $(GEN)/jav_stencil_table.h $(GEN)/gen_interp.c $(GEN)/jav_trap_reason.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/gen_interp.o:   $(GEN)/gen_interp.c $(GEN)/jav_trap_reason.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
# -MMD -MP like everything else: without it these two carried NO header
# dependencies, so a header change left them stale. That stayed invisible because
# gen_trap_reasons only RUNS when it is relinked — the stale pair segfaulted the
# generator the first time a rebuild happened to trigger it.
$(B)/toml_parser.o:  src/gen/toml_parser.c | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror -MMD -MP $(TOML_INC) -c $< -o $@
$(B)/toml_doc.o:     src/toml/toml_doc.c | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror -MMD -MP $(TOML_INC) -c $< -o $@
$(B)/bbq_arena.o:    $(CRT)/bbq_arena.c | $(B)
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -c $< -o $@
$(B)/bbq_hmap.o:     $(CRT)/bbq_hmap.c | $(B)   # jit_driver's footer-pool dedup map
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -c $< -o $@
$(B)/bbq_htree.o:    $(CRT)/bbq_htree.c | $(B)   # burgc's matcher state cache (jav_tile.c)
	$(CC) -O2 -std=c11 -Wall -Werror $(TOML_INC) -c $< -o $@
$(B)/jav_reader.o:  $(GEN)/jav_reader.c | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/jav_writer.o:  $(GEN)/jav_writer.c | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/jav_utf8.o:    src/jav_utf8.c src/jav_utf8.h | $(B)   # §5.2.4 name validator, shared by all readers
	$(CC) $(CFLAGS) -c $< -o $@
$(B)/jav_subtype.o: src/jav_subtype.c src/jav_subtype.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
# The tier-2 tree builder. Its include set is the point: the generated tables and
# the crt, and NOT validate.h — the two walks share a generator, not a header.
$(B)/jav_ttree.o:   src/jav_ttree.c src/jav_ttree.h $(GEN)/jav_tnode.h $(GEN)/jav_sigtab.h | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
# burgc's generated matcher. -Wno-unused-function: the labeller emits a helper
# per nonterminal and a grammar this wide does not reach all of them.
$(B)/jav_tile.o:    $(GEN)/jav_tile.c $(GEN)/jav_tile.h src/jav_ttree.h $(GEN)/jav_tnode.h | $(B)
	$(CC) $(CFLAGS) -Wno-unused-function -c $< -o $@
$(B)/jit_driver.o:   src/jit_driver.c $(GEN)/jav_stencil_table.h $(GEN)/gen_interp.c | $(B)
	$(CC) $(CFLAGS) -c $< -o $@
$(GC_OBJS): $(B)/%.o: src/immix/%.c | $(B)
	$(CC) $(CFLAGS) -c $< -o $@

# ── the ported Immix GC engine (standalone: pure C, bbq_vec, no generated runtime) ──
IMMIX_SRC    := src/immix/immix_line_map.c src/immix/immix_block.c \
                src/immix/immix_block_allocator.c src/immix/immix_space.c src/immix/jav_gc.c
IMMIX_TESTS  := test_immix_line test_immix_block test_immix_pool test_immix_space test_gc test_gc_churn test_gc_evac_stress test_gc_los test_gc_verify
IMMIX_CFLAGS := -O2 -std=c11 -Wall -Werror -Isrc/immix -I$(CRT)

# ── tests ──────────────────────────────────────────────────────────
# The test targets (per-gate objects, per-gate binaries, the `test` gate) live
# in test.mk, included at the bottom of this file.

# The tier-selection gate on its own (the `test` recipe runs it too): interp == JIT through
# the public wasm.h, driven by the wasm_config_t embedder option.
.PHONY: test-capi-jit
test-capi-jit: $(OBJS) $(TOML_OBJS) | $(B)
	$(CC) $(CFLAGS) -Wno-unused-function -Iinclude -I$(PEGRT) test/test_capi_jit.c src/wasm_capi.c \
	    src/wat_driver.c $(GEN)/wat_parser.c $(B)/jav_reader.o $(B)/jav_writer.o $(TOML_OBJS) \
	    $(CLITE_SRCS) src/jav_load.c $(ENGINE_OBJS) -lm -o $(B)/test_capi_jit
	@cd test && ../$(B)/test_capi_jit

# water: the .wat <-> .wasm converter. The link set is ENUMERATED because what
# is ABSENT from it is the contract: no validate.o, no jav_module_index.o, no
# jav_ttree.o — water transcribes §7 itself (wat_check.o) and shares only
# generated output and the §3.3 lattice (jav_subtype.o) with the engine.
# -D_POSIX_C_SOURCE for isatty/fileno under -std=c11.
water: $(B)/water
$(B)/water: src/water.c src/wat_driver.c src/wat_driver.h $(GEN)/wat_parser.c \
            $(B)/wat_check.o $(B)/wat_tree.o $(B)/wat_emit.o $(B)/wat_layout.o \
            $(B)/jnm_reader.o $(B)/jav_subtype.o $(B)/jav_error.o \
            $(B)/jav_reader.o $(B)/jav_writer.o $(B)/jav_utf8.o $(TOML_OBJS) \
            $(B)/bbq_arena.o $(B)/bbq_hmap.o $(B)/bbq_htree.o | $(B)
	$(CC) $(CFLAGS) -D_POSIX_C_SOURCE=200809L -Wno-unused-function -Iinclude -I$(PEGRT) \
	  src/water.c src/wat_driver.c $(GEN)/wat_parser.c \
	  $(B)/wat_check.o $(B)/wat_tree.o $(B)/wat_emit.o $(B)/wat_layout.o \
	  $(B)/jnm_reader.o $(B)/jav_subtype.o $(B)/jav_error.o \
	  $(B)/jav_reader.o $(B)/jav_writer.o $(B)/jav_utf8.o $(TOML_OBJS) \
	  $(B)/bbq_arena.o $(B)/bbq_hmap.o $(B)/bbq_htree.o -lm -o $(B)/water

clean:
	rm -rf $(B)

# The auto-generated per-object header dependencies (-MMD). Pulled in at the VERY BOTTOM,
# AFTER `all` and every real target — otherwise the first .d file's first target hijacks
# make's default goal (it was doing exactly that: bare `make` built only gen_interp.o).
# Make unions these with the explicit rules above, so an edit to any included header
# (including upstream BBQ headers outside this tree) rebuilds the objects that use it.
-include $(wildcard $(B)/*.d)

# Last: the test build reads every object/source variable defined above.
include test.mk
