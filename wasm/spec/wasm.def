# wasm.def — WebAssembly opcode specification (opgen DSL).
#
# Reference: WebAssembly Core Specification, Release 3.0, §5.4 "Instructions".
# One declarative source: opgen lowers each `(. body .)` to the in-place
# interpreter handler, the jitterator stencil, and the validator transfer
# function. Mnemonics use `_` (the real opcode is the hex byte; the mnemonic
# only names the generated C handler — `i32.add` → gen_op_i32_add).

# ── VM substrate ───────────────────────────────────────────────
# The backend supplies frame_t/vm_t/heap_t; opgen #includes this into the
# generated runtime_api.h at the value-model's substrate point.
backend "jav_frame.h"

# ── Control-flow status (WebAssembly has no exceptions in the core machine) ──
# OK continues to the next instruction; TRAP bails THROUGH the machine as a
# continuation (never abort); RETURN ends the function with the stack results.
status jav_status_t JAV_OK JAV_TRAP JAV_RETURN [JAV_MALFORMED, JAV_INVALID, JAV_UNLINKABLE, JAV_UNINSTANTIABLE]

# ── Structured control (§3.2 blocks, §4.4.8 branches) ──────────
# WebAssembly branches to a LABEL, not to a byte offset, so this op set needs
# the Titzer side table: one entry per branch, saying how many operands the
# label keeps and how many to drop beneath them. This directive hands that
# format to opgen, which owns both halves — `opgen_st_entry_t` (the entry the
# validator fills) and `opgen_do_transfer` (the walk the branch handlers run) —
# so the two can never disagree. The substrate supplies only WHERE the three
# cursors live, via the OPGEN_ST_TABLE/OPGEN_ST_PTR/OPGEN_IP defaults that
# jav_frame.h's frame_t already matches.
sidetable

# ── Value model (§5.3) ─────────────────────────────────────────
# A UNIFORM 16-byte slot: every value type is exactly ONE slot (unlike the JVM's
# 1-slot/2-slot split). v128 sets the slot width, so adding SIMD / reference
# types later is a table row, never an ABI resize (the full-spec seam, day one).
#   type <vt> <scalar> <uscalar> <slots> <field>
type i32       s4     u4     1 i
type i64       s8     u8     1 l
type f32       f4     f4     1 f
type f64       f8     f8     1 d
type v128      v128_t v128_t 1 v
type funcref   ref_t  ref_t  1 r
type externref ref_t  ref_t  1 r
type i31ref    ref_t  ref_t  1 r

# ── Runtime seam (native) ──────────────────────────────────────
# Control-transfer primitives a backend supplies. end/return hand the stack
# results back through the machine; call enters a callee frame. The heap/GC
# seam (alloc, table ops, ref maps) joins here as the opcode set grows.
inline native any    jav_funcaddr(int func);   # §4.6.2 ref.func: the module func's funcaddr as a funcref
inline native int    jav_func_nparams(int func);    # §3(b) the callee's arity — lets `call` DECLARE its
inline native int    jav_func_nresults(int func);   #       stack effect instead of lying with ( -- )
inline native int    jav_ref_nresults(any r);       # same, off a funcref (call_indirect / call_ref)
native int           jav_type_nparams(int type);    # same, off a TYPE immediate (call_indirect / call_ref);
                                                    #       not inline — jav_functype_t is validate.h's
native int    jav_funcref_typematch(any r, int typ);   # §4.6.2 ref.cast (ref null typ): the funcref matches typ
# MUST stay `status`. Not for the trap (that bails via vm->trapped + the parked cursor)
# but because a callee's THROW can be caught by a handler in THIS frame: do_throw
# redirects frame.code.pos, and only the terminal form re-dispatches through the cursor
# (interp: jav_next; stencil: _HOLE_resync). A baked _HOLE_cont ignores the cursor and
# runs the next instruction instead of the handler — verified: cross-frame catch gives
# interp=33 / jit=-1. `status` means "control may have moved", not merely "may fail".
native status jav_invoke_ref(any r);   # §4.6.2 Invoke: enter the (non-null) funcref's frame (jav_call_fn)
native status jav_tail_invoke_ref(any r);   # §4.6.2 tail Invoke: set up a tail call to the (non-null) funcref
native long   jav_table_grow(int tbl, long delta, any initref);   # the table grow allocator boundary
native void   jav_table_init(int tbl, int seg, long d, int s, int n);
native void   jav_elem_drop(int seg);
inline native int    jav_is_null(any r);   # §4.4.8 the ref is the null sentinel (any hierarchy), for br_on_null/non_null
native ref       jav_struct_alloc(int typ);              # alloc a struct (fields uninit) → managed gcref; traps bad type
native int    jav_struct_nfields(int typ);            # the struct type's field count
native int    jav_ref_test(any r, int ht, int nullable);   # §3.3 dynamic match on the popped ref → 0/1 (ref.test/_null)
native int    jav_top_ref_matches(int ht, int nullable);   # §3.3 peek-test the top ref vs ht (br_on_cast/cast_fail)
native any    jav_struct_new_default(int typ);          # alloc struct, fields defaulted → managed gcref
native any    jav_array_new_default(int typ, int len);   # alloc array[len], elements defaulted → managed gcref
native ref       jav_array_alloc(int typ, int n);       # alloc array[n] (elements uninit) → managed gcref
native any    jav_array_new_data(int typ, int seg, int off, int n);
native any    jav_array_new_elem(int typ, int seg, int off, int n);
native void   jav_array_init_data(int typ, int seg, ref arr, int d, int s, int n);
native void   jav_array_init_elem(int typ, int seg, ref arr, int d, int s, int n);
inline native long   jav_ref_func(int func);   # ref.func → the funcinst REFERENCE (a funcinst* as a 64-bit handle)

# Domain natives the generator used to special-case by NAME — now ordinary `inline native`
# declarations, lowered through the generic native path to a direct `name(NATIVE_ARGS, …)` call that
# folds the backend access macro (jav_frame.h). table_get/table_set replace the old `tables[t][i]`
# index syntax; transfer/func_return are `inline native status` (the control path bakes _HOLE_ip + resync).
inline native long   table_len(int t);                        # §7.1.9 table size (bounds source)
inline native int    table_is64(int t);                       # table64 addrtype flag (addr-result width)
inline native any    table_get(int t, int i);                 # §7.1.9 table element read {entry, tag}
inline native void   table_set(int t, int i, any v);          # §7.1.9 table element write
inline native int    ref_isnull(any r);                       # managed-ref null test (sentinel or 0)
inline native int    array_length(any a);                     # §4.6 GC array element count
inline native any    array_load(int type, any o, int idx);    # §4.6 GC array element read
inline native void   array_store(int type, any o, int idx, any v);   # §4.6 GC array element write
inline native any    struct_load(int type, int field, any o); # §4.6 GC struct field read
inline native void   struct_store(int type, int field, any o, any v);  # §4.6 GC struct field write
inline native void   exn_store(int i, any o, any v);           # §4.2.12 exception field write (value + tag)
inline native int    struct_load_packed(int type, int field, any o, int sgn);  # §4.6 packed field read (sign/zero-ext)
inline native int    array_load_packed(int type, any o, int idx, int sgn);     # §4.6 packed element read
inline native void   push_addr(long val, int is64);           # addr-width result push (i32/i64 per addrtype)
inline native status transfer();                              # §4.4.8 side-table branch walk → resync
inline native status func_return();                           # §4.4.7 run off the function end → halt
inline native int    mem_load_i8(int memidx, long ea);
inline native int    mem_load_i16(int memidx, long ea);
inline native int    mem_in_bounds(int memidx, long ea, long n);  # §4.6.8 the declared bounds precondition
inline native long   data_seg_len(int seg);      # §4.6.7 passive data-segment length (dropped = 0)
inline native long   elem_seg_len(int seg);      # §4.6.7 passive elem-segment length (dropped = 0)
inline native long   array_elem_width(int typ);  # §4.6.7 data-segment stride for an array type
inline native int    mem_load_i32(int memidx, long ea);
inline native long   mem_load_i64(int memidx, long ea);
inline native float  mem_load_f32(int memidx, long ea);
inline native double mem_load_f64(int memidx, long ea);
inline native void   mem_store_i8(int memidx, long ea, int v);
inline native void   mem_store_i16(int memidx, long ea, int v);
inline native void   mem_store_i32(int memidx, long ea, int v);
inline native void   mem_store_i64(int memidx, long ea, long v);
inline native void   mem_store_f32(int memidx, long ea, float v);
inline native void   mem_store_f64(int memidx, long ea, double v);
# Sub-word integer load/store primitives — each IS the §4.6.8 operation: load reads K/8 bytes
# as iK (bytesᵢₖ) then extendˢˣ to the result width; store writes wrap_{|iN|,K}(c). The s/u in
# the name is the signedness of the extend; the return/param width is the extend/wrap target.
inline native int    mem_load_i32_8u(int memidx, long ea);    # extendᵘ_{8,32}
inline native int    mem_load_i32_16u(int memidx, long ea);   # extendᵘ_{16,32}
inline native long   mem_load_i64_8s(int memidx, long ea);    # extendˢ_{8,64}
inline native long   mem_load_i64_8u(int memidx, long ea);    # extendᵘ_{8,64}
inline native long   mem_load_i64_16s(int memidx, long ea);   # extendˢ_{16,64}
inline native long   mem_load_i64_16u(int memidx, long ea);   # extendᵘ_{16,64}
inline native long   mem_load_i64_32s(int memidx, long ea);   # extendˢ_{32,64}
inline native long   mem_load_i64_32u(int memidx, long ea);   # extendᵘ_{32,64}
inline native void   mem_store_i64_8(int memidx, long ea, long v);    # wrap_{64,8}
inline native void   mem_store_i64_16(int memidx, long ea, long v);   # wrap_{64,16}
inline native void   mem_store_i64_32(int memidx, long ea, long v);   # wrap_{64,32}
inline native v128   mem_load_v128(int memidx, long ea);
inline native void   mem_store_v128(int memidx, long ea, v128 v);
# SIMD widening loads (§4.6.8 v128.loadKxM_sx): read 8 bytes, extendˢˣ each K-bit lane to 2K.
inline native v128   mem_load8x8_s(int memidx, long ea);
inline native v128   mem_load8x8_u(int memidx, long ea);
inline native v128   mem_load16x4_s(int memidx, long ea);
inline native v128   mem_load16x4_u(int memidx, long ea);
inline native v128   mem_load32x2_s(int memidx, long ea);
inline native v128   mem_load32x2_u(int memidx, long ea);
inline native v128   mem_load32_zero(int memidx, long ea);   # extendᵘ_{32,128}
inline native v128   mem_load64_zero(int memidx, long ea);   # extendᵘ_{64,128}
native v128   jav_v128_demote_f64x2(v128 a);
inline native long   mem_pages(int memidx);   # memory.size: page count (addr-result push)
inline native int    mem_is64(int memidx);     # the memory's addrtype-width flag (i64 result if set)
native long   mem_grow(int memidx, long delta);   # the realloc storage-layer boundary
native void   jav_memory_fill(int memidx, long d, int v, long n);
native void   jav_memory_copy(int dst_mem, int src_mem, long d, long s, long n);
native void   jav_memory_init(int memidx, int seg, long d, int s, int n);
native void   jav_data_drop(int seg);
native ref    jav_exn_alloc_for_throw(int tag);   # alloc the exn for tag (fields uninit) → exnref; traps bad tag
native int    jav_tag_nparams(int tag);           # the tag's field/param count
native status jav_throw_exn(ref exn);             # §4.4.10 unwind: ride the side-table to a catch handler, or trap
native status jav_throw_ref(any r);              # §4.4.10 rethrow an exnref the body already popped
native status jav_try_table();
# u64 -> f64: x86-64 has no unsigned-64 -> fp instruction, so clang synthesizes
# it as a whole algorithm with a .rodata bias constant — not a literal opgen can
# own, so this is the genuine case for a native (clang + the real linker lay the
# constant out correctly; the stencil just calls through the fn-pointer hole).
native double convert_u64_f64(long a);
# float -> u64 (i64.trunc_f*_u): same story in reverse — no float->unsigned-64
# instruction, so clang synthesizes it with a .rodata constant. Native: the range
# check + conversion + trap all live in normally-compiled code.
native long trunc_u64_f32(float a);
native long trunc_u64_f64(double a);

# ── Variable instructions (§5.4.3) ─────────────────────────────
# local.get pushes a local. For the skeleton locals are i32; the validator
# knows each local's static type, so the polymorphic form arrives with the
# numeric scale-up (Phase 2), not here.
# Locals are slot copies. local.get/set/tee are ONE opcode each (polymorphic in
# WASM — the type is the local's, known to the validator), so they move a whole
# 64-bit slot, preserving any scalar type's value (i32/i64/f32/f64); v128 (the
# full 16-byte slot) arrives with SIMD.
local_get 0x20 [uleb32 index] ( -- word result)
(.  result = locals[index];  .)

local_set 0x21 [uleb32 index] (word v -- )
(.  locals[index] = v;  .)

local_tee 0x22 [uleb32 index] (word v -- word result = "v")
(.  locals[index] = v;  .)

# Globals — module-level slots (on the instance/vm), reached via the runtime
# (64-bit slot, like locals). global.get pushes globals[index]; global.set pops.
global_get 0x23 [uleb32 index] ( -- word result)
(.  result = globals[index];  .)

global_set 0x24 [uleb32 index] (word v -- )
(.  globals[index] = v;  .)

# Linear memory (§5.4.5). Loads/stores take an align hint (ignored) + a static offset; the
# effective address is addr + offset. The §4.6.8 bounds check is a DECLARED precondition on
# every access — `mem_in_bounds(memidx, ea, N)` where N is the STORAGE width — so the contract
# is visible to a verifier rather than buried in the accessor. N must equal the spec `align`
# column's natural width; gen_trap_reasons asserts that on every build.
i32_load 0x28 [memarg offset] (addr(mem_is64(memidx)) addr -- i32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i32(memidx, addr + offset);  .)
i64_load 0x29 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64(memidx, addr + offset);  .)
f32_load 0x2a [memarg offset] (addr(mem_is64(memidx)) addr -- f32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_f32(memidx, addr + offset);  .)
f64_load 0x2b [memarg offset] (addr(mem_is64(memidx)) addr -- f64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_f64(memidx, addr + offset);  .)
# Sub-word integer loads (§4.6.8): each calls the native that IS its load-and-extendˢˣ.
# load8_s/load16_s reuse mem_load_i8/i16 (already extendˢ_{K,32}). Storage width K (not the
# result width) drives the §3.4.5 alignment bound, set in the validator's tc_mem.
i32_load8_s 0x2c [memarg offset] (addr(mem_is64(memidx)) addr -- i32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i8(memidx, addr + offset);  .)
i32_load8_u 0x2d [memarg offset] (addr(mem_is64(memidx)) addr -- i32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i32_8u(memidx, addr + offset);  .)
i32_load16_s 0x2e [memarg offset] (addr(mem_is64(memidx)) addr -- i32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i16(memidx, addr + offset);  .)
i32_load16_u 0x2f [memarg offset] (addr(mem_is64(memidx)) addr -- i32 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i32_16u(memidx, addr + offset);  .)
i64_load8_s 0x30 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_8s(memidx, addr + offset);  .)
i64_load8_u 0x31 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_8u(memidx, addr + offset);  .)
i64_load16_s 0x32 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_16s(memidx, addr + offset);  .)
i64_load16_u 0x33 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_16u(memidx, addr + offset);  .)
i64_load32_s 0x34 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_32s(memidx, addr + offset);  .)
i64_load32_u 0x35 [memarg offset] (addr(mem_is64(memidx)) addr -- i64 result)
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64_32u(memidx, addr + offset);  .)
i32_store 0x36 [memarg offset] (addr(mem_is64(memidx)) addr, i32 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i32(memidx, addr + offset, val);  .)
i64_store 0x37 [memarg offset] (addr(mem_is64(memidx)) addr, i64 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i64(memidx, addr + offset, val);  .)
f32_store 0x38 [memarg offset] (addr(mem_is64(memidx)) addr, f32 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  mem_store_f32(memidx, addr + offset, val);  .)
f64_store 0x39 [memarg offset] (addr(mem_is64(memidx)) addr, f64 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  mem_store_f64(memidx, addr + offset, val);  .)
# Sub-word integer stores (§4.6.8): each calls the native that IS its wrap_{|iN|,K}+store.
# i32.store8/16 reuse mem_store_i8/i16 (low K bytes of the i32); the i64 stores call the
# i64-width natives so wrap_{64,K} is done on the full operand, not a pre-truncated one.
i32_store8 0x3a [memarg offset] (addr(mem_is64(memidx)) addr, i32 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i8(memidx, addr + offset, val);  .)
i32_store16 0x3b [memarg offset] (addr(mem_is64(memidx)) addr, i32 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i16(memidx, addr + offset, val);  .)
i64_store8 0x3c [memarg offset] (addr(mem_is64(memidx)) addr, i64 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i64_8(memidx, addr + offset, val);  .)
i64_store16 0x3d [memarg offset] (addr(mem_is64(memidx)) addr, i64 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i64_16(memidx, addr + offset, val);  .)
i64_store32 0x3e [memarg offset] (addr(mem_is64(memidx)) addr, i64 val -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i64_32(memidx, addr + offset, val);  .)
# Result is i64 so a memory64's size/grow carries the full addrtype width (sign-extended: grow's −1
# failure → i64 −1); a memory32 consumer reads the low 32 bits, which the validator types as i32.
# Stack-driven so the result (size) / operand (delta) carry the memory's addrtype width: i64 for a
# memory64, i32 for a memory32 — the native reads is64 and pushes/pops the matching tag.
# §7.10 types these as `[] -> [at]` / `[at] -> [at]`: the result's WIDTH is the
# memory's addrtype, decided per instance. A `word` result carries its runtime tag,
# so the body sets it — the same §3(c) mechanism `select` uses. The declared arity is
# then honest and opgen owns the push.
memory_size 0x3f [uleb32 memidx] ( -- word result )
(.  result = mem_pages(memidx);  result_wt = mem_is64(memidx) ? T_LONG : T_INT;  .)
memory_grow 0x40 [uleb32 memidx] ( addr(mem_is64(memidx)) delta -- word result )    # §3.4.5 memory.grow x : at -> at
(.  result = mem_grow(memidx, delta);  result_wt = mem_is64(memidx) ? T_LONG : T_INT;  .)

# Bulk memory (§5.4.5, 0xFC prefix). fill sets a region to a byte; copy moves a
# region (overlap-safe); init copies from a passive data segment; data.drop frees a
# passive segment. All addresses are i32 (memory32); the natives bounds-check + trap.
# §3.4.5 addrtype-width operands: fill d/n; copy d/s/n (n = min addrtype, tag-driven); init d (s/n are i32 segment indices).
memory_fill 0xfc 11 [uleb32 memidx] (addr(mem_is64(memidx)) d, i32 v, addr(mem_is64(memidx)) n -- )    # §3.4.5 memory.fill x : at i32 at -> eps
    error: (. !mem_in_bounds(memidx, d, n) .) -> OutOfBoundsMemoryAccess
(.  jav_memory_fill(memidx, d, v, n);  .)
# §3.4.5 memory.copy x1 x2 : at1 at2 min(at1,at2) -> eps. The LENGTH is typed min(at1,at2) — the
# SMALLER width — so it is i64 only when BOTH memories are; either being i32 makes it i32.
memory_copy 0xfc 10 [uleb32 dst_mem, uleb32 src_mem] (addr(mem_is64(dst_mem)) d, addr(mem_is64(src_mem)) s, addr(mem_is64(dst_mem) && mem_is64(src_mem)) n -- )
    error: (. !(mem_in_bounds(dst_mem, d, n) && mem_in_bounds(src_mem, s, n)) .) -> OutOfBoundsMemoryAccess
(.  jav_memory_copy(dst_mem, src_mem, d, s, n);  .)
# §4.6.7 memory.init bounds BOTH ends: the destination in linear memory and the source in the
# passive data segment (s,n are i32 segment indices; d is addrtype). A dropped segment is ε.
memory_init 0xfc 8 [uleb32 seg, uleb32 memidx] (addr(mem_is64(memidx)) d, i32 s, i32 n -- )    # §3.4.5 memory.init x y : at i32 i32 -> eps
    error: (. !(n >= 0 && s >= 0 && (long)s + (long)n <= data_seg_len(seg) && mem_in_bounds(memidx, d, n)) .) -> OutOfBoundsMemoryAccess
(.  jav_memory_init(memidx, seg, d, s, n);  .)
data_drop 0xfc 9 [uleb32 seg] ( -- )
(.  jav_data_drop(seg);  .)

# Bulk table (§5.4.6, 0xFC prefix). size reports |refs|; grow appends `delta` copies
# of an init ref (push old size, or -1 on failure); fill sets a region to a ref; copy
# moves a region (overlap-safe); init copies from an element segment; elem.drop frees
# a passive segment. Indices are i32 (table32); the natives bounds-check + trap. A
# funcref rides as an int (funcidx, or -1 = null), matching table.get/set.
table_size 0xfc 16 [uleb32 table] ( -- word result )    # §4.6 inline (no extern): |refs| in the table addrtype width
(.  result = table_len(table);  result_wt = table_is64(table) ? T_LONG : T_INT;  .)
table_grow 0xfc 15 [uleb32 table] ( any initref, addr(table_is64(table)) delta -- word result )    # §3.4.4 table.grow x : rt at -> at
(.  result = jav_table_grow(table, delta, initref);  result_wt = table_is64(table) ? T_LONG : T_INT;  .)
table_fill 0xfc 17 [uleb32 table] ( addr(table_is64(table)) i, any v, addr(table_is64(table)) n -- )    # §3.4.4 table.fill x : at rt at -> eps; OOB → trap
    error: (. !(i <= table_len(table) && n <= table_len(table) - i) .) -> OutOfBoundsTableAccess
(.  for (long k = 0; k < (long)n; k = k + 1) table_set(table, i + k, v);  .)
# §3.4.4 table.copy x1 x2 : at1 at2 min(at1,at2) -> eps — the length takes the SMALLER width.
table_copy 0xfc 14 [uleb32 dst_table, uleb32 src_table] ( addr(table_is64(dst_table)) d, addr(table_is64(src_table)) s, addr(table_is64(dst_table) && table_is64(src_table)) n -- )    # overlap-safe; OOB → trap
    error: (. !(d <= table_len(dst_table) && n <= table_len(dst_table) - d && s <= table_len(src_table) && n <= table_len(src_table) - s) .) -> OutOfBoundsTableAccess
    # §4.6.7: d<=s copies ascending, else descending (overlap-safe), index d+k / s+k either way.
(.  if (d <= s) { for (long k = 0; k < (long)n; k = k + 1) table_set(dst_table, d + k, table_get(src_table, s + k)); }
    else { for (long k = (long)n - 1; k >= 0; k = k - 1) table_set(dst_table, d + k, table_get(src_table, s + k)); }  .)
# §4.6.7 table.init bounds BOTH ends, like memory.init: destination in the table, source in the
# passive elem segment. The reason is a TABLE access, not a memory one.
table_init 0xfc 12 [uleb32 seg, uleb32 table] ( addr(table_is64(table)) d, i32 s, i32 n -- )    # §3.4.4 table.init x y : at i32 i32 -> eps
    error: (. !(n >= 0 && s >= 0 && (long)s + (long)n <= elem_seg_len(seg) && d <= table_len(table) && n <= table_len(table) - d) .) -> OutOfBoundsTableAccess
(.  jav_table_init(table, seg, d, s, n);  .)
elem_drop 0xfc 13 [uleb32 seg] ( -- )
(.  jav_elem_drop(seg);  .)

# Exceptions (§5.4.1). throw raises tag $x with the tag's field values popped off the
# stack; throw_ref re-raises an exnref; try_table installs catch handlers for its body
# (the native reads its own blocktype + catch vector, like br_table reads its label
# vector). A caught exception transfers via the side-table (the validator emitted one
# entry per catch); an uncaught one unwinds out through jav_call. throw/throw_ref are
# status control ops (resync, like br_on_null); try_table reads a variable catch vector
# the JIT walk skips (like br_table) — both tiers, no carve-out.
# §3(b) dynamic arity: the pop count is the tag's field count, so the signature says
# so — opgen owns the marshaling (a zero-copy view of the operands, then the SP drop)
# and the native stops reaching into f->stack. Same shape as struct.new.
throw 0x08 [uleb32 tag] ( [jav_tag_nparams(tag)] any fields -- )
(.  ulong exn = jav_exn_alloc_for_throw(tag);
    for (int i = jav_tag_nparams(tag) - 1; i >= 0; i = i - 1) exn_store(i, exn, fields[i]);
    jav_throw_exn(exn);  .)
# §4.4.10 throw_ref: the exnref is a declared operand, not something the native reaches down
# for — the spec type `[t*1 exnref] -> [t*2]` is polymorphic on both sides, but the exnref pop
# itself is static, so it is declarable. Safe to pop into a local ahead of the body: do_throw
# never allocates, and it resets sp to the try base anyway.
throw_ref 0x0a ( any r -- )
    error: (. jav_is_null(r) .) -> NullExceptionReference
(.  jav_throw_ref(r);  .)
try_table 0x1f [trytable catches] ( -- )
(.  jav_try_table();  .)

# ── Numeric instructions (§5.4.6) ──────────────────────────────
i32_const 0x41 [sleb32 value] ( -- i32 result)
(.  result = value;  .)

i64_const 0x42 [sleb64 value] ( -- i64 result)
(.  result = value;  .)

# Binary arithmetic — one family body per operator, expanded across the four
# scalar types. The value model + jtype-driven lowering specialize each member
# (i32→s4, i64→s8, f32→f4, f64→f8) for BOTH the interpreter handler and the JIT
# stencil: N types × 2 backends from one body.
# Integer add/sub/mul are computed in the member-relative UNSIGNED type: WASM defines
# them as modular (wraparound), whereas signed overflow (e.g. INT_MIN * -1) is C UB. The
# unsigned result converts back to the signed member with the same two's-complement bits
# (same pattern as div_u/rem_u). Floats have no overflow UB and stay signed.
family ( T a, T b -- T result )
(.  result = (unsigned)a + (unsigned)b;  .)
{ i32 i32_add 0x6a   i64 i64_add 0x7c }
family ( T a, T b -- T result )
(.  result = a + b;  .)
{ f32 f32_add 0x92   f64 f64_add 0xa0 }

family ( T a, T b -- T result )
(.  result = (unsigned)a - (unsigned)b;  .)
{ i32 i32_sub 0x6b   i64 i64_sub 0x7d }
family ( T a, T b -- T result )
(.  result = a - b;  .)
{ f32 f32_sub 0x93   f64 f64_sub 0xa1 }

family ( T a, T b -- T result )
(.  result = (unsigned)a * (unsigned)b;  .)
{ i32 i32_mul 0x6c   i64 i64_mul 0x7e }
family ( T a, T b -- T result )
(.  result = a * b;  .)
{ f32 f32_mul 0x94   f64 f64_mul 0xa2 }

# Bitwise (integers).
family ( T a, T b -- T result )
(.  result = a & b;  .)
{ i32 i32_and 0x71   i64 i64_and 0x83 }

family ( T a, T b -- T result )
(.  result = a | b;  .)
{ i32 i32_or 0x72   i64 i64_or 0x84 }

family ( T a, T b -- T result )
(.  result = a ^ b;  .)
{ i32 i32_xor 0x73   i64 i64_xor 0x85 }

# Comparisons → i32 (member-typed inputs, fixed i32 result). eq/ne are
# sign-agnostic; `<`/`>`/`<=`/`>=` are signed for integers (the *_s forms) and
# ordered for floats — one body covers both, since C's operators on s4/s8 are
# signed and on f4/f8 are ordered (NaN ⇒ false), exactly WASM's semantics.
family ( T a, T b -- i32 result )
(.  result = (a == b) ? 1 : 0;  .)
{ i32 i32_eq 0x46   i64 i64_eq 0x51   f32 f32_eq 0x5b   f64 f64_eq 0x61 }

family ( T a, T b -- i32 result )
(.  result = (a != b) ? 1 : 0;  .)
{ i32 i32_ne 0x47   i64 i64_ne 0x52   f32 f32_ne 0x5c   f64 f64_ne 0x62 }

family ( T a, T b -- i32 result )
(.  result = (a < b) ? 1 : 0;  .)
{ i32 i32_lt_s 0x48   i64 i64_lt_s 0x53   f32 f32_lt 0x5d   f64 f64_lt 0x63 }

family ( T a, T b -- i32 result )
(.  result = (a > b) ? 1 : 0;  .)
{ i32 i32_gt_s 0x4a   i64 i64_gt_s 0x55   f32 f32_gt 0x5e   f64 f64_gt 0x64 }

family ( T a, T b -- i32 result )
(.  result = (a <= b) ? 1 : 0;  .)
{ i32 i32_le_s 0x4c   i64 i64_le_s 0x57   f32 f32_le 0x5f   f64 f64_le 0x65 }

family ( T a, T b -- i32 result )
(.  result = (a >= b) ? 1 : 0;  .)
{ i32 i32_ge_s 0x4e   i64 i64_ge_s 0x59   f32 f32_ge 0x60   f64 f64_ge 0x66 }

# eqz — unary integer test (T input, i32 result).
family ( T a -- i32 result )
(.  result = (a == 0) ? 1 : 0;  .)
{ i32 i32_eqz 0x45   i64 i64_eqz 0x50 }

# Integer division / remainder. Each trap guard is DECLARED here and emitted
# verbatim ahead of the body, into both the interpreter and the JIT stencil:
# divisor != 0 (all four), and INT_MIN / -1 (div_s only). int_min() is nullary
# and takes its width from the surrounding expression, so one declared guard
# covers both members of a family. div_u/rem_u use the member-relative
# (unsigned) cast so one body covers i32 and i64.
family ( T a, T b -- T result )
    error: (. b == 0 .) -> IntegerDivideByZero
    error: (. b == -1 && a == int_min() .) -> IntegerOverflow
(.  result = a / b;  .)
{ i32 i32_div_s 0x6d   i64 i64_div_s 0x7f }

family ( T a, T b -- T result )
    error: (. b == 0 .) -> IntegerDivideByZero
(.  result = (unsigned)a / (unsigned)b;  .)
{ i32 i32_div_u 0x6e   i64 i64_div_u 0x80 }

family ( T a, T b -- T result )
    error: (. b == 0 .) -> IntegerDivideByZero
(.  result = (b == -1) ? 0 : a % b;  .)   # §4.3.x rem_s does NOT trap on MIN%-1 (= 0); the bare a%b would SIGFPE
{ i32 i32_rem_s 0x6f   i64 i64_rem_s 0x81 }

family ( T a, T b -- T result )
    error: (. b == 0 .) -> IntegerDivideByZero
(.  result = (unsigned)a % (unsigned)b;  .)
{ i32 i32_rem_u 0x70   i64 i64_rem_u 0x82 }

# Float division (no trap — x/0 is ±inf).
family ( T a, T b -- T result )
(.  result = a / b;  .)
{ f32 f32_div 0x95   f64 f64_div 0xa3 }

# Unsigned integer comparisons → i32 (member-relative unsigned on each operand).
family ( T a, T b -- i32 result )
(.  result = ((unsigned)a < (unsigned)b) ? 1 : 0;  .)
{ i32 i32_lt_u 0x49   i64 i64_lt_u 0x54 }

family ( T a, T b -- i32 result )
(.  result = ((unsigned)a > (unsigned)b) ? 1 : 0;  .)
{ i32 i32_gt_u 0x4b   i64 i64_gt_u 0x56 }

family ( T a, T b -- i32 result )
(.  result = ((unsigned)a <= (unsigned)b) ? 1 : 0;  .)
{ i32 i32_le_u 0x4d   i64 i64_le_u 0x58 }

family ( T a, T b -- i32 result )
(.  result = ((unsigned)a >= (unsigned)b) ? 1 : 0;  .)
{ i32 i32_ge_u 0x4f   i64 i64_ge_u 0x5a }

# Shifts & rotates. The shift amount masks to the value's bit width (i32 → 5
# bits, i64 → 6); shr_u is the member-relative unsigned right shift (>>>);
# rotates use the rotl/rotr intrinsics.
family ( T a, T b -- T result )
(.  result = a << b;  .)
{ i32 i32_shl 0x74   i64 i64_shl 0x86 }

family ( T a, T b -- T result )
(.  result = a >> b;  .)
{ i32 i32_shr_s 0x75   i64 i64_shr_s 0x87 }

family ( T a, T b -- T result )
(.  result = a >>> b;  .)
{ i32 i32_shr_u 0x76   i64 i64_shr_u 0x88 }

family ( T a, T b -- T result )
(.  result = rotl(a, b);  .)
{ i32 i32_rotl 0x77   i64 i64_rotl 0x89 }

family ( T a, T b -- T result )
(.  result = rotr(a, b);  .)
{ i32 i32_rotr 0x78   i64 i64_rotr 0x8a }

# Integer unary bit counts (clz/ctz return the bit width for input 0).
family ( T a -- T result )
(.  result = clz(a);  .)
{ i32 i32_clz 0x67   i64 i64_clz 0x79 }

family ( T a -- T result )
(.  result = ctz(a);  .)
{ i32 i32_ctz 0x68   i64 i64_ctz 0x7a }

family ( T a -- T result )
(.  result = popcnt(a);  .)
{ i32 i32_popcnt 0x69   i64 i64_popcnt 0x7b }

# Float unary — neg is plain negation (flips the sign bit); the rest are libm
# intrinsics, specialized to the f-suffixed form for f32.
family ( T a -- T result )
(.  result = -a;  .)
{ f32 f32_neg 0x8c   f64 f64_neg 0x9a }

family ( T a -- T result )
(.  result = fabs(a);  .)
{ f32 f32_abs 0x8b   f64 f64_abs 0x99 }

family ( T a -- T result )
(.  result = ceil(a);  .)
{ f32 f32_ceil 0x8d   f64 f64_ceil 0x9b }

family ( T a -- T result )
(.  result = floor(a);  .)
{ f32 f32_floor 0x8e   f64 f64_floor 0x9c }

family ( T a -- T result )
(.  result = ftrunc(a);  .)
{ f32 f32_trunc 0x8f   f64 f64_trunc 0x9d }

family ( T a -- T result )
(.  result = nearest(a);  .)
{ f32 f32_nearest 0x90   f64 f64_nearest 0x9e }

family ( T a -- T result )
(.  result = sqrt(a);  .)
{ f32 f32_sqrt 0x91   f64 f64_sqrt 0x9f }

# Float binary — min/max honor WASM's NaN + signed-zero rules; copysign.
family ( T a, T b -- T result )
(.  result = fmin(a, b);  .)
{ f32 f32_min 0x96   f64 f64_min 0xa4 }

family ( T a, T b -- T result )
(.  result = fmax(a, b);  .)
{ f32 f32_max 0x97   f64 f64_max 0xa5 }

family ( T a, T b -- T result )
(.  result = copysign(a, b);  .)
{ f32 f32_copysign 0x98   f64 f64_copysign 0xa6 }

# Float constants — fixed-width little-endian immediate (not a varint).
f32_const 0x43 [f32 value] ( -- f32 result)
(.  result = value;  .)

f64_const 0x44 [f64 value] ( -- f64 result)
(.  result = value;  .)

# Conversions. Width changes are plain casts; reinterpret is a bit-cast. The
# 0xFC-prefixed saturating truncations (trunc_sat) arrive with multi-byte opcode
# dispatch; the single-byte trapping truncations (0xA8–0xB1) are below.
i32_wrap_i64 0xa7 (i64 a -- i32 result)
(.  result = (int)a;  .)

i64_extend_i32_s 0xac (i32 a -- i64 result)
(.  result = (long)a;  .)

i64_extend_i32_u 0xad (i32 a -- i64 result)
(.  result = (long)((unsigned)a);  .)

i32_extend8_s 0xc0 (i32 a -- i32 result)
(.  result = (byte)a;  .)

i32_extend16_s 0xc1 (i32 a -- i32 result)
(.  result = (short)a;  .)

i64_extend8_s 0xc2 (i64 a -- i64 result)
(.  result = (byte)a;  .)

i64_extend16_s 0xc3 (i64 a -- i64 result)
(.  result = (short)a;  .)

i64_extend32_s 0xc4 (i64 a -- i64 result)
(.  result = (int)a;  .)

# Trapping float→int truncations (§5.4.6). The range check + trap live in the
# body: the bounds are const-init locals (opgen auto-holes them — value from the
# §7.10 gives these TWO reasons and a single range test can report only one, so NaN
# is tested first (it satisfies neither half of the comparison) and the range test
# second. The bounds are float constants inside a guard: opgen names each one a
# `_HOLE_` keyed by its bit pattern, so the stencil reads a patched immediate rather
# than a .rodata constant. The two f→u64 forms stay native (x86 has no
# float→unsigned-64 op); they carry the same two reasons from jav_runtime.c.
i32_trunc_f32_s 0xa8 (f32 a -- i32 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a >= -2147483648.0 && a < 2147483648.0) .) -> IntegerOverflow
(.  result = (int)a;  .)
i32_trunc_f32_u 0xa9 (f32 a -- i32 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a > -1.0 && a < 4294967296.0) .) -> IntegerOverflow
(.  result = (uint)a;  .)
i32_trunc_f64_s 0xaa (f64 a -- i32 result)
    error: (. a != a .) -> InvalidConversionToInteger
    # f64 can represent -2147483648.x → trunc to INT_MIN (valid), hence the open lower bound
    error: (. !(a > -2147483649.0 && a < 2147483648.0) .) -> IntegerOverflow
(.  result = (int)a;  .)
i32_trunc_f64_u 0xab (f64 a -- i32 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a > -1.0 && a < 4294967296.0) .) -> IntegerOverflow
(.  result = (uint)a;  .)
i64_trunc_f32_s 0xae (f32 a -- i64 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a >= -9223372036854775808.0 && a < 9223372036854775808.0) .) -> IntegerOverflow
(.  result = (long)a;  .)
i64_trunc_f32_u 0xaf (f32 a -- i64 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a > -1.0 && a < 18446744073709551616.0) .) -> IntegerOverflow
(.  result = trunc_u64_f32(a);  .)
i64_trunc_f64_s 0xb0 (f64 a -- i64 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a >= -9223372036854775808.0 && a < 9223372036854775808.0) .) -> IntegerOverflow
(.  result = (long)a;  .)
i64_trunc_f64_u 0xb1 (f64 a -- i64 result)
    error: (. a != a .) -> InvalidConversionToInteger
    error: (. !(a > -1.0 && a < 18446744073709551616.0) .) -> IntegerOverflow
(.  result = trunc_u64_f64(a);  .)

# Saturating truncation (0xFC prefix): NaN -> 0, out-of-range clamps to the
# integer min/max instead of trapping. The min is ~INT32_MAX (an inline
# immediate, not a .rodata reloc); the float range bounds auto-hole as usual.
i32_trunc_sat_f32_s 0xfc 0 (f32 a -- i32 result)
(.  float lo = -2147483648.0;  float hi = 2147483648.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~2147483647; }
    else if (a >= hi) { result = 2147483647; }
    else { result = (int)a; }  .)
i32_trunc_sat_f64_s 0xfc 2 (f64 a -- i32 result)
(.  double lo = -2147483648.0;  double hi = 2147483648.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~2147483647; }
    else if (a >= hi) { result = 2147483647; }
    else { result = (int)a; }  .)
# Unsigned i32: clamp to [0, UINT32_MAX]. f->u32 is a native x86 conversion (no
# .rodata), so the cast lowers inline in both tiers; max is (uint)~0.
i32_trunc_sat_f32_u 0xfc 1 (f32 a -- i32 result)
(.  float lo = 0.0;  float hi = 4294967296.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (uint)~0; }
    else { result = (uint)a; }  .)
i32_trunc_sat_f64_u 0xfc 3 (f64 a -- i32 result)
(.  double lo = 0.0;  double hi = 4294967296.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (uint)~0; }
    else { result = (uint)a; }  .)
# Signed i64: clamp to [INT64_MIN, INT64_MAX]. The bounds are 64-bit integer
# literals (now expressible) baked as inline movabs immediates; min = ~INT64_MAX.
i64_trunc_sat_f32_s 0xfc 4 (f32 a -- i64 result)
(.  float lo = -9223372036854775808.0;  float hi = 9223372036854775808.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~9223372036854775807; }
    else if (a >= hi) { result = 9223372036854775807; }
    else { result = (long)a; }  .)
i64_trunc_sat_f64_s 0xfc 6 (f64 a -- i64 result)
(.  double lo = -9223372036854775808.0;  double hi = 9223372036854775808.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~9223372036854775807; }
    else if (a >= hi) { result = 9223372036854775807; }
    else { result = (long)a; }  .)
# Unsigned i64: clamp to [0, UINT64_MAX]. f->u64 has no x86 instruction (clang
# would synthesize a .rodata constant), so the in-range conversion goes through
# the trunc_u64 native — the body guards keep it inside the native's clean range.
i64_trunc_sat_f32_u 0xfc 5 (f32 a -- i64 result)
(.  float lo = 0.0;  float hi = 18446744073709551616.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (ulong)~0; }
    else { result = trunc_u64_f32(a); }  .)
i64_trunc_sat_f64_u 0xfc 7 (f64 a -- i64 result)
(.  double lo = 0.0;  double hi = 18446744073709551616.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (ulong)~0; }
    else { result = trunc_u64_f64(a); }  .)

f32_convert_i32_s 0xb2 (i32 a -- f32 result)
(.  result = (float)a;  .)

f32_convert_i32_u 0xb3 (i32 a -- f32 result)
(.  result = (float)((unsigned)a);  .)

f32_convert_i64_s 0xb4 (i64 a -- f32 result)
(.  result = (float)a;  .)

f32_convert_i64_u 0xb5 (i64 a -- f32 result)
(.  result = (float)((unsigned)a);  .)

f64_convert_i32_s 0xb7 (i32 a -- f64 result)
(.  result = (double)a;  .)

f64_convert_i32_u 0xb8 (i32 a -- f64 result)
(.  result = (double)((unsigned)a);  .)

f64_convert_i64_s 0xb9 (i64 a -- f64 result)
(.  result = (double)a;  .)

f64_convert_i64_u 0xba (i64 a -- f64 result)
(.  result = convert_u64_f64(a);  .)

f32_demote_f64 0xb6 (f64 a -- f32 result)
(.  result = (float)a;  .)

f64_promote_f32 0xbb (f32 a -- f64 result)
(.  result = (double)a;  .)

i32_reinterpret_f32 0xbc (f32 a -- i32 result)
(.  result = reinterpret(a);  .)

i64_reinterpret_f64 0xbd (f64 a -- i64 result)
(.  result = reinterpret(a);  .)

f32_reinterpret_i32 0xbe (i32 a -- f32 result)
(.  result = reinterpret(a);  .)

f64_reinterpret_i64 0xbf (i64 a -- f64 result)
(.  result = reinterpret(a);  .)

# ── Control instructions (§5.4.2) ──────────────────────────────
# end (0x0B) terminates the function body, leaving its results on the stack;
# return (0x0F) is the explicit early return. Structured block/loop/if and the
# side-table that resolves their targets land in Phase 2C.
# Structured control (§5.4.2). block/loop/end are no-ops at runtime — the
# side-table, built by the validator from the same control structure, encodes
# every branch's target + stack adjustment. if pops the condition and branches
# to else/end when false; else/br/br_if transfer via the side-table; return jumps
# to the function end. The blocktype operand (sleb32: 0x40 empty, valtype, or a
# typeidx) is consumed at runtime and read by the validator.
# unreachable (0x00) traps unconditionally; nop (0x01) has no effect (§4.4.1). The
# validator already marks the rest of the block dead after unreachable (stack-polymorphic);
# at runtime it simply bails to the trap continuation.
unreachable 0x00 ( -- )
    error: (. true .) -> UnreachableExecuted
(.  .)

nop 0x01 ( -- )

block 0x02 [blocktype bt] ( -- )

loop 0x03 [blocktype bt] ( -- )

if 0x04 [blocktype bt] (i32 cond -- )
(.  if (!cond) transfer(); else stp = stp + 1;  .)

else 0x05 ( -- )
(.  transfer();  .)

end 0x0b ( -- )

br 0x0c [uleb32 label] ( -- )
(.  transfer();  .)

br_if 0x0d [uleb32 label] (i32 cond -- )
(.  if (cond) transfer(); else stp = stp + 1;  .)

# br_table — the tableswitch of WASM (cf. JCVM *tableswitch). Pops the key; the
# validator emitted one side-table entry per case + default, so the native skips
# the (LEB-encoded) label vector, clamps the key to the default, and transfers
# via the key-th entry.
# The label targets live in the side-table (one entry per case, then the default), so
# the vector itself is pure decode — opgen reads its length as `labels_count` and skips
# the labels. §4.4.8: clamp an out-of-range key to the default, index this br_table's
# consecutive entries, transfer.
br_table 0x0e [brtable labels] (i32 key -- )
(.  stp = stp + (((uint)key > labels_count) ? labels_count : (uint)key);  transfer();  .)

return 0x0f ( -- )
(.  func_return();  .)

# §3(b) dynamic arity: the counts come from the CALLEE's type, so the signature states
# them instead of `( -- )` and opgen owns the marshaling. `pops_first` because the callee
# frame is carved at sp — the params must already be popped when the body hands off (safe
# here: jav_call_fn copies them into locals, which are GC roots, with no allocation in
# between). The results are left at the frame base by the callee, so exposing them is a
# single sp raise.
# The RESULT half stays in jav_call_fn and is not declarable: the op is terminal (a callee's
# throw can land in this frame's handler, and jav_invoke_ref returns `status` so its lowering
# tail-returns), which leaves opgen nowhere to emit post-call work — anything after the body is
# unreachable. The param half has no such obstacle, so it is declared here.
call 0x10 [uleb32 func] ( [jav_func_nparams(func)] any args -- )
    flag: pops_first
(.  jav_invoke_ref(jav_funcaddr(func));  .)

# drop discards the top operand (§3.4.1 `drop : t -> eps`, value-polymorphic — every
# slot is one cell, so the pop is type-agnostic; the validator accepts any type).
# `word` for the same reason select below uses it: the slot is whatever the operand
# was. Declared i32 it read as an i32-only signature, which is a claim about the
# operand no rule of §3.4.1 makes.
drop 0x1a ( word a -- )
(.  .)

# select (§4.6.1): pop the i32 condition c, then keep the first operand v1 if c is non-zero,
# else the second v2. Value-polymorphic over the WHOLE slot (v128-capable) via `word`; both
# operands have the same type (validated), so result_wt is either operand's tag.
select 0x1b (word v1, word v2, i32 c -- word result)
(.  result = c ? v1 : v2;  result_wt = c ? v1_wt : v2_wt;  .)

# select t (typed, §4.6.1): identical execution to untyped select — the result-type vector is
# a validation-only annotation. `selectvec` is its variable tail: the JIT compile-walk skips it
# (meta.tail), the interp handler skips it inline (no native reads it — it falls through).
select_t 0x1c [selectvec types] (word v1, word v2, i32 c -- word result)
(.  result = c ? v1 : v2;  result_wt = c ? v1_wt : v2_wt;  .)

# Indirect call through a table: pop an i32 index, look up the funcref, trap on
# out-of-bounds / null / a type that doesn't match typeidx, then dispatch. The
# native pops the index + params (dynamic arity); the validator (special-cased)
# derives the static stack effect from the typeidx. Binary: 0x11 type table.
#
# The three failures are three DIFFERENT §7.10 traps, and none of them is "out of
# bounds table access" — an index past the end is `undefined element`, a null entry
# is `uninitialized element` (eval.ml CallIndirect). Declared as separate guards in
# the reduction's order, so each reports its own cause.
call_indirect 0x11 [uleb32 type, uleb32 table] ( [jav_type_nparams(type)] any args, addr(table_is64(table)) idx -- )
    flag: pops_first
    error: (. !(idx < table_len(table)) .) -> UndefinedElement
    error: (. jav_is_null(table_get(table, idx)) .) -> UninitializedElement
    error: (. !jav_funcref_typematch(table_get(table, idx), type) .) -> IndirectCallTypeMismatch
(.  jav_invoke_ref(table_get(table, idx));  .)                          # call_ref y

# Tail calls (return_call*): like the matching call, but they REPLACE the current
# frame instead of nesting one — the callee's results become this function's results.
# The native records the target and ends the run; jav_call's loop rebuilds the callee
# in the same frame base (reuse — no stack growth), so tail recursion is O(1) stack.
# The validator special-cases their dynamic arity (and that the callee's results match
# this function's). return_call_indirect/ref carry the funcref-on-stack like the
# indirect/ref call forms; null / type-mismatch trap.
return_call 0x12 [uleb32 func] ( [jav_func_nparams(func)] any args -- )
    flag: pops_first
(.  jav_tail_invoke_ref(jav_funcaddr(func));  .)
return_call_indirect 0x13 [uleb32 type, uleb32 table] ( [jav_type_nparams(type)] any args, addr(table_is64(table)) idx -- )
    flag: pops_first
    error: (. !(idx < table_len(table)) .) -> UndefinedElement
    error: (. jav_is_null(table_get(table, idx)) .) -> UninitializedElement
    error: (. !jav_funcref_typematch(table_get(table, idx), type) .) -> IndirectCallTypeMismatch
(.  jav_tail_invoke_ref(table_get(table, idx));  .)
return_call_ref 0x15 [uleb32 type] ( [jav_type_nparams(type)] any args, any r -- )
    flag: pops_first
    error: (. jav_is_null(r) .) -> NullFunctionReference
(.  jav_tail_invoke_ref(r);  .)

# call_ref: the callee is a funcref on top of the stack (a function index, or null).
# Null traps; the static type was proven by the validator, so there is no dynamic type
# gate (unlike call_indirect). Dispatches through the ordinary nested call path.
call_ref 0x14 [uleb32 type] ( [jav_type_nparams(type)] any args, any r -- )
    flag: pops_first
    error: (. jav_is_null(r) .) -> NullFunctionReference
(.  jav_invoke_ref(r);  .)

# Reference values. A funcref is a word-sized funcinst reference (§4.2.1); the
# null tag JAV_NULLREF lives in the low 32 bits, so the null test masks with (u4)
# to stay valid for full-width references. The heaptype on ref.null is a validator
# concern (which ref type the null is); the runtime value is null regardless.
ref_null 0xd0 [sleb64 ht] ( -- funcref result )
(.  result = JAV_NULLREF;  .)
ref_is_null 0xd1 ( funcref a -- i32 result )
(.  result = ((uint)a == JAV_NULLREF);  .)
ref_func 0xd2 [uleb32 func] ( -- funcref result )
(.  result = jav_ref_func(func);  .)
# Cast a nullable ref to non-null: trap on null, else pass it through.
ref_as_non_null 0xd4 ( funcref a -- funcref result )
    error: (. (uint)a == JAV_NULLREF .) -> NullReference
(.  result = a;  .)
# Branch on a ref's null-ness (conditional, like br_if): br_on_null branches when
# the ref IS null (dropping it; the non-null ref survives on fall-through);
# br_on_non_null branches when it is NOT null (the ref rides along to the label).
# The fall-through result is DECLARED, not pushed by hand. §8.4.6 types this
# `[t* (ref null ht)] -> [t* (ref ht)]`: not branching leaves the operand behind
# with its null stripped. A hand-written `push(r)` inside the body is invisible to
# every consumer of the signature — the tier-2 tree builder, the tiling grammar,
# the storage-class vocabulary — so they all read this as consuming a ref and
# producing nothing, and a body that USES the result (`(drop (br_on_null …))`,
# `(call_ref $t (br_on_null …))`) found an empty abstract stack and declined.
# `transfer()` is an `inline native status`, so the branch-taken path tail-returns
# before the declared result is pushed; only the fall-through reaches it, which is
# exactly the typing above. Compare br_on_non_null below, whose push is on the
# TAKEN path and whose empty result is therefore right.
br_on_null 0xd5 [uleb32 label] ( any r -- any result = "r" )
(.  if (jav_is_null(r)) transfer(); else stp = stp + 1;  .)
br_on_non_null 0xd6 [uleb32 label] ( any r -- )
(.  if (!jav_is_null(r)) { push(r); transfer(); } else stp = stp + 1;  .)

# i31: an UNBOXED 31-bit integer reference (no heap allocation). ref.i31 wraps the
# low 31 bits; i31.get_s/_u read them back (sign- / zero-extended), trapping on null.
# 0xFB is the GC prefix (handled by the multi-byte dispatch).
#
# §4.2.1 REPRESENTATION: `ref.i31 u31` is a VALUE, not an address, and it inhabits anyref/eqref
# alongside `ref.struct structaddr` / `ref.array arrayaddr` which ARE addresses. A slot holding
# either must therefore be SELF-IDENTIFYING — the alternative (a side table saying which) is a
# channel separate from the value, and anything that copies the value without the table loses it
# (that is exactly what ARRAY_SET did: it stored .bits and dropped .kind, so the collector
# dereferenced an i31 as a pointer — a VM SIGSEGV on validated bytecode).
#
# Encoding: (v << 1) | 1 — §2.3.4's ONE reserved bit, no wider. Every gc_obj_t is 8-aligned so an
# odd slot is never a pointer, and null is 0 (even) so a tagged i31 collides with neither. u31 max
# encodes to 0xFFFFFFFF, which is only safe BECAUSE null moved off the all-ones sentinel — the two
# changes are one change (see JAV_NULLREF).
ref_i31 0xfb 28 ( i32 a -- i31ref result )
(.  result = ((long)(a & 2147483647) << 1) | 1;  .)
i31_get_s 0xfb 29 ( i31ref a -- i32 result )
    error: (. (uint)a == JAV_NULLREF .) -> NullI31Reference
(.  result = ((int)a) >> 1;  .)
i31_get_u 0xfb 30 ( i31ref a -- i32 result )
    error: (. (uint)a == JAV_NULLREF .) -> NullI31Reference
(.  result = (a >> 1) & 2147483647;  .)

# GC structs (0xFB prefix). The native does the dynamic stack work (struct.new pops
# the field values + allocates via the heap's collector + pushes the ref; get/set
# read/write a field). The validator type-checks them against the module's struct
# types (concrete ref $t); the runtime field layout comes from the type's rtt.
struct_new 0xfb 0 [uleb32 type] ( [jav_struct_nfields(type)] any fields -- word result )
(.  ulong o = jav_struct_alloc(type);
    for (int i = jav_struct_nfields(type) - 1; i >= 0; i = i - 1) struct_store(type, i, o, fields[i]);
    result = o;  result_wt = T_GCREF;  .)
struct_get 0xfb 2 [uleb32 type, uleb32 field] ( externref o -- any result )    # §4.6 inline (no extern): null guard; tag from the struct RTT
    error: (. ref_isnull(o) .) -> NullStructureReference
(.  result = struct_load(type, field, o);  .)
struct_set 0xfb 5 [uleb32 type, uleb32 field] ( externref o, any v -- )         # §4.6 inline (no extern): null guard
    error: (. ref_isnull(o) .) -> NullStructureReference
(.  struct_store(type, field, o, v);  .)
# GC arrays (0xFB prefix). array.new fills `length` elements with one init value;
# get/set are bounds-checked; len reads the length. The native does the dynamic
# stack work; the validator type-checks against the module's array element type.
array_new 0xfb 6 [uleb32 type] ( any init, i32 len -- word result )
(.  ulong o = jav_array_alloc(type, len);
    for (int i = len - 1; i >= 0; i = i - 1) array_store(type, o, i, init);
    result = o;  result_wt = T_GCREF;  .)
array_get 0xfb 11 [uleb32 type] ( externref o, i32 idx -- any result )    # §4.6 inline (no extern): null+bounds guard; tag from the array RTT
    error: (. ref_isnull(o) .) -> NullArrayReference
    error: (. (uint)idx >= (uint)array_length(o) .) -> OutOfBoundsArrayAccess
(.  result = array_load(type, o, idx);  .)
array_set 0xfb 14 [uleb32 type] ( externref o, i32 idx, any v -- )         # §4.6 inline (no extern): null+bounds guard
    error: (. ref_isnull(o) .) -> NullArrayReference
    error: (. (uint)idx >= (uint)array_length(o) .) -> OutOfBoundsArrayAccess
(.  array_store(type, o, idx, v);  .)
array_len 0xfb 15 ( externref a -- i32 result )    # §4.6 array.len, inline (no extern): null guard + object-header length read
    error: (. ref_isnull(a) .) -> NullArrayReference
(.  result = array_length(a);  .)

# struct.new_default: allocate with every field at its default (0 / null ref). No
# field operands — the native zeroes numbers and nulls references.
struct_new_default 0xfb 1 [uleb32 type] ( -- any result )
(.  result = jav_struct_new_default(type);  .)
# struct.get_s / struct.get_u: read a PACKED field (i8/i16), sign- or zero-extending
# to i32. The native consults the type's packing for the storage width.
struct_get_s 0xfb 3 [uleb32 type, uleb32 field] ( externref o -- i32 result )    # §4.6 packed read, inline (no extern): null guard + sign-extend
    error: (. ref_isnull(o) .) -> NullStructureReference
(.  result = struct_load_packed(type, field, o, 1);  .)
struct_get_u 0xfb 4 [uleb32 type, uleb32 field] ( externref o -- i32 result )    # §4.6 packed read, inline (no extern): null guard + zero-extend
    error: (. ref_isnull(o) .) -> NullStructureReference
(.  result = struct_load_packed(type, field, o, 0);  .)

# array.new_default: allocate `length` (popped) elements at the default value.
array_new_default 0xfb 7 [uleb32 type] ( i32 len -- any result )
(.  result = jav_array_new_default(type, len);  .)
# array.new_fixed: pop N values (static count) and build an array of exactly N.
array_new_fixed 0xfb 8 [uleb32 type, uleb32 n] ( [n] any fields -- word result )
(.  ulong o = jav_array_alloc(type, n);
    for (int i = n - 1; i >= 0; i = i - 1) array_store(type, o, i, fields[i]);
    result = o;  result_wt = T_GCREF;  .)
# array.new_data / new_elem: allocate an array initialised from a data segment (raw
# bytes -> numeric elements) or element segment (refs), from (offset, count) on stack.
# The source bound is in BYTES for a data segment (n elements × the type's store width) and in
# ELEMENTS for an elem segment — hence the different reasons: a data overrun is a MEMORY access,
# an elem overrun a TABLE one.
array_new_data 0xfb 9 [uleb32 type, uleb32 seg] ( i32 off, i32 n -- any result )
    error: (. !(n >= 0 && off >= 0 && (long)off + (long)n * array_elem_width(type) <= data_seg_len(seg)) .) -> OutOfBoundsMemoryAccess
(.  result = jav_array_new_data(type, seg, off, n);  .)
array_new_elem 0xfb 10 [uleb32 type, uleb32 seg] ( i32 off, i32 n -- any result )
    error: (. !(n >= 0 && off >= 0 && (long)off + (long)n <= elem_seg_len(seg)) .) -> OutOfBoundsTableAccess
(.  result = jav_array_new_elem(type, seg, off, n);  .)
# array.get_s / array.get_u: read a PACKED element, sign-/zero-extended to i32.
array_get_s 0xfb 12 [uleb32 type] ( externref o, i32 idx -- i32 result )    # §4.6 packed read, inline (no extern): null+bounds guard + sign-extend
    error: (. ref_isnull(o) .) -> NullArrayReference
    error: (. (uint)idx >= (uint)array_length(o) .) -> OutOfBoundsArrayAccess
(.  result = array_load_packed(type, o, idx, 1);  .)
array_get_u 0xfb 13 [uleb32 type] ( externref o, i32 idx -- i32 result )    # §4.6 packed read, inline (no extern): null+bounds guard + zero-extend
    error: (. ref_isnull(o) .) -> NullArrayReference
    error: (. (uint)idx >= (uint)array_length(o) .) -> OutOfBoundsArrayAccess
(.  result = array_load_packed(type, o, idx, 0);  .)
# array.fill: fill arr[index .. index+count) with one value.
array_fill 0xfb 16 [uleb32 type] ( externref o, i32 i, any v, i32 n -- )    # §4.6 inline (no extern): null+range guard, fill loop
    error: (. ref_isnull(o) .) -> NullArrayReference
    error: (. !((uint)i <= (uint)array_length(o) && (uint)n <= (uint)array_length(o) - (uint)i) .) -> OutOfBoundsArrayAccess
(.  for (long k = 0; k < (long)n; k = k + 1) array_store(type, o, i + k, v);  .)
# array.copy: copy count elements between arrays, overlap-safe (§4.6.7: di<=si ascending, else descending).
array_copy 0xfb 17 [uleb32 dst, uleb32 src] ( externref dsto, i32 di, externref srco, i32 si, i32 n -- )
    error: (. ref_isnull(dsto) || ref_isnull(srco) .) -> NullArrayReference
    error: (. !((uint)di <= (uint)array_length(dsto) && (uint)n <= (uint)array_length(dsto) - (uint)di && (uint)si <= (uint)array_length(srco) && (uint)n <= (uint)array_length(srco) - (uint)si) .) -> OutOfBoundsArrayAccess
(.  if (di <= si) { for (long k = 0; k < (long)n; k = k + 1) array_store(dst, dsto, di + k, array_load(src, srco, si + k)); }
    else { for (long k = (long)n - 1; k >= 0; k = k - 1) array_store(dst, dsto, di + k, array_load(src, srco, si + k)); }  .)
# array.init_data / init_elem: copy from a data/element segment into an existing
# array slice. (arr, array_offset, segment_offset, count)
# Three DISTINCT §7.10 reasons each, declared in the reduction's order (eval.ml:880-883 reduces
# null -> array_oob -> segment_oob). Collapsing them into one combined test — as this once did —
# can only ever report whichever reason the combined branch was labelled with.
array_init_data 0xfb 18 [uleb32 type, uleb32 seg] ( externref arr, i32 d, i32 s, i32 n -- )
    error: (. ref_isnull(arr) .) -> NullArrayReference
    error: (. !(n >= 0 && d >= 0 && (long)d + (long)n <= (long)array_length(arr)) .) -> OutOfBoundsArrayAccess
    error: (. !(s >= 0 && (long)s + (long)n * array_elem_width(type) <= data_seg_len(seg)) .) -> OutOfBoundsMemoryAccess
(.  jav_array_init_data(type, seg, arr, d, s, n);  .)
array_init_elem 0xfb 19 [uleb32 type, uleb32 seg] ( externref arr, i32 d, i32 s, i32 n -- )
    error: (. ref_isnull(arr) .) -> NullArrayReference
    error: (. !(n >= 0 && d >= 0 && (long)d + (long)n <= (long)array_length(arr)) .) -> OutOfBoundsArrayAccess
    error: (. !(s >= 0 && (long)s + (long)n <= elem_seg_len(seg)) .) -> OutOfBoundsTableAccess
(.  jav_array_init_elem(type, seg, arr, d, s, n);  .)

# ref.eq: identity comparison of two eqrefs (struct/array/i31/null). The native pops
# both managed (8-byte) refs and returns 1 if identical. Binary: single byte 0xD3.
ref_eq 0xd3 ( externref a, externref b -- i32 result )
(.  result = (a == b) ? 1 : 0;  .)
# any.convert_extern / extern.convert_any: re-tag a reference between the any and
# extern hierarchies. The underlying reference value is unchanged (identity at
# runtime); only the static type differs, so the body is empty and the validator
# performs the type change. Binary: 0xFB 26 / 0xFB 27.
any_convert_extern 0xfb 26 ( any a -- any result )
(.  result = a;  .)
extern_convert_any 0xfb 27 ( any a -- any result )
(.  result = a;  .)

# Downcasts (0xFB prefix, §5.4.6). ref.test pushes 1/0 for whether the operand's
# DYNAMIC type matches the target heap type; ref.cast traps (or, for the null form,
# passes null through) when it doesn't. The heap type immediate is an sleb: < 0 is
# an abstract heap type (struct/array/eq/any), >= 0 a concrete typeidx. The native
# reads the (8-byte) ref off the stack and checks it against the type's rtt; the
# validator pops a ref and pushes i32 (test) / the target ref (cast). The two
# variants per op differ only in null handling (the nullable flag).
ref_test     0xfb 20 [sleb64 ht] ( any r -- i32 result )
(.  result = jav_ref_test(r, ht, 0);  .)
ref_test_null 0xfb 21 [sleb64 ht] ( any r -- i32 result )
(.  result = jav_ref_test(r, ht, 1);  .)
# §4.6.5 ref.cast IS ref.test plus a trap, so the failure is a declared guard over the same
# §3.3 lattice query the test uses — jav_ref_cast (a second entry that re-ran the query only to
# raise inside a native) is gone.
ref_cast     0xfb 22 [sleb64 ht] ( any r -- any result )
    error: (. !jav_ref_test(r, ht, 0) .) -> CastFailure
(.  result = r;  .)
ref_cast_null 0xfb 23 [sleb64 ht] ( any r -- any result )
    error: (. !jav_ref_test(r, ht, 1) .) -> CastFailure
(.  result = r;  .)

# Branch-on-cast (0xFB prefix). Like br_on_cast = br_if(ref.test): br_on_cast
# branches when the downcast to ht2 SUCCEEDS (the ref rides the label as ht2;
# fall-through keeps it as ht1∖ht2); br_on_cast_fail is the mirror. The immediate
# is castop (two null-flag bits) + labelidx + ht1 + ht2; the branch target is in the
# side-table (the native walks the side-table, ignoring the fetched label). null?2 (the
# target's nullability) is bit 1 of castop.
br_on_cast      0xfb 24 [u8 castop, uleb32 label, sleb64 ht1, sleb64 ht2] ( -- )
(.  if (jav_top_ref_matches(ht2, (castop >> 1) & 1)) transfer(); else stp = stp + 1;  .)
br_on_cast_fail 0xfb 25 [u8 castop, uleb32 label, sleb64 ht1, sleb64 ht2] ( -- )
(.  if (!jav_top_ref_matches(ht2, (castop >> 1) & 1)) transfer(); else stp = stp + 1;  .)

# Table read/write (§4.6 = §7.1.9 table_read/table_write). The reduction is INLINE in both tiers: the
# bounds guard + the indexed access lower through the TABLE_LEN/TABLE_GET/TABLE_SET backend macros, so the
# JIT stencil needs no extern — a funcidx and the null sentinel ride the entry's ref bits, the runtime tag
# (T_REF/T_GCREF) rides the any_t. OOB → trap.
table_get 0x25 [uleb32 table] ( addr(table_is64(table)) i -- any result )    # §3.4.4 table.get x : at -> rt
    error: (. !(i < table_len(table)) .) -> OutOfBoundsTableAccess
(.  result = table_get(table, i);  .)
table_set 0x26 [uleb32 table] ( addr(table_is64(table)) i, any v -- )    # §3.4.4 table.set x : at rt -> eps
    error: (. !(i < table_len(table)) .) -> OutOfBoundsTableAccess
(.  table_set(table, i, v);  .)

# ── SIMD (0xFD prefix) — the "supported" tier ────────────────────────────────
# A lane op's body is the SCALAR per-lane operation; the lane-typed operands
# (i32x4 &c.) tell opgen to GENERATE a per-lane loop around it (one source, both
# tiers, portable; clang -O2 may auto-vectorize). splat broadcasts a scalar to
# every lane (the source stays scalar, so it isn't lane-indexed); add/sub/mul are
# lanewise. Integer ops wrap at the lane width (the element cast: i8x16→s1 &c.).
# Opcodes verified against spec §5.4.9; subopcode is a ULEB u32.
# v128 memory load/store: whole 16-byte transfer (memarg align is advisory; offset is
# added to the address). Bounds-checked in the native (trap on OOB).
v128_load  0xfd 0  [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 16) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_v128(memidx, addr + offset);  .)
v128_store 0xfd 11 [memarg offset] ( addr(mem_is64(memidx)) addr, v128 v -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 16) .) -> OutOfBoundsMemoryAccess
(.  mem_store_v128(memidx, addr + offset, v);  .)
# SIMD widening loads (§4.6.8): read 8 bytes, extendˢˣ each K-bit lane to 2K (the native is the
# literal op). load32/64_zero read N/8 bytes into lane 0, zero the rest. All access ≤ 8 bytes.
v128_load8x8_s  0xfd 1 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load8x8_s(memidx, addr + offset);  .)
v128_load8x8_u  0xfd 2 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load8x8_u(memidx, addr + offset);  .)
v128_load16x4_s 0xfd 3 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load16x4_s(memidx, addr + offset);  .)
v128_load16x4_u 0xfd 4 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load16x4_u(memidx, addr + offset);  .)
v128_load32x2_s 0xfd 5 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load32x2_s(memidx, addr + offset);  .)
v128_load32x2_u 0xfd 6 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load32x2_u(memidx, addr + offset);  .)
v128_load32_zero 0xfd 92 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load32_zero(memidx, addr + offset);  .)
v128_load64_zero 0xfd 93 [memarg offset] ( addr(mem_is64(memidx)) addr -- v128 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load64_zero(memidx, addr + offset);  .)

# v128.const: the 16-byte immediate is read as two raw 8-byte halves (f64 operands, bits
# preserved + JIT-baked) and bit-reinterpreted into the two i64 lanes — reuses the 8-byte
# operand path twice rather than a 16-byte footer carrier.
v128_const 0xfd 12 [f64 lo, f64 hi] ( -- i64x2 result )   (.  result = lane == 0 ? reinterpret(lo) : reinterpret(hi);  .)

# i8x16.shuffle: 16 laneidx immediates (validator bounds each < 32) carried as the same
# two raw halves; per output lane, select byte `idx` from a (idx<16) or b (idx-16).
i8x16_shuffle 0xfd 13 [f64 lo, f64 hi] ( i8x16 a, i8x16 b -- i8x16 result )
(.  long bits = lane < 8 ? reinterpret(lo) : reinterpret(hi);
    long idx = (bits >> ((lane & 7) * 8)) & 0xFF;   # long: the 64-bit `bits` shift must not mask the amount to 31
    result = idx < 16 ? a[idx] : b[(idx - 16) & 15];  .)

# load_splat: load N bits and broadcast to every lane (the lane loop re-reads the same
# address — side-effect-free, so correct). Per-width load native, so not one family.
v128_load8_splat  0xfd 7  [memarg offset] ( addr(mem_is64(memidx)) addr -- i8x16 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i8(memidx, addr + offset);  .)
v128_load16_splat 0xfd 8  [memarg offset] ( addr(mem_is64(memidx)) addr -- i16x8 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i16(memidx, addr + offset);  .)
v128_load32_splat 0xfd 9  [memarg offset] ( addr(mem_is64(memidx)) addr -- i32x4 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i32(memidx, addr + offset);  .)
v128_load64_splat 0xfd 10 [memarg offset] ( addr(mem_is64(memidx)) addr -- i64x2 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = mem_load_i64(memidx, addr + offset);  .)

# load_lane/store_lane: load/store ONE lane (laneidx after the memarg; validator bounds it
# lane < dim). load copies the input vector then overwrites the lane; store writes the lane.
v128_load8_lane  0xfd 84 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i8x16 a -- i8x16 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  result = a; result[lane] = mem_load_i8(memidx, addr + offset);  .)
v128_load16_lane 0xfd 85 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i16x8 a -- i16x8 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  result = a; result[lane] = mem_load_i16(memidx, addr + offset);  .)
v128_load32_lane 0xfd 86 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i32x4 a -- i32x4 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  result = a; result[lane] = mem_load_i32(memidx, addr + offset);  .)
v128_load64_lane 0xfd 87 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i64x2 a -- i64x2 result )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  result = a; result[lane] = mem_load_i64(memidx, addr + offset);  .)
v128_store8_lane  0xfd 88 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i8x16 a -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 1) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i8(memidx, addr + offset, a[lane]);  .)
v128_store16_lane 0xfd 89 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i16x8 a -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 2) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i16(memidx, addr + offset, a[lane]);  .)
v128_store32_lane 0xfd 90 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i32x4 a -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 4) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i32(memidx, addr + offset, a[lane]);  .)
v128_store64_lane 0xfd 91 [memarg offset, u8 lane] ( addr(mem_is64(memidx)) addr, i64x2 a -- )
    error: (. !mem_in_bounds(memidx, addr + offset, 8) .) -> OutOfBoundsMemoryAccess
(.  mem_store_i64(memidx, addr + offset, a[lane]);  .)

# splat: broadcast a scalar to every lane. The 8/16/32-bit int lanes take an i32
# source (one family); the wider lanes take their own scalar.
family ( i32 a -- T result )
(.  result = a;  .)
{ i8x16 i8x16_splat 0xfd 15   i16x8 i16x8_splat 0xfd 16   i32x4 i32x4_splat 0xfd 17 }
i64x2_splat 0xfd 18 ( i64 a -- i64x2 result )    (.  result = a;  .)
f32x4_splat 0xfd 19 ( f32 a -- f32x4 result )    (.  result = a;  .)
f64x2_splat 0xfd 20 ( f64 a -- f64x2 result )    (.  result = a;  .)

# Lanewise arithmetic — ONE body per operator, expanded across the lane shapes
# (the lane element cast wraps integers; floats are exact). i8x16 has no mul; div
# is float-only.
family ( T a, T b -- T result )
(.  result = a + b;  .)
{ i8x16 i8x16_add 0xfd 110  i16x8 i16x8_add 0xfd 142  i32x4 i32x4_add 0xfd 174
  i64x2 i64x2_add 0xfd 206  f32x4 f32x4_add 0xfd 228  f64x2 f64x2_add 0xfd 240 }
family ( T a, T b -- T result )
(.  result = a - b;  .)
{ i8x16 i8x16_sub 0xfd 113  i16x8 i16x8_sub 0xfd 145  i32x4 i32x4_sub 0xfd 177
  i64x2 i64x2_sub 0xfd 209  f32x4 f32x4_sub 0xfd 229  f64x2 f64x2_sub 0xfd 241 }
family ( T a, T b -- T result )
(.  result = a * b;  .)
{ i16x8 i16x8_mul 0xfd 149  i32x4 i32x4_mul 0xfd 181  i64x2 i64x2_mul 0xfd 213
  f32x4 f32x4_mul 0xfd 230  f64x2 f64x2_mul 0xfd 242 }
family ( T a, T b -- T result )
(.  result = a / b;  .)
{ f32x4 f32x4_div 0xfd 231  f64x2 f64x2_div 0xfd 243 }

# Lanewise comparisons (vrelop): each lane → an all-ones (-1) / zero INTEGER mask. The
# signed-int families share the body across widths; _u is the unsigned form (i8x16/
# i16x8/i32x4 only). i64x2 has signed compares only. The FLOAT compares are declared
# separately (below): their inputs are float but the RESULT is an integer mask vector
# (i32x4 / i64x2), so -1 stores as all-ones bits — not as the float -1.0.
family ( T a, T b -- T result ) (.  result = a == b ? -1 : 0;  .)
{ i8x16 i8x16_eq 0xfd 35  i16x8 i16x8_eq 0xfd 45  i32x4 i32x4_eq 0xfd 55  i64x2 i64x2_eq 0xfd 214 }
family ( T a, T b -- T result ) (.  result = a != b ? -1 : 0;  .)
{ i8x16 i8x16_ne 0xfd 36  i16x8 i16x8_ne 0xfd 46  i32x4 i32x4_ne 0xfd 56  i64x2 i64x2_ne 0xfd 215 }
family ( T a, T b -- T result ) (.  result = a < b ? -1 : 0;  .)
{ i8x16 i8x16_lt_s 0xfd 37  i16x8 i16x8_lt_s 0xfd 47  i32x4 i32x4_lt_s 0xfd 57  i64x2 i64x2_lt_s 0xfd 216 }
family ( T a, T b -- T result ) (.  result = a > b ? -1 : 0;  .)
{ i8x16 i8x16_gt_s 0xfd 39  i16x8 i16x8_gt_s 0xfd 49  i32x4 i32x4_gt_s 0xfd 59  i64x2 i64x2_gt_s 0xfd 217 }
family ( T a, T b -- T result ) (.  result = a <= b ? -1 : 0;  .)
{ i8x16 i8x16_le_s 0xfd 41  i16x8 i16x8_le_s 0xfd 51  i32x4 i32x4_le_s 0xfd 61  i64x2 i64x2_le_s 0xfd 218 }
family ( T a, T b -- T result ) (.  result = a >= b ? -1 : 0;  .)
{ i8x16 i8x16_ge_s 0xfd 43  i16x8 i16x8_ge_s 0xfd 53  i32x4 i32x4_ge_s 0xfd 63  i64x2 i64x2_ge_s 0xfd 219 }

# Float lane comparisons: float in, INTEGER mask out (f32x4 -> i32x4, f64x2 -> i64x2).
i32x4_f32x4_eq 0xfd 65 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a == b ? -1 : 0;  .)
i32x4_f32x4_ne 0xfd 66 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a != b ? -1 : 0;  .)
i32x4_f32x4_lt 0xfd 67 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a < b ? -1 : 0;  .)
i32x4_f32x4_gt 0xfd 68 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a > b ? -1 : 0;  .)
i32x4_f32x4_le 0xfd 69 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a <= b ? -1 : 0;  .)
i32x4_f32x4_ge 0xfd 70 ( f32x4 a, f32x4 b -- i32x4 result )  (.  result = a >= b ? -1 : 0;  .)
i64x2_f64x2_eq 0xfd 71 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a == b ? -1 : 0;  .)
i64x2_f64x2_ne 0xfd 72 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a != b ? -1 : 0;  .)
i64x2_f64x2_lt 0xfd 73 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a < b ? -1 : 0;  .)
i64x2_f64x2_gt 0xfd 74 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a > b ? -1 : 0;  .)
i64x2_f64x2_le 0xfd 75 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a <= b ? -1 : 0;  .)
i64x2_f64x2_ge 0xfd 76 ( f64x2 a, f64x2 b -- i64x2 result )  (.  result = a >= b ? -1 : 0;  .)
family ( T a, T b -- T result ) (.  result = (unsigned)a < (unsigned)b ? -1 : 0;  .)
{ i8x16 i8x16_lt_u 0xfd 38  i16x8 i16x8_lt_u 0xfd 48  i32x4 i32x4_lt_u 0xfd 58 }
family ( T a, T b -- T result ) (.  result = (unsigned)a > (unsigned)b ? -1 : 0;  .)
{ i8x16 i8x16_gt_u 0xfd 40  i16x8 i16x8_gt_u 0xfd 50  i32x4 i32x4_gt_u 0xfd 60 }
family ( T a, T b -- T result ) (.  result = (unsigned)a <= (unsigned)b ? -1 : 0;  .)
{ i8x16 i8x16_le_u 0xfd 42  i16x8 i16x8_le_u 0xfd 52  i32x4 i32x4_le_u 0xfd 62 }
family ( T a, T b -- T result ) (.  result = (unsigned)a >= (unsigned)b ? -1 : 0;  .)
{ i8x16 i8x16_ge_u 0xfd 44  i16x8 i16x8_ge_u 0xfd 54  i32x4 i32x4_ge_u 0xfd 64 }

# Unsigned rounding average: (a + b + 1) >> 1 in the unsigned lane domain (i8x16/i16x8).
family ( T a, T b -- T result ) (.  result = ((unsigned)a + (unsigned)b + 1) >> 1;  .)
{ i8x16 i8x16_avgr_u 0xfd 123  i16x8 i16x8_avgr_u 0xfd 155 }

# Saturating add/sub (i8x16/i16x8 only): compute wide, clamp to the lane's range. The
# bounds are type-specific (±127/255 for i8, ±32767/65535 for i16) so each is its own op.
i8x16_add_sat_s 0xfd 111 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int s = a + b; result = s > 127 ? 127 : (s < -128 ? -128 : s);  .)
i8x16_add_sat_u 0xfd 112 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int s = (unsigned)a + (unsigned)b; result = s > 255 ? 255 : s;  .)
i8x16_sub_sat_s 0xfd 114 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int s = a - b; result = s > 127 ? 127 : (s < -128 ? -128 : s);  .)
i8x16_sub_sat_u 0xfd 115 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int s = (unsigned)a - (unsigned)b; result = s < 0 ? 0 : s;  .)
i16x8_add_sat_s 0xfd 143 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int s = a + b; result = s > 32767 ? 32767 : (s < -32768 ? -32768 : s);  .)
i16x8_add_sat_u 0xfd 144 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int s = (unsigned)a + (unsigned)b; result = s > 65535 ? 65535 : s;  .)
i16x8_sub_sat_s 0xfd 146 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int s = a - b; result = s > 32767 ? 32767 : (s < -32768 ? -32768 : s);  .)
i16x8_sub_sat_u 0xfd 147 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int s = (unsigned)a - (unsigned)b; result = s < 0 ? 0 : s;  .)

# Reductions (lane input → i32 scalar). The first body statement is the accumulator
# init (run once); the rest accumulate per lane. `lane` is the current lane index.
family ( T a -- i32 result ) (.  result = 1; result = result & (a != 0 ? 1 : 0);  .)
{ i8x16 i8x16_all_true 0xfd 99  i16x8 i16x8_all_true 0xfd 131  i32x4 i32x4_all_true 0xfd 163  i64x2 i64x2_all_true 0xfd 195 }
family ( T a -- i32 result ) (.  result = 0; result = result | ((a < 0 ? 1 : 0) << lane);  .)
{ i8x16 i8x16_bitmask 0xfd 100  i16x8 i16x8_bitmask 0xfd 132  i32x4 i32x4_bitmask 0xfd 164  i64x2 i64x2_bitmask 0xfd 196 }
v128_any_true 0xfd 83 ( i8x16 a -- i32 result )   (.  result = 0; result = result | (a != 0 ? 1 : 0);  .)

# Swizzle: result lane k = a[b[k]] if the (unsigned) index < 16, else 0 — a dynamic
# per-lane gather. q15mulr: saturating fixed-point Q15 rounding multiply.
i8x16_swizzle 0xfd 14 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int idx = b[lane] & 0xFF; result = idx < 16 ? a[idx] : 0;  .)
i16x8_q15mulr_sat_s 0xfd 130 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int p = (a[lane] * b[lane] + 16384) >> 15; result = p > 32767 ? 32767 : (p < -32768 ? -32768 : p);  .)

# Cross-shape extend: widen the low/high half of the narrower input into the wider
# output. The output-lane loop (over the wider, fewer lanes) reads source lane
# `a[lane]` (low) or `a[lane + outdim]` (high); _s sign-extends via the result cast,
# _u zero-extends via a mask.
i16x8_extend_low_i8x16_s  0xfd 135 ( i8x16 a -- i16x8 result )  (.  result = a[lane];  .)
i16x8_extend_high_i8x16_s 0xfd 136 ( i8x16 a -- i16x8 result )  (.  result = a[lane + 8];  .)
i16x8_extend_low_i8x16_u  0xfd 137 ( i8x16 a -- i16x8 result )  (.  result = a[lane] & 0xFF;  .)
i16x8_extend_high_i8x16_u 0xfd 138 ( i8x16 a -- i16x8 result )  (.  result = a[lane + 8] & 0xFF;  .)
i32x4_extend_low_i16x8_s  0xfd 167 ( i16x8 a -- i32x4 result )  (.  result = a[lane];  .)
i32x4_extend_high_i16x8_s 0xfd 168 ( i16x8 a -- i32x4 result )  (.  result = a[lane + 4];  .)
i32x4_extend_low_i16x8_u  0xfd 169 ( i16x8 a -- i32x4 result )  (.  result = a[lane] & 0xFFFF;  .)
i32x4_extend_high_i16x8_u 0xfd 170 ( i16x8 a -- i32x4 result )  (.  result = a[lane + 4] & 0xFFFF;  .)
i64x2_extend_low_i32x4_s  0xfd 199 ( i32x4 a -- i64x2 result )  (.  result = a[lane];  .)
i64x2_extend_high_i32x4_s 0xfd 200 ( i32x4 a -- i64x2 result )  (.  result = a[lane + 2];  .)
i64x2_extend_low_i32x4_u  0xfd 201 ( i32x4 a -- i64x2 result )  (.  result = a[lane] & 0xffffffff;  .)
i64x2_extend_high_i32x4_u 0xfd 202 ( i32x4 a -- i64x2 result )  (.  result = a[lane + 2] & 0xffffffff;  .)

# Extended multiply: widen each source lane (low/high half) THEN multiply (so the product
# can't overflow the narrow type). _s widens signed via (long); _u zero-extends (mask) then
# multiplies unsigned (ulong) — both avoid signed-overflow UB.
i16x8_extmul_low_i8x16_s  0xfd 156 ( i8x16 a, i8x16 b -- i16x8 result )  (.  result = (long)a[lane] * (long)b[lane];  .)
i16x8_extmul_high_i8x16_s 0xfd 157 ( i8x16 a, i8x16 b -- i16x8 result )  (.  result = (long)a[lane + 8] * (long)b[lane + 8];  .)
i16x8_extmul_low_i8x16_u  0xfd 158 ( i8x16 a, i8x16 b -- i16x8 result )  (.  result = (ulong)(a[lane] & 0xFF) * (ulong)(b[lane] & 0xFF);  .)
i16x8_extmul_high_i8x16_u 0xfd 159 ( i8x16 a, i8x16 b -- i16x8 result )  (.  result = (ulong)(a[lane + 8] & 0xFF) * (ulong)(b[lane + 8] & 0xFF);  .)
i32x4_extmul_low_i16x8_s  0xfd 188 ( i16x8 a, i16x8 b -- i32x4 result )  (.  result = (long)a[lane] * (long)b[lane];  .)
i32x4_extmul_high_i16x8_s 0xfd 189 ( i16x8 a, i16x8 b -- i32x4 result )  (.  result = (long)a[lane + 4] * (long)b[lane + 4];  .)
i32x4_extmul_low_i16x8_u  0xfd 190 ( i16x8 a, i16x8 b -- i32x4 result )  (.  result = (ulong)(a[lane] & 0xFFFF) * (ulong)(b[lane] & 0xFFFF);  .)
i32x4_extmul_high_i16x8_u 0xfd 191 ( i16x8 a, i16x8 b -- i32x4 result )  (.  result = (ulong)(a[lane + 4] & 0xFFFF) * (ulong)(b[lane + 4] & 0xFFFF);  .)
i64x2_extmul_low_i32x4_s  0xfd 220 ( i32x4 a, i32x4 b -- i64x2 result )  (.  result = (long)a[lane] * (long)b[lane];  .)
i64x2_extmul_high_i32x4_s 0xfd 221 ( i32x4 a, i32x4 b -- i64x2 result )  (.  result = (long)a[lane + 2] * (long)b[lane + 2];  .)
i64x2_extmul_low_i32x4_u  0xfd 222 ( i32x4 a, i32x4 b -- i64x2 result )  (.  result = (ulong)(a[lane] & 0xffffffff) * (ulong)(b[lane] & 0xffffffff);  .)
i64x2_extmul_high_i32x4_u 0xfd 223 ( i32x4 a, i32x4 b -- i64x2 result )  (.  result = (ulong)(a[lane + 2] & 0xffffffff) * (ulong)(b[lane + 2] & 0xffffffff);  .)

# Dot product (i16x8 → i32x4): sum of two adjacent lane products per output lane (wraps i32).
i32x4_dot_i16x8_s 0xfd 186 ( i16x8 a, i16x8 b -- i32x4 result )  (.  result = a[lane*2]*b[lane*2] + a[lane*2+1]*b[lane*2+1];  .)

# Extended pairwise add: adjacent lane pairs widened and summed into the wider output.
i16x8_extadd_pairwise_i8x16_s 0xfd 124 ( i8x16 a -- i16x8 result )  (.  result = a[lane*2] + a[lane*2+1];  .)
i16x8_extadd_pairwise_i8x16_u 0xfd 125 ( i8x16 a -- i16x8 result )  (.  result = (a[lane*2] & 0xFF) + (a[lane*2+1] & 0xFF);  .)
i32x4_extadd_pairwise_i16x8_s 0xfd 126 ( i16x8 a -- i32x4 result )  (.  result = a[lane*2] + a[lane*2+1];  .)
i32x4_extadd_pairwise_i16x8_u 0xfd 127 ( i16x8 a -- i32x4 result )  (.  result = (a[lane*2] & 0xFFFF) + (a[lane*2+1] & 0xFFFF);  .)

# int↔float lane conversions. i32x4↔f32x4 is same-shape; f64x2.convert_low takes the low
# two i32 lanes. _u reads the lane unsigned.
f32x4_convert_i32x4_s     0xfd 250 ( i32x4 a -- f32x4 result )  (.  result = a;  .)
f32x4_convert_i32x4_u     0xfd 251 ( i32x4 a -- f32x4 result )  (.  result = (unsigned)a;  .)
f64x2_convert_low_i32x4_s 0xfd 254 ( i32x4 a -- f64x2 result )  (.  result = a[lane];  .)
f64x2_convert_low_i32x4_u 0xfd 255 ( i32x4 a -- f64x2 result )  (.  result = a[lane] & 0xffffffff;  .)
# §4.6 float widen/narrow + popcount. promote reads the low 2 f32 lanes (same lane-iteration
# form as convert_low — compiles inline). popcnt is lane-symmetric, done inline with a SWAR
# bit-twiddle (pure arithmetic — no libcall). demote is asymmetric (4 out lanes from 2 in +
# zero fill), so a whole-vector native (v128 operands ⇒ no lane iteration).
f64x2_promote_low_f32x4 0xfd 95 ( f32x4 a -- f64x2 result )  (.  result = a[lane];  .)
f32x4_demote_f64x2_zero 0xfd 94 ( v128 a -- v128 result )  (.  result = jav_v128_demote_f64x2(a);  .)
i8x16_popcnt 0xfd 98 ( i8x16 a -- i8x16 result )
(.  int _x = a & 0xff; _x = _x - ((_x >> 1) & 0x55); _x = (_x & 0x33) + ((_x >> 2) & 0x33); result = (_x + (_x >> 4)) & 0x0f;  .)

# Narrow two wider vectors into one (lower half from a, upper from b), saturating to the
# narrow lane's signed/unsigned range. The source index is masked so the untaken ternary
# branch isn't a static OOB read.
i8x16_narrow_i16x8_s 0xfd 101 ( i16x8 a, i16x8 b -- i8x16 result )  (.  int x = lane < 8 ? a[lane & 7] : b[lane & 7]; result = x > 127 ? 127 : (x < -128 ? -128 : x);  .)
i8x16_narrow_i16x8_u 0xfd 102 ( i16x8 a, i16x8 b -- i8x16 result )  (.  int x = lane < 8 ? a[lane & 7] : b[lane & 7]; result = x > 255 ? 255 : (x < 0 ? 0 : x);  .)
i16x8_narrow_i32x4_s 0xfd 133 ( i32x4 a, i32x4 b -- i16x8 result )  (.  int x = lane < 4 ? a[lane & 3] : b[lane & 3]; result = x > 32767 ? 32767 : (x < -32768 ? -32768 : x);  .)
i16x8_narrow_i32x4_u 0xfd 134 ( i32x4 a, i32x4 b -- i16x8 result )  (.  int x = lane < 4 ? a[lane & 3] : b[lane & 3]; result = x > 65535 ? 65535 : (x < 0 ? 0 : x);  .)

# Saturating float→int truncation (NaN → 0, clamp to the int range). _zero variants take
# the low two f64 lanes and zero the upper two i32 lanes.
i32x4_trunc_sat_f32x4_s 0xfd 248 ( f32x4 a -- i32x4 result )
(.  float lo = -2147483648.0;  float hi = 2147483648.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~2147483647; }
    else if (a >= hi) { result = 2147483647; }
    else { result = (int)a; }  .)
i32x4_trunc_sat_f32x4_u 0xfd 249 ( f32x4 a -- i32x4 result )
(.  float lo = 0.0;  float hi = 4294967296.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (uint)~0; }
    else { result = (uint)a; }  .)
i32x4_trunc_sat_f64x2_s_zero 0xfd 252 ( f64x2 a -- i32x4 result )
(.  double lo = -2147483648.0;  double hi = 2147483648.0;
    if (lane >= 2) { result = 0; }
    else { double v = a[lane & 1];
        if (v != v) { result = 0; }
        else if (v < lo) { result = ~2147483647; }
        else if (v >= hi) { result = 2147483647; }
        else { result = (int)v; } }  .)
i32x4_trunc_sat_f64x2_u_zero 0xfd 253 ( f64x2 a -- i32x4 result )
(.  double lo = 0.0;  double hi = 4294967296.0;
    if (lane >= 2) { result = 0; }
    else { double v = a[lane & 1];
        if (v != v) { result = 0; }
        else if (v < lo) { result = 0; }
        else if (v >= hi) { result = (uint)~0; }
        else { result = (uint)v; } }  .)

# Lane access (laneidx is a single byte; the validator enforces lane < dim — §3.4.11).
# a[lane] reads/writes the v128's lane view; extract pushes the lane scalar, replace
# copies the vector and overwrites one lane. _s/_u select sign/zero extend (the mask).
i8x16_extract_lane_s 0xfd 21 [u8 lane] ( i8x16 a -- i32 result )   (.  result = a[lane];  .)
i8x16_extract_lane_u 0xfd 22 [u8 lane] ( i8x16 a -- i32 result )   (.  result = a[lane] & 0xFF;  .)
i8x16_replace_lane   0xfd 23 [u8 lane] ( i8x16 a, i32 v -- i8x16 result )   (.  result = a; result[lane] = v;  .)
i16x8_extract_lane_s 0xfd 24 [u8 lane] ( i16x8 a -- i32 result )   (.  result = a[lane];  .)
i16x8_extract_lane_u 0xfd 25 [u8 lane] ( i16x8 a -- i32 result )   (.  result = a[lane] & 0xFFFF;  .)
i16x8_replace_lane   0xfd 26 [u8 lane] ( i16x8 a, i32 v -- i16x8 result )   (.  result = a; result[lane] = v;  .)
i32x4_extract_lane   0xfd 27 [u8 lane] ( i32x4 a -- i32 result )   (.  result = a[lane];  .)
i32x4_replace_lane   0xfd 28 [u8 lane] ( i32x4 a, i32 v -- i32x4 result )   (.  result = a; result[lane] = v;  .)
i64x2_extract_lane   0xfd 29 [u8 lane] ( i64x2 a -- i64 result )   (.  result = a[lane];  .)
i64x2_replace_lane   0xfd 30 [u8 lane] ( i64x2 a, i64 v -- i64x2 result )   (.  result = a; result[lane] = v;  .)
f32x4_extract_lane   0xfd 31 [u8 lane] ( f32x4 a -- f32 result )   (.  result = a[lane];  .)
f32x4_replace_lane   0xfd 32 [u8 lane] ( f32x4 a, f32 v -- f32x4 result )   (.  result = a; result[lane] = v;  .)
f64x2_extract_lane   0xfd 33 [u8 lane] ( f64x2 a -- f64 result )   (.  result = a[lane];  .)
f64x2_replace_lane   0xfd 34 [u8 lane] ( f64x2 a, f64 v -- f64x2 result )   (.  result = a; result[lane] = v;  .)

# Bitwise v128 ops (vvunop/vvbinop): bit-width-agnostic, so lowered as a 2-lane i64
# loop. The validator types them [v128...]->[v128] (lane types -> WVT_V128).
v128_not    0xfd 77 ( i64x2 a -- i64x2 result )               (.  result = ~a;  .)
v128_and    0xfd 78 ( i64x2 a, i64x2 b -- i64x2 result )      (.  result = a & b;  .)
v128_andnot 0xfd 79 ( i64x2 a, i64x2 b -- i64x2 result )      (.  result = a & ~b;  .)
v128_or     0xfd 80 ( i64x2 a, i64x2 b -- i64x2 result )      (.  result = a | b;  .)
v128_xor    0xfd 81 ( i64x2 a, i64x2 b -- i64x2 result )      (.  result = a ^ b;  .)
v128_bitselect 0xfd 82 ( i64x2 a, i64x2 b, i64x2 c -- i64x2 result ) (.  result = (a & c) | (b & ~c);  .)

# Lane shifts (vshiftop: v128 i32 -> v128). The i32 count is shared by all lanes and
# auto-masked mod the lane width (the shift lowering derives the mask from the element
# width). shr_s is arithmetic; shr_u reads the lane unsigned. neg negates lanewise.
family ( T a, i32 count -- T result )
(.  result = a << count;  .)
{ i8x16 i8x16_shl 0xfd 107  i16x8 i16x8_shl 0xfd 139  i32x4 i32x4_shl 0xfd 171  i64x2 i64x2_shl 0xfd 203 }
family ( T a, i32 count -- T result )
(.  result = a >> count;  .)
{ i8x16 i8x16_shr_s 0xfd 108  i16x8 i16x8_shr_s 0xfd 140  i32x4 i32x4_shr_s 0xfd 172  i64x2 i64x2_shr_s 0xfd 204 }
family ( T a, i32 count -- T result )
(.  result = (unsigned)a >> count;  .)
{ i8x16 i8x16_shr_u 0xfd 109  i16x8 i16x8_shr_u 0xfd 141  i32x4 i32x4_shr_u 0xfd 173  i64x2 i64x2_shr_u 0xfd 205 }
family ( T a -- T result )
(.  result = -a;  .)
{ i8x16 i8x16_neg 0xfd 97  i16x8 i16x8_neg 0xfd 129  i32x4 i32x4_neg 0xfd 161
  i64x2 i64x2_neg 0xfd 193  f32x4 f32x4_neg 0xfd 225  f64x2 f64x2_neg 0xfd 237 }

# Lanewise abs (int — negate negative lanes) and signed/unsigned min/max (i64x2 has
# no min/max in the spec; i64x2 abs does exist).
family ( T a -- T result )
(.  result = a < 0 ? -a : a;  .)
{ i8x16 i8x16_abs 0xfd 96  i16x8 i16x8_abs 0xfd 128  i32x4 i32x4_abs 0xfd 160  i64x2 i64x2_abs 0xfd 192 }
family ( T a, T b -- T result )
(.  result = a < b ? a : b;  .)
{ i8x16 i8x16_min_s 0xfd 118  i16x8 i16x8_min_s 0xfd 150  i32x4 i32x4_min_s 0xfd 182 }
family ( T a, T b -- T result )
(.  result = a > b ? a : b;  .)
{ i8x16 i8x16_max_s 0xfd 120  i16x8 i16x8_max_s 0xfd 152  i32x4 i32x4_max_s 0xfd 184 }
family ( T a, T b -- T result )
(.  result = (unsigned)a < (unsigned)b ? a : b;  .)
{ i8x16 i8x16_min_u 0xfd 119  i16x8 i16x8_min_u 0xfd 151  i32x4 i32x4_min_u 0xfd 183 }
family ( T a, T b -- T result )
(.  result = (unsigned)a > (unsigned)b ? a : b;  .)
{ i8x16 i8x16_max_u 0xfd 121  i16x8 i16x8_max_u 0xfd 153  i32x4 i32x4_max_u 0xfd 185 }

# Float lane ops — reuse the scalar intrinsics per lane (fmin/fmax carry WASM NaN/±0
# semantics; abs/sqrt/round via libm). pmin/pmax are the pseudo-min/max (b<a ? b : a).
family ( T a -- T result ) (.  result = fabs(a);    .)  { f32x4 f32x4_abs 0xfd 224     f64x2 f64x2_abs 0xfd 236 }
family ( T a -- T result ) (.  result = sqrt(a);    .)  { f32x4 f32x4_sqrt 0xfd 227    f64x2 f64x2_sqrt 0xfd 239 }
family ( T a -- T result ) (.  result = ceil(a);    .)  { f32x4 f32x4_ceil 0xfd 103    f64x2 f64x2_ceil 0xfd 116 }
family ( T a -- T result ) (.  result = floor(a);   .)  { f32x4 f32x4_floor 0xfd 104   f64x2 f64x2_floor 0xfd 117 }
family ( T a -- T result ) (.  result = ftrunc(a);  .)  { f32x4 f32x4_trunc 0xfd 105   f64x2 f64x2_trunc 0xfd 122 }
family ( T a -- T result ) (.  result = nearest(a); .)  { f32x4 f32x4_nearest 0xfd 106 f64x2 f64x2_nearest 0xfd 148 }
family ( T a, T b -- T result ) (.  result = fmin(a, b);  .)  { f32x4 f32x4_min 0xfd 232  f64x2 f64x2_min 0xfd 244 }
family ( T a, T b -- T result ) (.  result = fmax(a, b);  .)  { f32x4 f32x4_max 0xfd 233  f64x2 f64x2_max 0xfd 245 }
family ( T a, T b -- T result ) (.  result = b < a ? b : a;  .)  { f32x4 f32x4_pmin 0xfd 234  f64x2 f64x2_pmin 0xfd 246 }
family ( T a, T b -- T result ) (.  result = a < b ? b : a;  .)  { f32x4 f32x4_pmax 0xfd 235  f64x2 f64x2_pmax 0xfd 247 }

# Relaxed SIMD (0xFD 256..275). Each op's result is implementation-defined among a
# spec-allowed set; the determinism policy is to pick ONE allowed behavior and lower it
# from a single body, so interp and JIT (which share the body) agree by construction.
# Documented choice per op below. No immediates — plain prefixed opcodes.

# relaxed_swizzle: choose the swizzle behavior (out-of-range index -> 0).
i8x16_relaxed_swizzle 0xfd 256 ( i8x16 a, i8x16 b -- i8x16 result )   (.  int idx = b[lane] & 0xFF; result = idx < 16 ? a[idx] : 0;  .)

# relaxed_trunc: choose the saturating (trunc_sat) behavior for out-of-range / NaN.
i32x4_relaxed_trunc_f32x4_s 0xfd 257 ( f32x4 a -- i32x4 result )
(.  float lo = -2147483648.0;  float hi = 2147483648.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = ~2147483647; }
    else if (a >= hi) { result = 2147483647; }
    else { result = (int)a; }  .)
i32x4_relaxed_trunc_f32x4_u 0xfd 258 ( f32x4 a -- i32x4 result )
(.  float lo = 0.0;  float hi = 4294967296.0;
    if (a != a) { result = 0; }
    else if (a < lo) { result = 0; }
    else if (a >= hi) { result = (uint)~0; }
    else { result = (uint)a; }  .)
i32x4_relaxed_trunc_f64x2_s_zero 0xfd 259 ( f64x2 a -- i32x4 result )
(.  double lo = -2147483648.0;  double hi = 2147483648.0;
    if (lane >= 2) { result = 0; }
    else { double v = a[lane & 1];
        if (v != v) { result = 0; }
        else if (v < lo) { result = ~2147483647; }
        else if (v >= hi) { result = 2147483647; }
        else { result = (int)v; } }  .)
i32x4_relaxed_trunc_f64x2_u_zero 0xfd 260 ( f64x2 a -- i32x4 result )
(.  double lo = 0.0;  double hi = 4294967296.0;
    if (lane >= 2) { result = 0; }
    else { double v = a[lane & 1];
        if (v != v) { result = 0; }
        else if (v < lo) { result = 0; }
        else if (v >= hi) { result = (uint)~0; }
        else { result = (uint)v; } }  .)

# relaxed_madd/nmadd: choose the unfused (separate multiply then add) behavior.
family ( T a, T b, T c -- T result ) (.  result = a * b + c;  .)     { f32x4 f32x4_relaxed_madd 0xfd 261   f64x2 f64x2_relaxed_madd 0xfd 263 }
family ( T a, T b, T c -- T result ) (.  result = -(a * b) + c;  .)  { f32x4 f32x4_relaxed_nmadd 0xfd 262  f64x2 f64x2_relaxed_nmadd 0xfd 264 }

# relaxed_laneselect: choose the bitwise (all-mask-bits) behavior (= v128.bitselect).
family ( T a, T b, T c -- T result ) (.  result = (a & c) | (b & ~c);  .)
{ i8x16 i8x16_relaxed_laneselect 0xfd 265  i16x8 i16x8_relaxed_laneselect 0xfd 266
  i32x4 i32x4_relaxed_laneselect 0xfd 267  i64x2 i64x2_relaxed_laneselect 0xfd 268 }

# relaxed_min/max: choose to return one operand by comparison (no NaN/±0 special-casing).
family ( T a, T b -- T result ) (.  result = a < b ? a : b;  .)  { f32x4 f32x4_relaxed_min 0xfd 269  f64x2 f64x2_relaxed_min 0xfd 271 }
family ( T a, T b -- T result ) (.  result = a > b ? a : b;  .)  { f32x4 f32x4_relaxed_max 0xfd 270  f64x2 f64x2_relaxed_max 0xfd 272 }

# relaxed_q15mulr_s: choose the saturating (q15mulr_sat_s) behavior at the 0x8000 corner.
i16x8_relaxed_q15mulr_s 0xfd 273 ( i16x8 a, i16x8 b -- i16x8 result )   (.  int p = (a[lane] * b[lane] + 16384) >> 15; result = p > 32767 ? 32767 : (p < -32768 ? -32768 : p);  .)

# relaxed_dot: choose direct integer accumulation (no intermediate i16-wrap). _s pairs i8
# bytes into i16 lanes; _add_s sums four bytes into each i32 lane plus the i32x4 addend.
i16x8_relaxed_dot_i8x16_i7x16_s 0xfd 274 ( i8x16 a, i8x16 b -- i16x8 result )  (.  result = a[lane*2]*b[lane*2] + a[lane*2+1]*b[lane*2+1];  .)
i32x4_relaxed_dot_i8x16_i7x16_add_s 0xfd 275 ( i8x16 a, i8x16 b, i32x4 c -- i32x4 result )
(.  result = a[lane*4]*b[lane*4] + a[lane*4+1]*b[lane*4+1] + a[lane*4+2]*b[lane*4+2] + a[lane*4+3]*b[lane*4+3] + c[lane];  .)
