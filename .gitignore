# Build trees — every artifact under here is reproducible from `make`.
# The variant trees are the same thing under a different CFLAGS: SAN=1 builds
# into build-asan/, PROFILE=1 into build-prof/ (wasm/Makefile). `build/` does
# not match those names, so they are listed rather than inferred. There is no
# PIC variant: the shipped archive is position-independent in the one build.
build/
build-asan/
build-prof/

# Reference specs (Sun/Oracle JLS 1.0, the WebAssembly Core spec, the Alves-Foss
# grammar paper). Kept on disk for authoring — the code cites section numbers,
# never file paths, and gen_instr_toml.py reads WebAssembly.pdf only when the
# committed spec/instructions.toml needs re-deriving — but not redistributed:
# download your own copy if you need one. Anchored to root so these titles are
# the only PDFs affected.
/java-langspec-1.0.pdf
/WebAssembly.pdf
/Formal Grammar for Java.pdf

# Compiler dependency files emitted by -MMD next to the source (wasm/ root).
*.d
# ...except the BBQ generator specs, which are real sources with a .def suffix.
!*.def

# Object files and libraries.
*.o
*.a

# Valgrind / kernel core dumps. These have reached 200 MB+ in wasm/test.
vgcore.*
core.*
*.core

# LSP/tooling scratch.
compile_commands.json
.cache/

# Per-machine build overrides, read by all three makefiles (chiefly BBQ=<path>
# to build against a working toolchain checkout instead of the submodule).
# Untracked by design: the tracked default is the pinned submodule.
/config.mk

# The Unicode generator's compiled binary — a build artifact. The SOURCE and the
# pinned UnicodeData.txt are tracked; rebuild per the recipe in gen_character.c.
compiler/tools/unicode/gen_character

# Test executables land in build/, never beside their sources. The pre-2026-07
# in-place binaries have been removed; this keeps them from coming back.
wasm/test/test_*
!wasm/test/test_*.c
!wasm/test/test_*.h

# conformance/generated — written by conformance/run-generated.sh on every gate run.
# A build artifact: the SOURCE is conformance/gen, and the generator is deterministic, so a
# checked-in copy could only ever be stale or contradict the snippets that produce it.
conformance/generated/
