# Build trees — every artifact under here is reproducible from `make`.
build/

# Compiler dependency files emitted by -MMD next to the source (wasm/ root).
*.d
# ...except the BBQ generator specs, which are real sources with a .def suffix.
!*.def

# Object files and libraries.
*.o
*.a

# Valgrind / kernel core dumps. These have reached 200 MB+ in wasm/test.
vgcore.*
core.*
*.core

# LSP/tooling scratch.
compile_commands.json
.cache/

# Per-machine build overrides, read by all three makefiles (chiefly BBQ=<path>
# to build against a working toolchain checkout instead of the submodule).
# Untracked by design: the tracked default is the pinned submodule.
/config.mk

# The Unicode generator's compiled binary — a build artifact. The SOURCE and the
# pinned UnicodeData.txt are tracked; rebuild per the recipe in gen_character.c.
compiler/tools/unicode/gen_character

# Test executables land in build/, never beside their sources. The pre-2026-07
# in-place binaries have been removed; this keeps them from coming back.
wasm/test/test_*
!wasm/test/test_*.c
!wasm/test/test_*.h
