// compiler.ddcg — yoctojc DDCG-driven AST → SIR compiler.
//
// Every AST constructor is either covered by a rule below or listed
// in DESUGARED (not yet implemented, or sema-desugared and never
// reaching codegen).

COMPILER ddcg

(. #include "javelina/compiler/compiler_runtime.h" .)

IMPORTS
  ast = "java.json"
  ir  = "sir.json"

DESTINATIONS
  ir_root ir.node
  // A delivery destination. `loc` is a primitive slot (carries its width dt);
  // `locref` is a reference slot (carries its referent descriptor — the proven
  // ClassRef/ArrayRef/PrimArray from sema — so the StoreLocal it builds states
  // the slot's type rather than the backend recovering it from the value).
  data_dest delta { effect | loc(slot: int, dt: ir.datatype) | locref(slot: int, ref: ir_root) }
  ctrl_dest gamma { single(L: ir_root) | pair(Lt: ir_root, Lf: ir_root) | ret }
  // ρ encodes the lexical scope chain. Each loop or labeled-block
  // rule wraps body's ρ with a fresh `loop_frame` variant; break/
  // continue walk the chain by integer depth (sema computed it at
  // analysis time). No labels here — sema resolved them, codegen
  // just walks. continue_target=nil for labeled-block frames since
  // continue can't target a labeled block.
  // ρ encodes the lexical scope chain. loop_frame holds break/continue
  // targets; finally_frame holds the AST of a pending finally body.
  // Both pre-existing and new try-finally control transfers walk ρ
  // looking for the right frame, compiling finally bodies they cross.
  // No separate finally_stack_ in MEMBERS — ρ IS the stack.
  // try_frame marks "lexically inside a try block that has handlers but no finally".
  // Nothing runs on the way out of it; it exists so `return` can see that it is inside
  // a try_table — a tail call there would pop the frame, and with it the handlers, so
  // the value must be spilled and returned by a plain Return.
  //
  // BOTH protected frames carry their try's REGION ID (spec §6). WE are the stage that
  // knows which handlers enclose a Throw — we are building the try — so we SAY SO, and
  // the optimizer's escape lattice reads it. It must never recover the enclosing
  // handlers by walking the SIR: a region's EXTENT is not in the graph, and §8 ("Why
  // there is no dominator tree") rules out rediscovering it.
  //
  // An ID and not the handler nodes, because of BUILD ORDER: the ExceptionEntry
  // handlers are built AFTER the body they protect (the body is `gen`'d first, then
  // wrapped in the catch chain), so at the moment a Throw inside the body is minted the
  // handlers do not exist yet. The id is allocated BEFORE the body; `record_try_region`
  // stamps the same id on each handler row when the chain is built; the two join on it.
  env_dest  rho   { rho_root
                  | loop_frame(break_target: ir_root,
                               continue_target: ir_root,
                               parent: rho)
                  | finally_frame(body: ast.stmt, region: int, parent: rho)
                  | try_frame(region: int, parent: rho) }

  // Defunctionalised "what tree to wrap the operand in" for the
  // single-operand spill-or-simple pattern. Each variant captures
  // the per-op fields the SIR ctor needs; `build_tree_op(op, value)`
  // constructs the right SIR node. ArrayLoad isn't here — it's a
  // two-operand spill that needs its own helper. The 10+ duplicated
  // spill helpers collapsed into one parameterised by this sum.
  sum tree_op {
      ArrayLengthOp
    | GetFieldOp(dt: ir.datatype, cls_id: int, cp: int)
    | NewArrayOp(at: ir.atype)
    | NewRefArrayOp(eref: ir_root)
    | CheckCastOp(at: ir.atype, cp: int)
    | InstanceOfOp(at: ir.atype, cp: int)
    | S2IOp
    | I2SOp
    | S2BOp
    | I2BOp
    // §5.1.2/§5.1.3 — direct width-changing conversions.
    | I2COp | I2LOp | I2FOp | I2DOp
    | L2IOp | L2FOp | L2DOp
    | F2IOp | F2LOp | F2DOp
    | D2IOp | D2LOp | D2FOp
    // Bit-preserving moves (typed bitcast) — back the raw java.lang.Float/Double bit accessors.
    | MoveF2IOp | MoveI2FOp | MoveD2LOp | MoveL2DOp
    // f64 math intrinsics with a direct wasm opcode (§20.11 Math.sqrt/floor/ceil/rint).
    | F64SqrtOp | F64FloorOp | F64CeilOp | F64NearestOp
    // §20.3.6 Class.newInstance, over a Class receiver: is its factory funcref non-null / call it.
    | ClassInstantiableOp | ClassConstructOp
    // Composite narrowings to a sub-int type from long/float/double:
    // first to int (§5.1.3), then int to the target — a two-node tree.
    | L2BOp | L2SOp | L2COp
    | F2BOp | F2SOp | F2COp
    | D2BOp | D2SOp | D2COp
  }

  // Pure (cg_store) vs Effectful (cg_deliver_effectful) delivery —
  // pure ops can't throw and have no observable side effect, so a
  // dropped result simply doesn't evaluate. Effectful ops (NPE
  // candidates, allocation, etc.) must evaluate even when the value
  // is dropped, so they wrap in ExprEffect at effect+single sites.
  sum delivery_kind { Pure | Effectful }

  // Sema-side classification of `(T) e`. Hoists the JLS-level case
  // distinction out of ddcg's rule heads — sema is the JLS authority
  // and exposes the lowering case directly. ddcg matches on this
  // sum and the typechecker enforces exhaustiveness, so adding a
  // new sema kind without a ddcg arm is a hard error rather than
  // a silent fall-through. Variants encode the per-kind data ddcg
  // needs (CP indices for ref forms; nothing for primitive convs).
  sum sema_cast_kind {
      CastIdentity                     // src_dt == target_dt, non-ref → gen inner
    | CastS2I | CastI2S | CastS2B | CastI2B
                                       // primitive narrow/widen
    // §5.1.2/§5.1.3 — direct conversions and composite sub-int narrowings.
    | CastI2C | CastI2L | CastI2F | CastI2D
    | CastL2I | CastL2F | CastL2D
    | CastF2I | CastF2L | CastF2D
    | CastD2I | CastD2L | CastD2F
    | CastL2B | CastL2S | CastL2C
    | CastF2B | CastF2S | CastF2C
    | CastD2B | CastD2S | CastD2C
    // §5.5 reference checkcast. A class/interface, or a PRECISE primitive-array cast (its
    // PrimArray overlay IS the exact type), lowers to ref.cast the overlay struct (cp).
    | CastClass(cp: int)
    // A reference/multi-dimensional array is NOT precisely a struct (all reference arrays share
    // one RefArray) — so its checkcast is a RUNTIME, element-precise Class.isInstance guard
    // (§15.19.2) against the target's §10.8 array Class, then ref.cast the RefArray overlay.
    | CastArrayReflect(cp: int)
    | CastNoop                         // unresolved → gen inner
  }

  // Sema-side classification of `e instanceof T`. Same shape as
  // cast, minus the primitive-conv variants (instanceof is reference-
  // only) and minus IDENTITY (instanceof never elides).
  sum sema_instanceof_kind {
      InstanceOfClass(cp: int)         // §15.19.2 class/interface OR precise primitive-array: ref.test the overlay
    | InstanceOfArrayReflect(cp: int)  // reference/multi-dim array: runtime Class.isInstance guard
    | InstanceOfAlwaysFalse            // unresolved → const 0
  }

AUXILIARIES
  // Returns ir_root to satisfy the dispatcher's return type; the
  // C implementation is __attribute__((noreturn)) and aborts.
  panic_unreachable : (string) -> ir_root

  // Sema queries — sema's data_types / ident_kinds tables are
  // pointer-keyed by AST node, so these take the matched node.
  // sema_data_type returns SIR_DTSHORT for nodes sema didn't tag;
  // negative-sentinel handling lives in the C body, not the rule.
  sema_data_type    : (ast.expr) -> ir.datatype

  // Parametric fallback variant — when sema didn't tag the node,
  // returns `fallback` instead of SIR_DTSHORT. Used by binop where
  // operand dt should fall back to the binop's own dt, not hardcoded.
  sema_data_type_or : (ast.expr, ir.datatype) -> ir.datatype

  // JLS §5.6 numeric promotion (the type lattice is the authority): the binop
  // operand computation type (dt_promote = §5.6.2 common type, dt_unary = §5.6.1
  // sub-int → int), and the (from→to) conversion realization for an operand.
  dt_promote        : (ir.datatype, ir.datatype) -> ir.datatype
  dt_unary          : (ir.datatype) -> ir.datatype
  num_conv          : (ir.datatype, ir.datatype) -> sema_cast_kind

  // sema_ident_kind returns the SEMA_IDENT_* tag (-1 if unresolved).
  // The other ident accessors are only valid when kind >= 0.
  sema_ident_kind   : (ast.expr) -> int
  sema_ident_slot   : (ast.expr) -> int
  // The Move* bit-accessor kind for a move-intrinsic call (guarded by sema_is_move_intrinsic):
  // 1 = MoveF2I, 2 = MoveI2F, 3 = MoveD2L, 4 = MoveL2D.
  sema_move_intrinsic_kind : (ast.expr) -> int
  // The Math f64-op kind for a math-intrinsic call (guarded by sema_is_math_intrinsic):
  // 1 = sqrt, 2 = floor, 3 = ceil, 4 = rint (§20.11).
  sema_math_intrinsic_kind : (ast.expr) -> int
  // javelina.simd intrinsic facts (guarded by sema_is_simd_intrinsic): the family
  // (1 Bin 2 Un 3 Shift 4 Tern 5 TestI 6-9 Splat I/L/F/D 10-13 Extract I/L/F/D
  // 14-17 Replace I/L/F/D 18 Const 19 Shuffle 20 MemLoad 21 MemStore
  // 22 MemLoadLane 23 MemStoreLane), the WOP_* opcode value the SIR node
  // carries verbatim, the sema-validated lane immediate, and (memarg/memlane
  // families) the spec table's align column. The 128-bit const/shuffle
  // immediates do not fit an int extern: sema_simd_fill writes the stashed
  // halves INTO the built node C-side (by tag) and returns 0.
  sema_simd_family : (ast.expr) -> int
  sema_simd_op     : (ast.expr) -> int
  sema_simd_lane   : (ast.expr) -> int
  sema_simd_align  : (ast.expr) -> int
  sema_simd_awidth : (ast.expr) -> int    // the ACCESS width in bytes (1 << align) — the Mem bounds-guard span
  sema_simd_fill   : (ir_root, ast.expr) -> int
  // The Class.newInstance helper kind (guarded by sema_is_class_intrinsic): 1 = instantiable? (i32),
  // 2 = construct (ref). Each operates on the receiver Class (§20.3.6).
  sema_class_intrinsic_kind : (ast.expr) -> int
  sema_ident_dt     : (ast.expr) -> ir.datatype
  // The reference-type descriptor (ir.ClassRef/ArrayRef/PrimArray) for a ref
  // ident, or nil for a primitive — the proven referent carried to burg.
  sema_ident_ref    : (ast.expr) -> ir_root
  // Same, for an arbitrary expression's result type (the referent a spill temp
  // holding that expression's value should be typed as). nil for primitives.
  expr_ref          : (ast.expr) -> ir_root
  // The referent descriptor for an array expression's ELEMENT type — carried on
  // ArrayLoad/ArrayStore so burg picks the element cast typeidx. nil when the
  // element is primitive (the numeric array rules describe it fully).
  array_elem_ref    : (ast.expr) -> ir_root
  // §10 RefArray overlay: the synthesized class every REFERENCE array is
  // represented by, and the class-local field index of its `data` (the backing
  // top-ref array). A ref-array op indirects its array operand through
  // GetField(RefArray.data); a primitive array is a concrete array (no indirection).
  refarray_class      : ()  -> int
  refarray_data_field : ()  -> int
  refarray_elem_field : ()  -> int
  // §10.10 ArrayStore: java.lang.Class (the InvokeStatic target) and the index of its
  // arrayStoreCheck(Class,Object) method (-1 if the prelude lacks it).
  arraystore_check_class  : () -> int
  arraystore_check_method : () -> int
  // §15.19.2 reference-array instanceof/checkcast: java.lang.Class (the InvokeVirtual receiver
  // type) and the index of its isInstance(Object) method (the runtime, element-precise check).
  class_reflect_id        : () -> int
  class_is_instance_method : () -> int
  // §10.7 per-width PrimArray overlays: the struct a primitive array is represented by,
  // resolved by element width (datatype for access, atype for creation), and the
  // class-local index of its `data` (the concrete (array W) backing).
  primarray_class_dt    : (ir.datatype) -> int
  primarray_class_atype : (ir.atype)    -> int
  primarray_data_field  : ()            -> int
  // The element datatype of an array-typed expression (for the PrimBacking cast width).
  sema_array_elem_dt   : (ast.expr) -> ir.datatype
  // §10.8 the Class-object class id for an array-typed expression's type (its getClass()),
  // or -1 if not registered (falls back to the shared overlay Class).
  array_class_id       : (ast.expr) -> int
  // §10.8 for a multi-dim allocation: the Class object of the `dims`-dimensional array of
  // the node's base element (each nesting level has its own array Class), or -1.
  array_class_at       : (ast.expr, int) -> int
  // §10.10 for a multi-dim allocation level: the elementClass (component Class) of a level
  // whose component is `comp_dims`-deep — base class (0), else the component array's Class.
  array_elem_class_at  : (ast.expr, int) -> int
  // The element type's class id for an array-creation/initializer node, or -1 when
  // the element is a primitive or a nested array (a non-class element — §10.10
  // elementClass is stamped only for a reference-CLASS element for now).
  array_elem_class    : (ast.expr) -> int
  // WASM-GC field identity: the class that DECLARES the accessed field and the
  // field's class-local index — struct.get/set need the declaring struct type
  // and the field's position.
  sema_field_decl_class : (ast.expr) -> int
  sema_field_index      : (ast.expr) -> int
  // WASM-GC method identity: the declaring class + the method's class-local
  // index (the function identity). Replaces sema_cp_index on the invoke path.
  sema_method_decl_class : (ast.expr) -> int
  sema_method_index      : (ast.expr) -> int

  // Local-slot lookup for a var_decl (LocalVarDecl declarator).
  sema_var_slot     : (ast.var_decl) -> int
  // The ref descriptor for a local's DECLARED type (sema's stored resolution) — types the slot when the
  // initializer is a `null` literal (which carries no descriptor of its own). nil for a primitive local.
  sema_var_ref      : (ast.var_decl) -> ir_root

  // JLS §13.1: a use of a CONSTANT VARIABLE (§4.12.4) — a final variable whose initializer is a
  // constant expression — is resolved to its VALUE at compile time. (folded, literal): the literal
  // node when the expression is a §15.27 constant, (false, nil) otherwise.
  //
  // EVERY primitive type, via the ONE §15.27 evaluator (const_expr.c). The predicate it replaces
  // folded byte/short/int only — a `static final long` / `double` / `float` / `char` / `boolean`
  // emitted a real GetStatic, so `static final boolean DEBUG = false;` could not even be seen as a
  // constant `false` by §14.19's reachability.
  fold_const_expr : (ast.expr) -> tuple<bool, ir_root>

  // Per-method ambient state read from ctx.
  current_return_dt : ()         -> ir.datatype
  // The current method's return-TYPE ref descriptor (nil for primitive/void) — types a `return null`
  // spill temp, whose null value carries no descriptor of its own.
  current_return_ref : ()        -> ir_root
  current_class_id  : ()         -> int

  // Wrap a sir node in a Nop if it isn't already a labeled target,
  // so emit_backpatch can resolve a branch's arms.
  ddcg_label        : (ir_root)  -> ir_root

  // Allocate a fresh temp slot of the given data type, returning the
  // slot index. Slot allocator is monotonic per method.
  ddcg_alloc_temp   : (ir.datatype) -> int

  // SIR back-patch primitive for loop construction. Ltop is forward-
  // declared as Nop(nil) so the loop body can reference it; once the
  // test/body spine is built, sir_set_next stitches Ltop's next to
  // the test entry. Returns ir_root for chaining inside `let`.
  sir_set_next      : (ir_root, ir_root) -> ir_root

  // Sema resolved break/continue label-to-target lookups during
  // analysis. These return the # of ρ frames to skip from the
  // current scope to reach the target frame (0 = innermost).
  // Returns -1 if sema couldn't resolve (also reported as a sema
  // error; codegen falls through defensively).
  sema_break_target_depth    : (ast.stmt) -> int
  sema_continue_target_depth : (ast.stmt) -> int

  // Switch helpers — sema's analysis pass already sorted the case
  // values + computed degeneracy. These expose the relevant facts.
  sema_switch_default_idx    : (ast.stmt) -> int    // -1 if no default
  sema_switch_is_default_only : (ast.stmt) -> bool  // SEMA_SWITCH_DEFAULT_ONLY
  sema_switch_selector_dt    : (ast.stmt) -> ir.datatype
                                                    // INT for int selector,
                                                    // SHORT for byte/bool/short

  // JLS §14.19: can this statement complete normally (assuming it is reachable)? The
  // spec's structural rules, computed by sema. A statement that cannot complete normally
  // has no normal-completion successor, so no chain may be built for one — a try whose
  // block cannot complete normally (`try { for(;;) {…} } finally {…}`) has no path from
  // the body to the inlined-finally-then-join, and emitting one is emitting dead code
  // that the WASM validator then has to make sense of.
  sema_can_complete_normally : (ast.stmt) -> bool

  // JLS §15.27: is this a constant expression with value `true`? The condition of a
  // `while (true)` / `do … while (true)` / `for (; true;)` — the exact expression §14.19 gives
  // special treatment. When it is, there is no test to evaluate and no false edge, so the loop
  // is lowered exactly like `for (;;)`. Same predicate sema's §14.19 uses: one authority.
  sema_is_constant_true : (ast.expr) -> bool

  // Tier-B' SIR helper — pulls case_values + case_ast_indices from
  // sema, maps each sorted slot to its body_head, picks the default
  // target, and builds the SIR_SWITCH node. Returns the spine head.
  build_switch_node : (ast.stmt, list<ir_root>, ir_root, ir_root, ir.datatype)
                       -> ir_root

  // Heap / call sema queries — defensive defaults for unresolved nodes
  // (sema reports the error; codegen falls through with conservative
  // values rather than null-deref).
  sema_field_acc_dt           : (ast.expr) -> ir.datatype  // SHORT default
  sema_field_is_static        : (ast.expr) -> bool         // false default
  sema_field_obj_class_id     : (ast.expr) -> int          // 0 default
  sema_ensure_init_cp         : (int) -> int               // §12.4.2 class's $ensure_init method idx (cp)
  sema_class_needs_init       : (int) -> bool              // §12.4.2 does the class need init? (barrier gate, used in exprs)
  sema_is_array_length        : (ast.expr) -> bool         // FieldAccess of array length
  sema_array_acc_dt           : (ast.expr) -> ir.datatype  // BYTE default
  sema_may_have_effects       : (ast.expr) -> bool

  // SuperAccess — sema_resolved_super_field is the source of truth.
  // CP fallback: when sema_cp_index returns -1, fall through to f->index.
  sema_super_field_dt         : (ast.expr) -> ir.datatype
  sema_super_field_is_static  : (ast.expr) -> bool
  sema_super_field_cp         : (ast.expr) -> int
  sema_super_parent_class_id  : ()         -> int          // -1 if no super

  // ArrayInit — sema annotates the contextual element type (JLS §10.6
  // — component type comes from the target, not the literals).
  sema_arrayinit_atype        : (ast.expr) -> ir.atype     // BYTE default
  sema_arrayinit_dt           : (ast.expr) -> ir.datatype  // BYTE default

  // Intern this ArrayInit's elements into the module's constant-data pool and answer the
  // BYTE OFFSET the run starts at. Only meaningful when arrayinit_is_const holds; call once
  // per lowering (identical runs are shared, so a second call is wasteful, not wrong).
  const_data_offset           : (ast.expr) -> int

  // JLS-level kind classifiers. ddcg used to match on AST type tags
  // (`ast.ByteType` / `ast.ClassType` / etc.) inside rule bodies to
  // decide which lowering path to take; sema is the JLS authority,
  // so the classification belongs there. ddcg consumes via match on
  // the closed sum, with ddcgc enforcing exhaustiveness.
  sema_cast_kind              : (ast.expr) -> sema_cast_kind
  // JLS §5.2 assignment conversion: the implicit numeric conversion to bring `v`
  // to a declared `to` type (return/assign/arg). Same authority as sema_cast_kind
  // (the type lattice's lat_num_conv), so explicit and implicit never diverge.
  assign_conv                 : (ast.expr, ir.datatype) -> sema_cast_kind
  sema_instanceof_kind        : (ast.expr) -> sema_instanceof_kind

  // new-array (incl. multi-dimensional) leaf queries. `dims` carries one entry
  // per bracket level (rank = the list length); NULL = an unsized `[]` dim.
  // sized = leading sized-dim count; eref_at gives the element referent of the
  // array whose element is the base wrapped `depth` times (nil = primitive
  // element → allocate via base_atype); array_dim projects a size expression.
  array_rank                  : (ast.expr) -> int
  array_sized_dims            : (ast.expr) -> int
  array_eref_at               : (ast.expr, int) -> ir_root
  array_base_atype            : (ast.expr) -> ir.atype
  array_dim                   : (ast.expr, int) -> ast.expr

  // MethodCall — sema's invoke_kind / target_class / return-type
  // annotations drive opcode + bytecode-arity selection.
  sema_invoke_kind            : (ast.expr) -> int       // SEMA_INVOKE_*; -1=unresolved
  sema_invoke_target_class    : (ast.expr) -> int       // 0 default
  sema_invoke_dt              : (ast.expr) -> ir.datatype
  sema_invoke_is_void         : (ast.expr) -> bool

  // JLS §5.3 method-invocation conversion: the dt to deliver arg `arg_idx` AS —
  // the resolved callee's declared param type — so cg_deliver_conv widens
  // (int→long for `new Long(42)`, etc.). Keyed by the (defining class, method
  // index) the invoke already carries.
  sema_param_dt               : (int, int, int) -> ir.datatype
  // The param slot's REF descriptor (class/array param → ClassRef/ArrayRef; nil for a
  // primitive param). Types an arg spill temp whose argument has no descriptor of its
  // own — a `null` literal — from the param type (the one authority for the slot).
  sema_param_ref              : (int, int, int) -> ir_root

  // JLS §15.18.1 string concatenation: sema types `a + b` as String; the ddcg
  // defunctionalizes it into new StringBuffer().append(a).append(b).toString().
  // §15.17.3 float/double `%` → a call to Math's fdlibm fmod (WASM has no f32/f64.rem).
  sema_frem_class             : ()              -> int
  sema_frem_method            : (ir.datatype)   -> int

  // These expose the well-known StringBuffer identities (all in string_buffer_id).
  // (sema_binary_is_concat is a PREDICATE — declared in that section for the guard.)
  sema_string_buffer_id       : ()         -> int
  sema_sb_ctor_index          : ()         -> int
  sema_sb_tostring_index      : ()         -> int
  sema_sb_append_index        : (ast.expr) -> int      // append overload for the operand's type
  sema_sb_append_param_class  : (ast.expr) -> int      // its (ref) param class, or -1 for a primitive

  // New — target class (sema's recorded resolution — codegen never
  // re-resolves a spelled name, §6.5.4 is unit-relative) and constructor
  // CP index. The latter is -1 when there's no explicit ctor.
  sema_new_target_class       : (ast.expr) -> int       // -1 if unresolved
  sema_new_ctor_cp            : (ast.expr) -> int       // -1 if no ctor

  // §15 implicit exceptions: the well-known exception class ids + a class's no-arg
  // ctor index, so the backend guards can synthesize `new X()`.
  sema_arithmetic_exc_id      : ()    -> int
  sema_null_pointer_exc_id    : ()    -> int
  sema_array_index_exc_id     : ()    -> int
  sema_neg_array_size_exc_id  : ()    -> int
  sema_class_cast_exc_id      : ()    -> int
  sema_index_oob_exc_id       : ()    -> int            // §20.18.16 base IndexOutOfBoundsException (NOT the array subclass)
  sema_array_store_exc_id     : ()    -> int            // §10.10 ArrayStoreException
  sema_noarg_ctor_index       : (int) -> int            // -1 if none
  // A compiler-SYNTHESIZED exception carries its reason (§11.4 prints "/ by zero"), so the
  // guard needs the (String) ctor of the exception class, String(char[]) to build the
  // argument, and String's own class id. Each is -1 when absent, so the caller falls back to
  // the no-arg form rather than emitting a call to nothing.
  sema_string_arg_ctor_index  : (int) -> int
  sema_string_chars_ctor_index: ()    -> int
  sema_string_class_id        : ()    -> int
  // Pool a message into the module's constant data; its byte offset and its length in code
  // units. The pool takes raw bytes, so a synthesized message needs no AST literal to
  // desugar — which is what made this possible at all (rule string_lit panics by design).
  const_string_offset         : (string) -> int
  const_string_length         : (string) -> int

  // SuperCall / ConstructorCall — sema_resolved_super_method tells
  // us whether the parent-class method was found.
  sema_super_method_resolved  : (ast.expr) -> bool

  // ConstructorCall target class — current class for `this(...)`
  // (is_super=false), super class for `super(...)` (is_super=true).
  // -1 when the lookup fails (unresolved super, etc.).
  sema_ctor_call_target_class : (ast.expr) -> int

  // Try / catch helpers. ex_slot reuses sema's pre-allocated slot for
  // the catch parameter; falls back to a fresh DtRef temp when sema
  // didn't slot it. catch_type is the caught type's class id (0
  // for finally's catch-all sentinel).
  sema_catch_class_id      : (ast.catch_clause) -> int   // -1 if unresolved
  sema_catch_cp_classref   : (ast.catch_clause) -> int   // 0 if no CP entry
  sema_catch_slot          : (ast.catch_clause) -> int
  sema_throwable_class_id  : ()                  -> int

  // ── THE SIDECAR ────────────────────────────────────────────────────────
  // Each of these appends ONE ROW to ctx->facts_ — a single per-method
  // bbq_vec(compiler_fact_t). There is one row type, one accumulator and one
  // getter (compiler_get_facts); these AUXes are just its typed constructors, so
  // a guard cannot be recorded with a scope's payload by mistake. See the PAYLOAD
  // TABLE in compiler.h.
  //
  // WE ARE THE STAGE THAT KNOWS. Every one of these facts is something the DDCG
  // has in hand at the instant it builds the node — which branch is a guard and
  // what it tests, which site sits in a loop, where a scope ends, which handlers
  // enclose a throw. RECORD IT HERE. The optimizer must never recover it by
  // walking the SIR: that is a second authority for a fact the frontend owns, and
  // spec §8 ("Why there is no dominator tree") forbids it outright.
  //
  // ADDING A FACT: one enum value in compiler.h, one row in its payload table,
  // one 4-line constructor in compiler_helpers.c, one decl here. No new struct,
  // no new accumulator, no new getter. If it ever costs more than that, FIX THAT
  // — do not go around it.

  // (try body's start Nop, the ExceptionEntry handler, catch class id | -1 all,
  // the try's REGION ID). Codegen reads the per-method rows to populate
  // exception_table[]; the escape lattice joins the region id against the
  // THROW_REGION rows to answer "is this throw caught in this method".
  record_try_region        : (ir_root, ir_root, int, int) -> int

  // A fresh region id, unique within the method. Allocated BEFORE the try's body is
  // compiled, so the Throws inside it can name the region whose handlers do not exist
  // yet (see the rho comment). Monotonic, resets per method, like ddcg_alloc_temp.
  next_region_id           : () -> int

  // (an EXCEPTING node, the id of ONE region enclosing it). Called once per enclosing
  // region, innermost first — record_except_regions walks ρ and emits the rows.
  //
  // An EXCEPTING node is one the JLS specifies can throw: a `throw` (§11.1 cause 2), a
  // CALL (the callee's exceptions propagate; StackOverflowError at the invocation), and
  // an ALLOCATION (§11.1: *"some limitation on a resource is exceeded, such as using too
  // much memory"* — OutOfMemoryError is specified AT the `new`). §11.1 also BOUNDS the
  // set: these are *"not thrown at an arbitrary point … but at a point where they are
  // specified as a possible result"*, and §11.3.2 confines the any-point (asynchronous)
  // cases to Thread.stop (moot — Java 1.0 minus threads) and InternalError, expressly
  // permitting a code generator to defer them to control transfers. So: throws, calls,
  // allocations. NOT every node, and NOT "whatever this VM traps on" — the SIR is the
  // JAVA side; WASM is one runtime.
  //
  // WHY: JLS §11.3.1, exceptions are PRECISE — *"all effects of the statements executed
  // and expressions evaluated before the point from which the exception is thrown must
  // appear to have taken place"*. So a handler MERGES the state at every excepting point
  // of its region (spec §1). WE know those points — we mint them; the optimizer must
  // never classify nodes after the fact.
  record_except            : (ir_root, int) -> int

  // (a region id, its OUTERMOST TryRegion node). Called by the try rule when it closes
  // its chain — the moment the handlers finally exist. Stamps `exc` (the exception
  // continuation, spec §1) onto every node recorded excepting under this region id,
  // FIRST WRITE WINS: an inner try closes before its enclosing one (rules evaluate
  // inside-out), so the surviving stamp is the INNERMOST region — outer regions are
  // reached via the catch-all's rethrow, which carries its own row. Walks the fact
  // rows, never the graph.
  patch_excepts            : (int, ir_root) -> int

  // (header, exit, kind). Loops: (Ltop, Lbreak, 1); ifs: (test, Ljoin, 0). The
  // WASM structured emit frames block/loop from these; the optimizer reads the
  // LOOP headers to widen on the back edge (spec §5 — read the scope, never
  // rediscover the loop).
  record_scope             : (ir_root, ir_root, int) -> int

  // (the guard's Branch, kind, subject slot, aux slot, throw-on-true). The DDCG
  // emits a guard at every operation the JLS says can throw, naively and
  // completely; PRUNING the ones that provably cannot fire is the optimizer's job
  // — it reads these rather than rediscovering them by matching on the lowering's
  // shape, which rots the moment a lowering changes. Slots, not node pointers:
  // the optimizer rewrites expression trees.
  record_guard             : (ir_root, int, int, int, int) -> int

  // (the New/NewArray/NewRefArray node, 1 if it sits inside a loop). Obj naming
  // is 1-LIMITED — one abstract object per SITE — so a looping site is a SUMMARY
  // of every object it ever makes and must NOT be strongly updated (VFG Rule 3: a
  // strong update needs ONE concrete object). We know; we are lowering the loop.
  record_alloc             : (ir_root, int) -> int

  // (the Invoke node, the class that DECLARES the target, its method index there). We pick the
  // §15.12 dispatch form here, so we know the pair burg emits the funcidx from when it realizes
  // the deferred jump. The backend reads these rather than re-deriving the call set.
  record_call_target       : (ir_root, int, int) -> int

  // The same, reading the pair off the node: a no-op unless the node is an Invoke*. This is
  // what record_except_regions calls, so every call the frontend builds is recorded at one
  // point rather than at each construction site.
  record_call_target_of    : (ir_root) -> int

  // Magic-named AUX recognised by ddcgc: if declared, every
  // dispatcher's returned spine head passes through this hook
  // before the dispatcher returns. yoctojc uses it to stamp the
  // current AST node's source location onto the SIR spine head, so
  // downstream codegen can emit the per-method line table from
  // SIR node->loc.
  on_dispatch_result       : (ir_root) -> ir_root

  // AST sub-field projectors. Plain field access on a typed AST
  // node — would go away with `as`-patterns at the DSL level.
  field_acc_obj            : (ast.expr) -> ast.expr
  array_acc_arr            : (ast.expr) -> ast.expr
  array_acc_index          : (ast.expr) -> ast.expr

PREDICATES
  // JLS §10.6: an array initializer whose element type is PRIMITIVE and whose every element
  // is a §15.27 constant expression. Its contents are known now, so the array is built by one
  // array.new_data out of the constant-data pool instead of an allocation plus a store per
  // element — which is what every string literal became once §3.10.5 interning desugared it
  // to `new String(new char[]{...})`.
  arrayinit_is_const       : (ast.expr) -> bool

  // JLS §15.18.1: a `+` whose sema result type is String — string concatenation
  // (guards the string_concat rule; falls through to the numeric binary rules).
  sema_binary_is_concat    : (ast.expr) -> bool

  // JLS §15.16.2: an integer / or % — routes through the divisor-zero guard
  // (excluded from the plain arithmetic rules; steers the guarded rule).
  is_guarded_intdiv        : (ast.expr) -> bool

  // JLS §20.18.16: a resolved System.arraycopy(src,·,dst,·,·) with a CONCRETE array
  // src — lowered to a `SIR_ARRAYCOPY` (array.copy) intrinsic (excluded from the plain
  // method_call rule; steers the arraycopy_intrinsic rule).
  sema_is_arraycopy        : (ast.expr) -> bool
  // A resolved java.lang.Float/Double raw bit-accessor call (a bit-preserving Move node) —
  // steers the move_intrinsic rule; excluded from the plain method_call rule.
  sema_is_move_intrinsic   : (ast.expr) -> bool
  // A resolved Math.sqrt/floor/ceil/rint call (an f64-opcode intrinsic) — steers the math_intrinsic
  // rule; excluded from the plain method_call rule.
  sema_is_math_intrinsic   : (ast.expr) -> bool
  // A resolved javelina.simd intrinsic call (a v128 SIMD node) — steers simd_intrinsic;
  // excluded from the plain method_call rule.
  sema_is_simd_intrinsic   : (ast.expr) -> bool
  // A resolved Class newInstance helper (instantiable/construct) — steers class_intrinsic; excluded
  // from the plain method_call rule.
  sema_is_class_intrinsic  : (ast.expr) -> bool

  // SEMA_IDENT_* dispatch as where-guards. The four ident kinds are
  // mutually exclusive; rules with these guards cover all positive
  // resolutions — anything sema didn't resolve falls through to the
  // catch-all rule.
  ident_is_local_or_param  : (ast.expr) -> bool
  ident_is_instance_field  : (ast.expr) -> bool
  ident_is_static_field    : (ast.expr) -> bool

  // FieldAccess sub-form classifiers — Array.length is an
  // intrinsic distinct from get_field; static vs instance picks
  // between GetStatic and GetField. Mutually disjoint within a
  // FieldAccess match family.
  fieldacc_is_array_length : (ast.expr) -> bool
  fieldacc_is_static       : (ast.expr) -> bool

  // Assignment-target shape predicates. Used as where-guards to
  // dispatch the assign / compound_assign rules per target form.
  // (BBQ feature gap: with `as`-patterns these would collapse into
  // nested ConstructorPats with bindings; for now the rule head
  // binds the whole target and a guard filters by shape.)
  target_is_ident          : (ast.expr) -> bool
  target_is_static_field   : (ast.expr) -> bool
  target_is_instance_field : (ast.expr) -> bool
  target_is_array_access   : (ast.expr) -> bool
  target_is_super_access   : (ast.expr) -> bool

  // Dybvig §3.2 Figure 8 "simple expression" classifier — drives the
  // four-case binop fanout. Simple = side-effect-free leaf where
  // JLS §15.7.1 left-first capture is trivially observed: literals,
  // `this`, local/param ident, and `-literal`. Anything else is
  // complex and falls to the spill-via-temp path.
  is_simple_operand        : (ast.expr) -> bool

  // Tighter classifier for Figure 8 case 2 (LHS simple, RHS complex):
  // a complex RHS may have side effects that mutate the slot a simple
  // LHS reads (e.g. `x + (x = 5)` — JLS §15.7.1 demands the LHS read
  // happens before the RHS assignment). Inlining an Ident LHS would
  // defer the slot read until after RHS runs, producing the wrong
  // value. Restrict case 2's LHS to side-effect-immutable shapes —
  // literals, `this`, and `-literal`. Ident LHS falls to case 4.
  is_constant_operand      : (ast.expr) -> bool

MEMBERS (.
    bbq_arena*        arena;
    const sema_ctx_t* sema;
    // ddcgc-emitted dispatchers unconditionally set ctx->current_loc.
    ast_srcloc        current_loc;
    // Per-method state. Set per method-walk in compiler_ddcg.c.
    int               current_return_dt_;
    // The return TYPE's ref descriptor (ir.ClassRef/ArrayRef), or NULL for a primitive/void return —
    // types a `return null` spill temp (the null carries no descriptor). Opaque void* like facts_.
    void*             current_return_ref_;
    int               current_class_id_;
    // Monotonic temp-slot allocator; resets per method. Initial value
    // is sema_max_user_slots(method) so temps don't overlap user locals.
    int               next_temp_;
    // Monotonic try-REGION id allocator; resets per method. A region id names one try
    // statement, is stamped on ρ before its body is compiled, and is stamped again on
    // each of its handler rows when the catch chain is built — the two join on it.
    int               next_region_;
    // THE SIDECAR — the per-method fact accumulator, and the ONLY one. Every
    // record_* AUX appends a compiler_fact_t row to it; the AUX bodies in
    // compiler_helpers.c know it is a `bbq_vec(compiler_fact_t)` and cast, and
    // compiler.c casts again when copying out to ctx->all_facts[]. Opaque from the
    // DSL's view, so this preamble needs only compiler_runtime.h, not compiler.h —
    // symmetric with every other type the DSL touches.
    void*             facts_;
    // THE CONSTANT-DATA POOL — per MODULE, not per method, so unlike facts_ it is not reset
    // between method walks: it is `&compiler_ctx_t.const_data`, handed in once and appended
    // to by const_data_offset. Opaque here for the same reason facts_ is; the AUX body in
    // compiler_helpers.c is the one place that knows it is a bbq_vec of bytes.
    void*             const_data_;
    // The pool's content index (`&compiler_ctx_t.const_data_index`), handed in beside the pool
    // it indexes. Opaque here for the same reason const_data_ is.
    void*             const_data_index_;
.)

// IntLit is an anchor rule — one per sum, so ddcgc emits both
// ddcg_compile_expr and ddcg_compile_stmt (a sum with no rules gets
// no generated dispatcher).

// Deliver a pure value tree to (δ, γ) — Dybvig §3.2 cg_store.
// Caller asserts `value` has no side effects; cg_store walks the
// (δ × γ) Cartesian to emit the right destination operation. The
// destination's own dt (carried by the `loc` variant) drives stores.
fun cg_store(value: ir_root,
             delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    match (gamma) {
      // γ=ret terminates the method. The value tree is the return
      // expression's result; δ is irrelevant. Use the method's
      // declared return dt (not the value's inferred dt) so BURS
      // selects the right typed return opcode (JLS §14.17). Void
      // returns never reach cg_store — the Return rule emits
      // ReturnVoid directly.
        ret => build ir.Return(value, current_return_dt())
      | pair(Lt, Lf) => match (delta) {
                            effect       => build ir.Branch(value,
                                              ddcg_label(Lt),
                                              ddcg_label(Lf))
                          | loc(slot, dt: d) => build ir.StoreLocal(slot, d, nil,
                                              value,
                                              build ir.Branch(
                                                build ir.LoadLocal(slot, d, nil),
                                                ddcg_label(Lt),
                                                ddcg_label(Lf)))
                          | locref(slot, ref: r) => build ir.StoreLocal(slot, DtRef, r,
                                              value,
                                              build ir.Branch(
                                                build ir.LoadLocal(slot, DtRef, r),
                                                ddcg_label(Lt),
                                                ddcg_label(Lf)))
                        }
      | single(L) => match (delta) {
                         effect       => L
                       | loc(slot, dt: d) => build ir.StoreLocal(slot, d, nil, value, L)
                       | locref(slot, ref: r) => build ir.StoreLocal(slot, DtRef, r, value, L)
                     }
    };
}

// Contextual datatype of a delivered value — the type it is used
// as, i.e. the destination's type. Drives LoadConst's data_type so
// a literal lands in the BURS nonterminal its use demands (γ=ret →
// the method return type; loc → the slot's type; effect → short,
// since the value is either discarded or a boolean branch test).
fun dest_dt(delta: delta, gamma: gamma) -> ir.datatype {
    match (gamma) {
        ret    => current_return_dt()
      | _other => match (delta) {
                      loc(slot: _, dt: d) => d
                    | locref(slot: _, ref: _) => DtRef
                    | effect              => DtInt   // value discarded — natural WASM width
                  }
    };
}

// A value DESTINATION for a slot (§3.2: the data destination determines where the
// value lands). In our typed target the destination must carry the value's TYPE:
// a reference slot needs `locref` with the referent so it types as (ref X) — a bare
// `loc` would leave it at the (ref null Object) default and a later store/use into a
// typed field/array/arg would be rejected. `ref` is the TARGET's referent descriptor
// (nil for a primitive, by the expr_ref/array_elem_ref/sema_ident_ref convention);
// for a primitive target this degrades to a plain typed `loc`.
fun vloc(slot: int, dt: ir.datatype, ref: ir_root) -> delta {
    match (dt) {
        DtRef  => locref(slot, ref)
      | _other => loc(slot, dt)
    };
}

// Per-op SIR ctor for arith/bitwise/comparison binops. Cmp emits a
// value-tree that delivers to γ via cg_store; cg_store wraps it in
// Branch when γ is pair (Dybvig §0.2 Figure 8 — "<" in test context).
// Short-circuit And/Or aren't here — they have their own γ-aware
// emit path (binary_logical).
//
// `dt` is the result datatype, populated by ddcg from sema's known
// type. For arithmetic/bitwise it equals both operand dts (sema
// inserts S2I/I2S to ensure operand widths match). For Cmp the
// result is always boolean → DtShort; the dt argument is ignored
// for Cmp arms.
// §15.17.3: `%` on float/double is the TRUNCATED remainder (C fmod — sign of the
// dividend, NaN on a zero/infinite divisor), and WASM has no f32.rem/f64.rem opcode.
// Desugar it to a call to Math's fdlibm fmod, the same way `+` on Strings desugars to
// StringBuffer calls. Integral `%` keeps its Rem node (and its §15.16.2 divisor guard).
fun frem_call(dt: ir.datatype, lhs: ir_root, rhs: ir_root, r: rho) -> ir_root {
    let args: list<ir_root> = [lhs, rhs];
    let call = build ir.InvokeStatic(sema_frem_class(), sema_frem_method(dt), args, dt);
    let _    = record_except_regions(call, r);   // a CALL — the callee can throw (§11.1)
    call;
}

fun binop_op_node(op: ast.binop, dt: ir.datatype,
                  lhs: ir_root, rhs: ir_root, r: rho) -> ir_root {
    match (op) {
        Add    => build ir.Add(dt, lhs, rhs)
      | Sub    => build ir.Sub(dt, lhs, rhs)
      | Mul    => build ir.Mul(dt, lhs, rhs)
      | Div    => build ir.Div(dt, lhs, rhs)
      | Rem    => (dt == DtFloat or dt == DtDouble)
                    ? frem_call(dt, lhs, rhs, r)
                    : build ir.Rem(dt, lhs, rhs)
      | Shl    => build ir.Shl(dt, lhs, rhs)
      | Shr    => build ir.Shr(dt, lhs, rhs)
      | Ushr   => build ir.Ushr(dt, lhs, rhs)
      | BitAnd => build ir.And(dt, lhs, rhs)
      | BitOr  => build ir.Or(dt, lhs, rhs)
      | BitXor => build ir.Xor(dt, lhs, rhs)
      | Eq     => build ir.Eq(lhs, rhs)
      | Ne     => build ir.Ne(lhs, rhs)
      | Lt     => build ir.Lt(lhs, rhs)
      | Gt     => build ir.Gt(lhs, rhs)
      | Le     => build ir.Le(lhs, rhs)
      | Ge     => build ir.Ge(lhs, rhs)
      | _other => panic_unreachable("binop_op_node: And/Or use binary_logical")
    };
}

// JLS §5.6 numeric promotion. binop_ct is the computation type both operands
// convert to: shifts use §5.6.1 unary promotion of the LEFT operand (the result
// type; WASM also requires the shift count at that width); every other binop
// uses §5.6.2 binary promotion of the two operand types. cg_promote wraps an
// already-built operand subtree in the widening/narrowing conversion to `to`
// (the lattice's lat_num_conv decides which — never re-decided here); identity
// and ref operands pass through unwrapped.
fun binop_ct(op: ast.binop, lhs_dt: ir.datatype, rhs_dt: ir.datatype) -> ir.datatype {
    match (op) {
        Shl    => dt_unary(lhs_dt)
      | Shr    => dt_unary(lhs_dt)
      | Ushr   => dt_unary(lhs_dt)
      | _other => dt_promote(lhs_dt, rhs_dt)
    };
}

fun cg_promote(t: ir_root, from: ir.datatype, to: ir.datatype) -> ir_root {
    match (num_conv(from, to)) {
        CastI2L => build ir.I2L(t)
      | CastI2F => build ir.I2F(t)
      | CastI2D => build ir.I2D(t)
      | CastL2F => build ir.L2F(t)
      | CastL2D => build ir.L2D(t)
      | CastF2D => build ir.F2D(t)
      | CastL2I => build ir.L2I(t)
      | CastF2I => build ir.F2I(t)
      | CastD2I => build ir.D2I(t)
      | _other  => t
    };
}

// Build the SIR leaf tree for a Dybvig-simple operand. Called only
// when is_simple_operand has classified `e` as simple; non-simple
// inputs panic to surface miscoordination between the predicate and
// this constructor.
fun cg_operand_tree(e: ast.expr, op_dt: ir.datatype) -> ir_root {
    match (e) {
        ast.IntLit(value: v)  => build ir.LoadConst(v, op_dt)
      | ast.BoolLit(value: v) => build ir.LoadConst(v ? 1 : 0, op_dt)
      | ast.CharLit(value: v) => build ir.LoadConst(v, op_dt)
      | ast.LongLit(value: v)   => build ir.LoadLongConst(v)
      | ast.FloatLit(value: v)  => build ir.LoadFloatConst(v)
      | ast.DoubleLit(value: v) => build ir.LoadDoubleConst(v)
      | ast.NullLit()         => build ir.LoadNull()
      | ast.This()            => build ir.LoadThis(DtRef, current_class_id())
      | ast.Ident()           => build ir.LoadLocal(sema_ident_slot(e),
                                                    sema_ident_dt(e), sema_ident_ref(e))
      | ast.Unary(op: Neg, e: inner) => match (inner) {
            ast.IntLit(value: v) => build ir.LoadConst(0 - v, op_dt)
          | _o                   => panic_unreachable(
                                       "cg_operand_tree: Neg on non-IntLit")
        }
      | _other                => panic_unreachable("cg_operand_tree: non-simple operand")
    };
}

// Spill path implementing JLS §15.7.1: capture LHS into t_lhs
// BEFORE evaluating RHS, so the binop reads pre-RHS LHS even when
// RHS modifies a variable LHS depends on (e.g. `(i=3) * i` must
// yield 9). RHS then spills to t_rhs, and the binop pulls both temps.
fun binop_spilled(op: ast.binop, l: ast.expr, r: ast.expr,
                   lhs_dt: ir.datatype, rhs_dt: ir.datatype,
                   rho: rho,
                   delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    let t_lhs = ddcg_alloc_temp(lhs_dt);
    let t_rhs = ddcg_alloc_temp(rhs_dt);
    let ct    = binop_ct(op, lhs_dt, rhs_dt);
    let binop_head = cg_store(
        binop_op_node(op, ct,
                       cg_promote(build ir.LoadLocal(t_lhs, lhs_dt, expr_ref(l)), lhs_dt, ct),
                       cg_promote(build ir.LoadLocal(t_rhs, rhs_dt, expr_ref(r)), rhs_dt, ct),
                       rho),
        delta, gamma, Lnext);
    let rhs_chain = gen(r, rho, vloc(t_rhs, rhs_dt, expr_ref(r)),
                        single(binop_head), binop_head);
    gen(l, rho, vloc(t_lhs, lhs_dt, expr_ref(l)), single(rhs_chain), rhs_chain);
}

// Short-circuit And/Or in pair γ (test context) — JLS §15.23/15.24:
// `a && b` evaluates a; if a is false, b is NOT evaluated. Per
// Dybvig §0.2 Figure 7, recurse RHS first in the parent's full
// pair, then recurse LHS with a composite γ that propagates the
// branch outcome. The trivial arm (the early-out side) just points
// at the parent's Lt or Lf directly — the spine pointer IS the jump.
fun shortcircuit_pair(op: ast.binop, l: ast.expr, r: ast.expr,
                       Lt: ir_root, Lf: ir_root,
                       rho: rho, Lnext: ir_root) -> ir_root {
    let rhs_head = gen(r, rho, effect, pair(Lt, Lf), Lnext);
    let lhs_gamma = match (op) {
        And    => pair(rhs_head, Lf)
      | _other => pair(Lt, rhs_head)
    };
    let head = gen(l, rho, effect, lhs_gamma, Lnext);
    // Fig. 7: every term of the chain jumps to the one shared exit (&&: Lf | ||: Lt).
    // Record it as a MERGE label (docs/ddcg-merge-labels.md §2.1) keyed by the chain
    // head, so the structurer emits it ONCE and each term br's to it — not re-emitted
    // inline per term (which nests exponentially through an if-else-if chain). In
    // loop-condition position the shared exit is ALREADY a framed loop scope, so the
    // branch resolves it by br-depth and the record is inert.
    let shared = match (op) { And => Lf | _other => Lt };
    let _ = record_scope(head, shared, 3);
    head;
}

// Short-circuit And/Or in value/effect γ — JLS §15.23/15.24
// produce 1 or 0. Inline the pre-DDCG normalization
// `Ebool ⇒ if Ebool 1 0`: synthesize labeled true_arm / false_arm
// stores (each delivers the const to δ then jumps to γ), then
// propagate Dybvig §0.2 Figure 7 via a fresh merge-point label.
fun shortcircuit_value(op: ast.binop, l: ast.expr, r: ast.expr,
                        rho: rho, delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    let bdt       = dest_dt(delta, gamma);
    let true_arm  = cg_store(build ir.LoadConst(1, bdt), delta, gamma, Lnext);
    let Lt        = ddcg_label(true_arm);
    let false_arm = cg_store(build ir.LoadConst(0, bdt), delta, gamma, Lnext);
    let Lf        = ddcg_label(false_arm);
    let E2_head   = gen(r, rho, effect, pair(Lt, Lf), Lnext);
    let Lmid      = ddcg_label(E2_head);
    let lhs_gamma = match (op) {
        And    => pair(Lmid, Lf)
      | _other => pair(Lt, Lmid)
    };
    let head = gen(l, rho, effect, lhs_gamma, Lmid);
    // Two shared labels (§2.1): the condition exit (&&: Lf | ||: Lt), referenced by
    // both lhs and rhs (Fig. 7); and — for a single-label γ — the value merge L the
    // 1/0 stores (true_arm/false_arm) both continue to. Records are inner-first, so
    // record the condition exit (inner) before the value merge (outer — it's later in
    // the stream, after the stores).
    let shared = match (op) { And => Lf | _other => Lt };
    let _ = record_scope(head, shared, 3);
    let _ = match (gamma) { single(L) => record_scope(head, L, 3) | _other => 0 };
    head;
}

fun binary_logical(op: ast.binop, l: ast.expr, r: ast.expr,
                    rho: rho, delta: delta, gamma: gamma,
                    Lnext: ir_root) -> ir_root {
    match (gamma) {
        pair(Lt, Lf) => shortcircuit_pair(op, l, r, Lt, Lf, rho, Lnext)
      | _other       => shortcircuit_value(op, l, r, rho, delta, gamma, Lnext)
    };
}

// Unconditional control transfer with no value — Dybvig §3.2 cg_jump,
// translated to the IR layer. Dybvig's third case ("emit jbr L") is
// "set the spine pointer to L" in CPS-IR — no node needed, because
// the pointer IS the jump. So single(L) always returns L. The only
// real IR node produced is ReturnVoid for the ret case (a terminator
// with no .next, distinct from fall-through). pair γ is a caller error
// (no value to test); fail-safe back to Lnext keeps the spine valid.
fun cg_jump(gamma: gamma, Lnext: ir_root) -> ir_root {
    match (gamma) {
        ret        => build ir.ReturnVoid()
      | single(L)  => L
      | pair(Lt, Lf) => Lnext
    };
}

// Reverse-chain build for stmt sequences (Dybvig §0.2 Figure 5).
// Last stmt inherits parent (δ, γ); each prior stmt runs in effect
// context with γ=single(head_of_tail). Recurses on idx; depth is
// bounded by the number of stmts in the block.
fun chain_block_stmts(stmts: list<ast.stmt>, idx: int, last: int,
                       rho: rho, delta: delta, gamma: gamma,
                       Lnext: ir_root) -> ir_root {
    idx == last
      ? gen(stmts[idx], rho, delta, gamma, Lnext)
      : { let tail = chain_block_stmts(stmts, idx + 1, last,
                                        rho, delta, gamma, Lnext);
          gen(stmts[idx], rho, effect, single(tail), tail); };
}

// LocalVarDecl chain — initialize each declarator with an init in
// textual order (JLS §14.4). Skip declarators without init (locals
// have no default value per JLS §14.4.2 — they must be definitely
// assigned before any read). The LAST init-bearing declarator
// inherits parent (δ, γ); priors chain in effect / single(next).
fun chain_decls(decls: list<ast.var_decl>, idx: int, last_init: int,
                 var_dt: ir.datatype,
                 rho: rho, delta: delta, gamma: gamma,
                 Lnext: ir_root) -> ir_root {
    // §10.2: the datatype is PER DECLARATOR, not per declaration. `int i = 0, v[] = ...`
    // declares an int and an int[] off one IntType node, so deriving the slot's datatype
    // from that shared node types the array slot as an int and the store fails validation.
    // sema already resolved each declarator (dims included) and sema_var_ref is nil exactly
    // for a primitive local, so it IS the predicate — no second derivation.
    let dt = sema_var_ref(decls[idx]) == nil ? var_dt : DtRef;
    idx > last_init
      ? cg_jump(gamma, Lnext)
      : (decls[idx].init == nil
          ? chain_decls(decls, idx + 1, last_init, var_dt,
                         rho, delta, gamma, Lnext)
          : (idx == last_init
              ? cg_deliver_conv(decls[idx].init, dt, rho,
                    vloc(sema_var_slot(decls[idx]), dt,
                        expr_ref(decls[idx].init) == nil ? sema_var_ref(decls[idx]) : expr_ref(decls[idx].init)),
                    gamma, Lnext)
              : { let tail = chain_decls(decls, idx + 1, last_init, var_dt,
                                          rho, delta, gamma, Lnext);
                  cg_deliver_conv(decls[idx].init, dt, rho,
                      vloc(sema_var_slot(decls[idx]), dt,
                        expr_ref(decls[idx].init) == nil ? sema_var_ref(decls[idx]) : expr_ref(decls[idx].init)),
                      single(tail), tail); }));
}

// Find the index of the last declarator that has an initializer.
// Returns -1 if none — caller emits cg_jump in that case.
fun last_init_index(decls: list<ast.var_decl>) -> int {
    let last = 0 - 1;
    for (i, d) in decls {
        if d.init != nil {
            last := i;
        }
    }
    last;
}

// Deliver a value tree that may have side effects (NPE check, class
// init, allocation, etc.). For DST_EFFECT + CTRL_SINGLE the value
// must be evaluated even though it's discarded — wrap in ExprEffect
// so BURS evaluates the tree (running the side effect) and pops the
// value. Other (δ, γ) shapes route through cg_store, which evaluates
// the tree as part of building the spine.
fun cg_deliver_effectful(value: ir_root,
                          delta: delta, gamma: gamma,
                          Lnext: ir_root) -> ir_root {
    match (gamma) {
        single(L) => match (delta) {
                         effect       => build ir.ExprEffect(value, 0, L)
                       | loc(slot, dt: d) => cg_store(value, delta, gamma, Lnext)
                       | locref(slot, ref: r) => cg_store(value, delta, gamma, Lnext)
                     }
      | pair(Lt, Lf) => cg_store(value, delta, gamma, Lnext)
      | ret          => cg_store(value, delta, gamma, Lnext)
    };
}

// SEMA_IDENT_STATIC_FIELD case — JLS §15.28 inlines static-final
// primitives whose initializer is a constant expression. sema does
// the JLS check; we just consume the (inlinable, value) result.
fun ident_static_field(node: ast.expr, rho: rho,
                        delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    let (folded, k) = fold_const_expr(node);
    folded
      ? cg_deliver_effectful(k, delta, gamma, Lnext)   // §13.1: the use IS the value
      : init_barrier(current_class_id(), cg_deliver_effectful(   // §12.4.1: unqualified static read inits its class
          build ir.GetStatic(sema_ident_dt(node),
                             current_class_id(),
                             sema_field_index(node)),
          delta, gamma, Lnext), rho);
}

// Per-op SIR ctor for non-mutating unary operators (Neg / BitNot /
// LogNot). Pre/Post Inc/Dec are handled in `unary`'s match arms via
// incdec_emit — they never reach this fun.
//
// `dt` is the result datatype; for unary ops the result matches the
// operand width (no implicit widening at the SIR level).
fun unary_op_node(op: ast.unop, dt: ir.datatype, operand: ir_root) -> ir_root {
    match (op) {
        Neg    => build ir.Neg(dt, operand)
      | BitNot => build ir.Xor(dt, operand, neg_one_const(dt))
      | LogNot => build ir.LogNot(dt, operand)
      | _other => panic_unreachable("unary_op_node: unexpected op")
    };
}

// Fast/spill emit for a non-Pos unary op on its operand.
fun unary_emit(op: ast.unop, inner: ast.expr, op_dt: ir.datatype,
                rho: rho, delta: delta, gamma: gamma,
                Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(op_dt);
    let head = cg_store(unary_op_node(op, op_dt,
                          build ir.LoadLocal(t, op_dt, nil)),
                        delta, gamma, Lnext);
    gen(inner, rho, loc(t, op_dt), single(head), head);
}

// Non-Pos unary path with constant + cancellation folds applied
// before the simple/spill emit path. Cancellation only fires for
// Neg-Neg / LogNot-LogNot per legacy (BitNot excluded for byte-
// precision intermediates).
// Forward-iterate update chain build for For-loops. Each update
// except the last falls through to the next; the last emits an
// explicit Goto(Ltop) (Lnext=nil triggers cg_jump's Goto path).
fun chain_for_updates(updates: list<ast.expr>, idx: int, last: int,
                       Ltop: ir_root, rho: rho) -> ir_root {
    idx == last
      ? gen(updates[idx], rho, effect, single(Ltop), nil)
      : { let tail = chain_for_updates(updates, idx + 1, last, Ltop, rho);
          gen(updates[idx], rho, effect, single(tail), tail); };
}

fun unary_op(op: ast.unop, inner: ast.expr,
              rho: rho, delta: delta, gamma: gamma,
              Lnext: ir_root) -> ir_root {
    let dt = sema_data_type_or(inner, DtInt);
    // Dybvig Figure 7: `!E` in predicate position needs no materialized
    // boolean — swap the true/false control destinations and recurse on E.
    // Zero instructions: no temp, no LogNot, no branch on a computed bit.
    // It composes through &&/|| (each ! just swaps its sub-destinations) and
    // double-cancels !! (two swaps restore the original pair). Only in
    // predicate position (γ=pair) with the value not otherwise wanted
    // (δ=effect); elsewhere the boolean is the result → spill-emit it.
    match (op) {
        LogNot => match (gamma) {
                      pair(Lt, Lf) => match (delta) {
                                          effect => gen(inner, rho, effect, pair(Lf, Lt), Lnext)
                                        | _dloc  => unary_emit(op, inner, dt, rho, delta, gamma, Lnext)
                                      }
                    | _gother => unary_emit(op, inner, dt, rho, delta, gamma, Lnext)
                  }
      | _other => unary_emit(op, inner, dt, rho, delta, gamma, Lnext)
    };
}

// Pre/Post Inc/Dec helpers — JLS §15.14, §15.15. The target's shape
// drives the lowering: locals/params use SIR_INC; fields/arrays read
// the old value, add the delta, and write back. Pre delivers the new
// value; post delivers the old.

// True iff (δ, γ) is "no value needed" — δ=effect AND γ ∈ {single, ret}.
// In that case, both pre and post collapse to a single Inc with the
// γ-jump as its tail (no temp save, no delivery store).
fun incdec_value_dropped(delta: delta, gamma: gamma) -> bool {
    match (delta) {
        effect => match (gamma) {
                      pair(Lt: _, Lf: _) => false
                    | _other             => true
                  }
      | _other => false
    };
}

// Pre on local: inc-and-deliver (deliver reads the *new* slot value).
fun pre_local(slot: int, dt: ir.datatype, step: int,
               delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    incdec_value_dropped(delta, gamma)
      ? build ir.Inc(slot, step, dt,
                     build ir.LoadLocal(slot, dt, nil),
                     cg_jump(gamma, Lnext))
      : { let delivery = cg_store(build ir.LoadLocal(slot, dt, nil),
                                   delta, gamma, Lnext);
          build ir.Inc(slot, step, dt,
                       build ir.LoadLocal(slot, dt, nil),
                       delivery); };
}

// Post on local: save old value, inc, deliver from old-temp.
fun post_local(slot: int, dt: ir.datatype, step: int,
                delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    incdec_value_dropped(delta, gamma)
      ? build ir.Inc(slot, step, dt,
                     build ir.LoadLocal(slot, dt, nil),
                     cg_jump(gamma, Lnext))
      : { let t_old    = ddcg_alloc_temp(dt);
          let delivery = cg_store(build ir.LoadLocal(t_old, dt, nil),
                                   delta, gamma, Lnext);
          let inc      = build ir.Inc(slot, step, dt,
                                       build ir.LoadLocal(slot, dt, nil),
                                       delivery);
          build ir.StoreLocal(t_old, dt, nil,
                              build ir.LoadLocal(slot, dt, nil), inc); };
}

// Generic delivery for already-evaluated values (the side effect
// already happened — typically a writeback). δ=effect + γ=single is
// the "no value needed; just keep the spine going" case — emit a
// γ-jump directly without re-evaluating value. Every other shape
// routes through cg_store, which consumes value as a sub-tree.
//
// Used by field/array assigns, pre/post inc/dec writebacks, and
// compound assigns: the writeback's side effect IS the put-* opcode
// in the spine, so the delivered value is just a load (or a freshly-
// computed op_tree) — no need to wrap in ExprEffect.
fun cg_deliver_loaded(value: ir_root,
                      delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    match (delta) {
        effect => match (gamma) {
                      single(L) => L
                    | _other    => cg_store(value, delta, gamma, Lnext)
                  }
      | _other => cg_store(value, delta, gamma, Lnext)
    };
}

// Pre on instance/static field via unqualified Ident — receiver is
// implicit `this` (slot 0). Static path elides the receiver. Pre
// computes new_val = old + step, stashes to t_new, writes back, then
// delivers from t_new. Spine: store_new → writeback → delivery.
fun pre_ident_field(node: ast.expr, is_static: bool, dt: ir.datatype,
                     step: int, cls_id: int,
                     delta: delta, gamma: gamma,
                     Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(node);
    let t_new    = ddcg_alloc_temp(dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_new, dt, nil), delta, gamma, Lnext);
    let old_load = is_static
      ? build ir.GetStatic(dt, cls_id, cp)
      : build ir.GetField(dt, build ir.LoadThis(DtRef, current_class_id()), sema_field_decl_class(node), cp);
    let new_val  = build ir.Add(dt, old_load, build ir.LoadConst(step, dt));
    let writeback = is_static
      ? build ir.PutStatic(dt, cls_id, cp,
                            build ir.LoadLocal(t_new, dt, nil), delivery)
      : build ir.PutField(dt, build ir.LoadThis(DtRef, current_class_id()), sema_field_decl_class(node), cp,
                           build ir.LoadLocal(t_new, dt, nil), delivery);
    build ir.StoreLocal(t_new, dt, nil,
                        is_static ? narrow_to_dt(dt, new_val) : new_val, writeback);
}

// Post on instance/static field via unqualified Ident. Saves old to
// t_old, computes new_val = t_old + step, writes back, delivers from
// t_old. Spine: store_old → writeback → delivery.
fun post_ident_field(node: ast.expr, is_static: bool, dt: ir.datatype,
                      step: int, cls_id: int,
                      delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(node);
    let t_old    = ddcg_alloc_temp(dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_old, dt, nil), delta, gamma, Lnext);
    let old_load = is_static
      ? build ir.GetStatic(dt, cls_id, cp)
      : build ir.GetField(dt, build ir.LoadThis(DtRef, current_class_id()), sema_field_decl_class(node), cp);
    let new_val  = build ir.Add(dt, build ir.LoadLocal(t_old, dt, nil),
                                 build ir.LoadConst(step, dt));
    let writeback = is_static
      ? build ir.PutStatic(dt, cls_id, cp, narrow_to_dt(dt, new_val), delivery)
      : build ir.PutField(dt, build ir.LoadThis(DtRef, current_class_id()), sema_field_decl_class(node), cp,
                           new_val, delivery);
    build ir.StoreLocal(t_old, dt, nil, old_load, writeback);
}

// Pre on `obj.field` (instance form). Spills obj to t_obj, computes
// new = old+step, stashes t_new, writes back, delivers from t_new.
fun pre_field_instance(obj: ast.expr, target: ast.expr, dt: ir.datatype,
                        step: int, cls_id: int,
                        rho: rho, delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(target);
    let t_new    = ddcg_alloc_temp(dt);
    let t_obj    = ddcg_alloc_temp(DtRef);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_new, dt, nil), delta, gamma, Lnext);
    let new_val  = build ir.Add(dt,
                     build ir.GetField(dt,
                       build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp),
                     build ir.LoadConst(step, dt));
    let writeback = build ir.PutField(dt,
                      build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp,
                      build ir.LoadLocal(t_new, dt, nil), delivery);
    let store_new = build ir.StoreLocal(t_new, dt, nil, new_val, writeback);
    let checked   = null_guard(t_obj, store_new, rho);   // §15.11: null.field++ → NPE
    gen(obj, rho, locref(t_obj, expr_ref(obj)), single(checked), checked);
}

// Pre on `Class.STATIC_FIELD` form. No obj spill.
fun pre_field_static(target: ast.expr, dt: ir.datatype, step: int,
                      cls_id: int, rho: rho,
                      delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(target);
    let t_new    = ddcg_alloc_temp(dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_new, dt, nil), delta, gamma, Lnext);
    let new_val   = build ir.Add(dt, build ir.GetStatic(dt, cls_id, cp),
                                  build ir.LoadConst(step, dt));
    let writeback = build ir.PutStatic(dt, cls_id, cp,
                                        build ir.LoadLocal(t_new, dt, nil),
                                        delivery);
    let r = build ir.StoreLocal(t_new, dt, nil, narrow_to_dt(dt, new_val), writeback);
    init_barrier(cls_id, r, rho);   // §12.4.1: ++static / --static is an active use
}

// Post on `obj.field`. Stashes OLD to t_old, computes new = t_old+step,
// writes back, delivers from t_old.
fun post_field_instance(obj: ast.expr, target: ast.expr, dt: ir.datatype,
                         step: int, cls_id: int,
                         rho: rho, delta: delta, gamma: gamma,
                         Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(target);
    let t_old    = ddcg_alloc_temp(dt);
    let t_obj    = ddcg_alloc_temp(DtRef);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_old, dt, nil), delta, gamma, Lnext);
    let new_val  = build ir.Add(dt, build ir.LoadLocal(t_old, dt, nil),
                                 build ir.LoadConst(step, dt));
    let writeback = build ir.PutField(dt,
                      build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp,
                      new_val, delivery);
    let store_old = build ir.StoreLocal(t_old, dt, nil,
                      build ir.GetField(dt,
                        build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp),
                      writeback);
    let checked = null_guard(t_obj, store_old, rho);     // §15.11: null.field-- → NPE
    gen(obj, rho, locref(t_obj, expr_ref(obj)), single(checked), checked);
}

fun post_field_static(target: ast.expr, dt: ir.datatype, step: int,
                       cls_id: int, rho: rho,
                       delta: delta, gamma: gamma,
                       Lnext: ir_root) -> ir_root {
    let cp       = sema_field_index(target);
    let t_old    = ddcg_alloc_temp(dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_old, dt, nil), delta, gamma, Lnext);
    let new_val   = build ir.Add(dt, build ir.LoadLocal(t_old, dt, nil),
                                  build ir.LoadConst(step, dt));
    let writeback = build ir.PutStatic(dt, cls_id, cp, narrow_to_dt(dt, new_val), delivery);
    let r = build ir.StoreLocal(t_old, dt, nil,
                        build ir.GetStatic(dt, cls_id, cp),
                        writeback);
    init_barrier(cls_id, r, rho);   // §12.4.1: static++ / static-- is an active use
}

// Pre on `arr[idx]`. Spills both, reads, increments, writes back.
fun pre_array_access(arr: ast.expr, idx: ast.expr, arr_dt: ir.datatype,
                      step: int,
                      rho: rho, delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    let t_a   = ddcg_alloc_temp(DtRef);
    let t_i   = ddcg_alloc_temp(DtInt);
    let t_new = ddcg_alloc_temp(arr_dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_new, arr_dt, nil), delta, gamma, Lnext);
    let astore = build ir.ArrayStore(arr_dt,
                    array_backing(t_a, array_elem_ref(arr), arr_dt),
                    build ir.LoadLocal(t_i, DtInt, nil),
                    build ir.LoadLocal(t_new, arr_dt, nil),
                    delivery, array_elem_ref(arr));
    let new_val = build ir.Add(arr_dt,
                    build ir.ArrayLoad(arr_dt,
                      array_backing(t_a, array_elem_ref(arr), arr_dt),
                      build ir.LoadLocal(t_i, DtInt, nil), array_elem_ref(arr)),
                    build ir.LoadConst(step, arr_dt));
    let store_new = build ir.StoreLocal(t_new, arr_dt, nil, new_val, astore);
    let i_chain   = gen(idx, rho, loc(t_i, DtInt),
                         single(store_new), store_new);
    gen(arr, rho, locref(t_a, expr_ref(arr)), single(i_chain), i_chain);
}

fun post_array_access(arr: ast.expr, idx: ast.expr, arr_dt: ir.datatype,
                       step: int,
                       rho: rho, delta: delta, gamma: gamma,
                       Lnext: ir_root) -> ir_root {
    let t_a   = ddcg_alloc_temp(DtRef);
    let t_i   = ddcg_alloc_temp(DtInt);
    let t_old = ddcg_alloc_temp(arr_dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_old, arr_dt, nil), delta, gamma, Lnext);
    let new_val = build ir.Add(arr_dt, build ir.LoadLocal(t_old, arr_dt, nil),
                                build ir.LoadConst(step, arr_dt));
    let astore = build ir.ArrayStore(arr_dt,
                    array_backing(t_a, array_elem_ref(arr), arr_dt),
                    build ir.LoadLocal(t_i, DtInt, nil),
                    new_val, delivery, array_elem_ref(arr));
    let store_old = build ir.StoreLocal(t_old, arr_dt, nil,
                      build ir.ArrayLoad(arr_dt,
                        array_backing(t_a, array_elem_ref(arr), arr_dt),
                        build ir.LoadLocal(t_i, DtInt, nil), array_elem_ref(arr)),
                      astore);
    let i_chain = gen(idx, rho, loc(t_i, DtInt),
                       single(store_old), store_old);
    gen(arr, rho, locref(t_a, expr_ref(arr)), single(i_chain), i_chain);
}

// Static-field assign: `Cls.f = v`. Fast path when v is simple — no
// temp allocated. Otherwise spill v to t_v and read it back inside
// PutStatic.
fun assign_static_field(target: ast.expr, value: ast.expr,
                         dt: ir.datatype, cls_id: int,
                         rho: rho, delta: delta, gamma: gamma,
                         Lnext: ir_root) -> ir_root {
    let cp        = sema_field_index(target);
    let t_v       = ddcg_alloc_temp(dt);
    let delivery  = cg_deliver_loaded(build ir.LoadLocal(t_v, dt, nil), delta, gamma, Lnext);
    let writeback = build ir.PutStatic(dt, cls_id, cp,
                                        build ir.LoadLocal(t_v, dt, nil),
                                        delivery);
    let result = cg_deliver_conv(value, dt, rho, vloc(t_v, dt, expr_ref(target)),
                    single(writeback), writeback);
    init_barrier(cls_id, result, rho);   // §12.4.1: assigning a static field initializes its class
}

// Instance-field assign: `obj.f = v`. Fast path when both obj and v
// are simple (no spill). Otherwise spill obj to t_obj and v to t_v.
fun assign_instance_field(obj: ast.expr, target: ast.expr, value: ast.expr,
                           dt: ir.datatype, cls_id: int,
                           rho: rho, delta: delta, gamma: gamma,
                           Lnext: ir_root) -> ir_root {
    let cp         = sema_field_index(target);
    let t_v       = ddcg_alloc_temp(dt);
    let t_obj     = ddcg_alloc_temp(DtRef);
    let delivery  = cg_deliver_loaded(build ir.LoadLocal(t_v, dt, nil), delta, gamma, Lnext);
    let writeback = build ir.PutField(dt,
                      build ir.LoadLocal(t_obj, DtRef, nil),
                      sema_field_decl_class(target), cp,
                      build ir.LoadLocal(t_v, dt, nil), delivery);
    let v_chain   = cg_deliver_conv(value, dt, rho, vloc(t_v, dt, expr_ref(target)),
                         single(writeback), writeback);
    let checked = null_guard(t_obj, v_chain, rho);   // §15.11: null.field = v → NPE (before value eval)
    gen(obj, rho, locref(t_obj, expr_ref(obj)), single(checked), checked);
}

// Array-element assign: `arr[idx] = v`. Always spills arr / idx / v
// to temps in JLS evaluation order (arr → idx → v).
fun assign_array(arr: ast.expr, idx: ast.expr, value: ast.expr,
                  arr_dt: ir.datatype,
                  rho: rho, delta: delta, gamma: gamma,
                  Lnext: ir_root) -> ir_root {
    let t_a   = ddcg_alloc_temp(DtRef);
    let t_i   = ddcg_alloc_temp(DtInt);
    let t_v   = ddcg_alloc_temp(arr_dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_v, arr_dt, nil), delta, gamma, Lnext);
    let astore   = build ir.ArrayStore(arr_dt,
                      array_backing(t_a, array_elem_ref(arr), arr_dt),
                      build ir.LoadLocal(t_i, DtInt, nil),
                      build ir.LoadLocal(t_v, arr_dt, nil),
                      delivery, array_elem_ref(arr));
    // §15.26.1 / §10.10 order: array ref (null-check), index, value, bounds-check, then
    // the ArrayStore check, then the store. The check applies only to a reference CLASS
    // (or interface) element — where the value is Object-representable and elementClass is
    // stamped; a nested/primitive-array element (int[][]) is the §10.8 array-Class case (later).
    let store_head = arr_dt == DtRef
        ? (array_elem_class(arr) >= 0 ? arraystore_guard(t_a, t_v, astore, rho) : astore)
        : astore;
    let bounds   = bounds_guard(t_a, t_i, array_elem_ref(arr), arr_dt, store_head, rho);
    let v_chain  = cg_deliver_conv(value, arr_dt, rho,
                        vloc(t_v, arr_dt, array_elem_ref(arr)),
                        single(bounds), bounds);
    let i_chain  = gen(idx, rho, loc(t_i, DtInt),
                        single(v_chain), v_chain);
    let checked  = null_guard(t_a, i_chain, rho);
    gen(arr, rho, locref(t_a, expr_ref(arr)), single(checked), checked);
}

// ── CompoundAssign helpers (x op= e desugars to x = x op e) ────
// Per JLS §15.26.2 left-first: x's old value captured BEFORE e
// evaluates, so a side-effect of e on x doesn't change the old
// value. Spine: t_old=x → t_val=e → x = t_old op t_val → deliver.

// JLS §5.1.3: narrow an i32 result to a sub-int storage width before it is
// stored into a byte/short/char LOCAL or STATIC (both i32-backed, so the
// truncation must be explicit). Instance fields and array elements truncate via
// their packed WASM-GC storage instead, so they do not use this. int/long/
// float/double/ref are identity. byte/short sign-extend, char zero-extends.
fun narrow_to_dt(dt: ir.datatype, v: ir_root) -> ir_root {
    match (dt) {
        DtByte  => build ir.I2B(v)
      | DtShort => build ir.I2S(v)
      | DtChar  => build ir.I2C(v)
      | _other  => v
    };
}

fun compound_local_general(slot: int, dt: ir.datatype, op: ast.binop,
                            value: ast.expr,
                            rho: rho, delta: delta, gamma: gamma,
                            Lnext: ir_root) -> ir_root {
    let t_old   = ddcg_alloc_temp(dt);
    let t_val   = ddcg_alloc_temp(dt);
    let op_tree = binop_op_node(op, dt,
                    build ir.LoadLocal(t_old, dt, nil),
                    build ir.LoadLocal(t_val, dt, nil), rho);
    let delivery = match (delta) {
        effect => match (gamma) {
                      pair(Lt: _, Lf: _) =>
                          cg_store(build ir.LoadLocal(slot, dt, nil),
                                    delta, gamma, Lnext)
                    | _other =>
                          cg_jump(gamma, Lnext)
                  }
      | _other => cg_store(build ir.LoadLocal(slot, dt, nil),
                            delta, gamma, Lnext)
    };
    let store    = build ir.StoreLocal(slot, dt, nil, narrow_to_dt(dt, op_tree), delivery);
    let v_chain  = cg_deliver_conv(value, dt, rho, loc(t_val, dt),
                        single(store), store);
    build ir.StoreLocal(t_old, dt, nil,
                        build ir.LoadLocal(slot, dt, nil),
                        v_chain);
}

fun compound_local(slot: int, dt: ir.datatype, op: ast.binop,
                    value: ast.expr,
                    rho: rho, delta: delta, gamma: gamma,
                    Lnext: ir_root) -> ir_root {
    compound_local_general(slot, dt, op, value, rho, delta, gamma, Lnext);
}

// Compound on Ident → field. Same shape as field-access compound:
// receiver is `this` (instance) or absent (static). Delivery reads
// the new op_tree (value/test contexts).
fun compound_ident_field(target: ast.expr, is_static: bool, op: ast.binop,
                          value: ast.expr,
                          rho: rho, delta: delta, gamma: gamma,
                          Lnext: ir_root) -> ir_root {
    let dt     = sema_ident_dt(target);
    let cp     = sema_field_index(target);
    let cls_id = current_class_id();
    let t_old  = ddcg_alloc_temp(dt);
    let t_val  = ddcg_alloc_temp(dt);
    let op_for_deliver = binop_op_node(op, dt,
                          build ir.LoadLocal(t_old, dt, nil),
                          build ir.LoadLocal(t_val, dt, nil), rho);
    let delivery = cg_deliver_loaded(op_for_deliver, delta, gamma, Lnext);
    let op_for_store = binop_op_node(op, dt,
                        build ir.LoadLocal(t_old, dt, nil),
                        build ir.LoadLocal(t_val, dt, nil), rho);
    let writeback = is_static
      ? build ir.PutStatic(dt, cls_id, cp, narrow_to_dt(dt, op_for_store), delivery)
      : build ir.PutField(dt, build ir.LoadThis(DtRef, current_class_id()),
                           sema_field_decl_class(target), cp, op_for_store, delivery);
    let v_chain   = cg_deliver_conv(value, dt, rho, loc(t_val, dt),
                         single(writeback), writeback);
    let old_load  = is_static
      ? build ir.GetStatic(dt, cls_id, cp)
      : build ir.GetField(dt, build ir.LoadThis(DtRef, current_class_id()), sema_field_decl_class(target), cp);
    let r = build ir.StoreLocal(t_old, dt, nil, old_load, v_chain);
    is_static ? init_barrier(cls_id, r, rho) : r;   // §12.4.1: `static f op= v` is an active use
}

// Compound on `obj.f`. Spills obj if instance, then like ident_field.
fun compound_field_static(target: ast.expr, op: ast.binop, value: ast.expr,
                           dt: ir.datatype, cls_id: int,
                           rho: rho, delta: delta, gamma: gamma,
                           Lnext: ir_root) -> ir_root {
    let cp     = sema_field_index(target);
    let t_old  = ddcg_alloc_temp(dt);
    let t_val  = ddcg_alloc_temp(dt);
    let op_for_deliver = binop_op_node(op, dt,
                          build ir.LoadLocal(t_old, dt, nil),
                          build ir.LoadLocal(t_val, dt, nil), rho);
    let delivery = cg_deliver_loaded(op_for_deliver, delta, gamma, Lnext);
    let op_for_store = binop_op_node(op, dt,
                        build ir.LoadLocal(t_old, dt, nil),
                        build ir.LoadLocal(t_val, dt, nil), rho);
    let writeback = build ir.PutStatic(dt, cls_id, cp,
                                        narrow_to_dt(dt, op_for_store), delivery);
    let v_chain   = cg_deliver_conv(value, dt, rho, loc(t_val, dt),
                         single(writeback), writeback);
    let r = build ir.StoreLocal(t_old, dt, nil,
                        build ir.GetStatic(dt, cls_id, cp), v_chain);
    init_barrier(cls_id, r, rho);   // §12.4.1: `T.f op= v` is an active use
}

fun compound_field_instance(obj: ast.expr, target: ast.expr, op: ast.binop,
                             value: ast.expr, dt: ir.datatype, cls_id: int,
                             rho: rho, delta: delta, gamma: gamma,
                             Lnext: ir_root) -> ir_root {
    let cp     = sema_field_index(target);
    // Legacy alloc order: t_old, t_val, then t_obj inside the
    // instance branch.
    let t_old  = ddcg_alloc_temp(dt);
    let t_val  = ddcg_alloc_temp(dt);
    let t_obj  = ddcg_alloc_temp(DtRef);
    let op_for_deliver = binop_op_node(op, dt,
                          build ir.LoadLocal(t_old, dt, nil),
                          build ir.LoadLocal(t_val, dt, nil), rho);
    let delivery = cg_deliver_loaded(op_for_deliver, delta, gamma, Lnext);
    let op_for_store = binop_op_node(op, dt,
                        build ir.LoadLocal(t_old, dt, nil),
                        build ir.LoadLocal(t_val, dt, nil), rho);
    let writeback = build ir.PutField(dt,
                      build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp,
                      op_for_store, delivery);
    let v_chain   = cg_deliver_conv(value, dt, rho, loc(t_val, dt),
                         single(writeback), writeback);
    let save_old  = build ir.StoreLocal(t_old, dt, nil,
                      build ir.GetField(dt,
                        build ir.LoadLocal(t_obj, DtRef, nil), sema_field_decl_class(target), cp),
                      v_chain);
    let checked = null_guard(t_obj, save_old, rho);      // §15.11: null.field op= v → NPE
    gen(obj, rho, locref(t_obj, expr_ref(obj)), single(checked), checked);
}

// Compound on `arr[idx]`. Spills arr/idx, reads, op-with-value, stores.
fun compound_array(arr: ast.expr, idx: ast.expr, op: ast.binop,
                    value: ast.expr, arr_dt: ir.datatype,
                    rho: rho, delta: delta, gamma: gamma,
                    Lnext: ir_root) -> ir_root {
    let t_a   = ddcg_alloc_temp(DtRef);
    let t_i   = ddcg_alloc_temp(DtInt);
    let t_old = ddcg_alloc_temp(arr_dt);
    let t_val = ddcg_alloc_temp(arr_dt);
    let op_for_deliver = binop_op_node(op, arr_dt,
                          build ir.LoadLocal(t_old, arr_dt, nil),
                          build ir.LoadLocal(t_val, arr_dt, nil), rho);
    let delivery = cg_deliver_loaded(op_for_deliver, delta, gamma, Lnext);
    let op_for_store = binop_op_node(op, arr_dt,
                        build ir.LoadLocal(t_old, arr_dt, nil),
                        build ir.LoadLocal(t_val, arr_dt, nil), rho);
    let astore = build ir.ArrayStore(arr_dt,
                    array_backing(t_a, array_elem_ref(arr), arr_dt),
                    build ir.LoadLocal(t_i, DtInt, nil),
                    op_for_store, delivery, array_elem_ref(arr));
    let v_chain  = cg_deliver_conv(value, arr_dt, rho, loc(t_val, arr_dt),
                        single(astore), astore);
    let save_old = build ir.StoreLocal(t_old, arr_dt, nil,
                    build ir.ArrayLoad(arr_dt,
                      array_backing(t_a, array_elem_ref(arr), arr_dt),
                      build ir.LoadLocal(t_i, DtInt, nil), array_elem_ref(arr)),
                    v_chain);
    let i_chain  = gen(idx, rho, loc(t_i, DtInt),
                        single(save_old), save_old);
    gen(arr, rho, locref(t_a, expr_ref(arr)), single(i_chain), i_chain);
}

// Ident-target assign. Resolves to local/param (slot store) or
// instance/static field of current class (put_field/put_static).
fun assign_ident_target(target: ast.expr, value: ast.expr,
                         rho: rho, delta: delta, gamma: gamma,
                         Lnext: ir_root) -> ir_root {
    let kind = sema_ident_kind(target);
    (kind == 0) or (kind == 1)
      ? assign_local(target, value, rho, delta, gamma, Lnext)
      : ((kind == 2) or (kind == 3)
          ? assign_ident_field(target, kind == 3, value,
                                rho, delta, gamma, Lnext)
          : cg_jump(gamma, Lnext));
}

// Local/param assign — JLS §15.26.1 effect+single fast path stores
// directly into the destination slot. Value/test contexts spill into
// the slot then deliver via a load.
fun assign_local(target: ast.expr, value: ast.expr,
                  rho: rho, delta: delta, gamma: gamma,
                  Lnext: ir_root) -> ir_root {
    let slot = sema_ident_slot(target);
    let dt   = sema_ident_dt(target);
    let is_pair = match (gamma) {
        pair(Lt, Lf) => true
      | _other      => false
    };
    let is_loc  = match (delta) {
        loc(slot: _, dt: _) => true
      | _other              => false
    };
    (not is_pair) and (not is_loc)
      ? cg_deliver_conv(value, dt, rho, vloc(slot, dt, sema_ident_ref(target)), gamma, Lnext)
      : { let delivery = cg_store(build ir.LoadLocal(slot, dt, sema_ident_ref(target)),
                                   delta, gamma, Lnext);
          cg_deliver_conv(value, dt, rho, vloc(slot, dt, sema_ident_ref(target)), single(delivery), delivery); };
}

// Unqualified `f = v` resolved to instance/static field of the
// current class. Spills value to t_v, then put_field(this) /
// put_static, finally delivers from t_v.
fun assign_ident_field(target: ast.expr, is_static: bool, value: ast.expr,
                        rho: rho, delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    let dt     = sema_ident_dt(target);
    let cp     = sema_field_index(target);
    let cls_id = current_class_id();
    let t_v    = ddcg_alloc_temp(dt);
    let delivery = cg_deliver_loaded(build ir.LoadLocal(t_v, dt, nil), delta, gamma, Lnext);
    let writeback = is_static
      ? build ir.PutStatic(dt, cls_id, cp,
                            build ir.LoadLocal(t_v, dt, nil), delivery)
      : build ir.PutField(dt,
                           /* `this` re-narrowed to the current class: in a VIRTUAL
                            * method slot 0 is typed at the ROOT, but struct.set needs
                            * (ref current) <: (ref decl_class). Raw LoadLocal(0) (ref
                            * root) would mistype. (Same fix the method_call receiver uses.) */
                           build ir.LoadThis(DtRef, current_class_id()),
                           sema_field_decl_class(target), cp,
                           build ir.LoadLocal(t_v, dt, nil), delivery);
    let result = cg_deliver_conv(value, dt, rho, vloc(t_v, dt, expr_ref(target)), single(writeback), writeback);
    is_static ? init_barrier(cls_id, result, rho) : result;   // §12.4.1: an unqualified static write inits its class
}

// `super.f = v` — instance field path on parent class with `this` as
// receiver. Static super-fields elide the receiver.
fun assign_super_field(target: ast.expr, value: ast.expr,
                        rho: rho, delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    let parent = sema_super_parent_class_id();
    parent < 0
      ? cg_jump(gamma, Lnext)
      : { let dt        = sema_super_field_dt(target);
          let cp        = sema_super_field_cp(target);
          let is_static = sema_super_field_is_static(target);
          let t_v       = ddcg_alloc_temp(dt);
          let delivery  = cg_deliver_loaded(build ir.LoadLocal(t_v, dt, nil), delta, gamma, Lnext);
          let writeback = is_static
            ? build ir.PutStatic(dt, parent, cp,
                                  build ir.LoadLocal(t_v, dt, nil), delivery)
            : build ir.PutField(dt, build ir.LoadThis(DtRef, current_class_id()),
                                 parent, cp,
                                 build ir.LoadLocal(t_v, dt, nil), delivery);
          cg_deliver_conv(value, dt, rho, vloc(t_v, dt, expr_ref(target)), single(writeback), writeback); };
}

// Walk `n` LOOP frames from `r` — finally_frames don't count, since
// sema only sees loops/switches/labeled-blocks when computing depth.
// n=0 returns the innermost loop_frame (or its enclosing finally if
// any sit between current position and the first loop_frame).
fun rho_skip(r: rho, n: int) -> rho {
    match (r) {
        rho_root => r
      | finally_frame(body: _, region: _, parent: p) =>
            rho_skip(p, n)
      | try_frame(region: _, parent: p) =>
            rho_skip(p, n)
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            n == 0 ? r : rho_skip(p, n - 1)
    };
}

// Is this point lexically inside a try block — i.e. inside a WASM try_table whose
// handlers belong to THIS frame? Both a try's body (try_frame) and a try-finally's
// body (finally_frame) are; a loop in between changes nothing. `return` consults this:
// a `return f()` tiled as `return_call` would pop the frame before `f` runs, so the
// handlers would not cover it (JLS §14.18: the exception is thrown IN the try block).
fun rho_in_protected(r: rho) -> int {
    match (r) {
        rho_root => 0
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            rho_in_protected(p)
      | finally_frame(body: _, region: _, parent: _) => 1
      | try_frame(region: _, parent: _) => 1
    };
}

// Record ONE ROW PER REGION ENCLOSING this excepting node, innermost first. ρ IS the
// region stack — reading it is the whole job; nothing is derived, no control flow is
// recomputed, and the SIR is never walked. A loop_frame between two try_frames changes
// nothing (it is not a handler); rho_root ends the walk.
//
// Two consumers, both spec-mandated:
//   §1  the handler MERGES the state at every excepting point of its region (JLS §11.3.1,
//       exceptions are precise). These rows ARE that merge's φ inputs.
//   §6  the exception object of a throw caught by one of these regions never leaves the
//       method, so it does not escape. WHICH region catches it depends on the thrown
//       class — the optimizer's transfer, reading pts. Not ours.
fun record_except_regions(t: ir_root, r: rho) -> int {
    // Every CALL is an excepting point (§11.1), so this is the one place every Invoke the
    // frontend builds passes through — source-written or synthesized. The target is read off
    // the node we were just handed, so no construction site has to remember to say so.
    let _ = record_call_target_of(t);
    record_except_chain(t, r);
}

fun record_except_chain(t: ir_root, r: rho) -> int {
    match (r) {
        rho_root => 0
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            record_except_chain(t, p)
      | finally_frame(body: _, region: rid, parent: p) =>
            { let _ = record_except(t, rid); record_except_chain(t, p); }
      | try_frame(region: rid, parent: p) =>
            { let _ = record_except(t, rid); record_except_chain(t, p); }
    };
}

// Is this point lexically inside a LOOP? ρ already encodes the scope chain, so the
// question is answered by reading it — nothing is derived and no control flow is
// recomputed. An allocation here is a SITE that can run many times, and Obj naming
// is 1-limited (one abstract object per site), so the object it names is a SUMMARY
// of every object the site ever produces. The analysis records that (record_alloc)
// and must not strongly update such an object: a strong update needs ONE concrete
// object (VFG Rule 3), and killing this one's field would kill the field of the
// previous iteration's object, which may still be live.
fun rho_in_loop(r: rho) -> int {
    match (r) {
        rho_root => 0
      | loop_frame(break_target: _, continue_target: _, parent: _) => 1
      | finally_frame(body: _, region: _, parent: p) => rho_in_loop(p)
      | try_frame(region: _, parent: p) => rho_in_loop(p)
    };
}

// Walk ρ across `n` loop frames toward a break target, compiling any
// finally_frame bodies crossed (innermost-first, prepended onto tail).
// Stops at the n-th loop_frame WITHOUT compiling that frame's payload —
// the loop's break_target is the actual jump destination, emitted by
// the caller into `tail`. JLS §14.20.2: every try-finally crossed by
// an abrupt completion runs its finally body first.
fun walk_for_break(r: rho, n: int, tail: ir_root) -> ir_root {
    match (r) {
        rho_root => tail
      | finally_frame(body: b, region: _, parent: p) =>
            { let inner = walk_for_break(p, n, tail);
              gen(b, p, effect, single(inner), inner); }
      | try_frame(region: _, parent: p) =>
            walk_for_break(p, n, tail)
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            n == 0 ? tail : walk_for_break(p, n - 1, tail)
    };
}

// Walk all of ρ to rho_root, compiling every finally_frame crossed.
// Used by `return` — JLS §14.17 routes return through every pending
// finally before unwinding the call frame.
fun walk_finally_for_return(r: rho, tail: ir_root) -> ir_root {
    match (r) {
        rho_root => tail
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            walk_finally_for_return(p, tail)
      | try_frame(region: _, parent: p) =>
            walk_finally_for_return(p, tail)
      | finally_frame(body: b, region: _, parent: p) =>
            { let inner = walk_finally_for_return(p, tail);
              gen(b, p, effect, single(inner), inner); }
    };
}

// §14.18.2: "If the catch block completes abruptly for reason R, then the FINALLY BLOCK IS
// EXECUTED." A `throw` therefore has to run the pending finallies the same way `return` does —
// but NOT all of them, and that is the whole difficulty.
//
// try_stmt puts a finally_frame on the BODY's ρ too (carrying the real region id), and a throw
// there is caught by this try's try_table, whose catch-all already runs the finally and
// rethrows. Inlining it here as well would run it TWICE. A catch body's frame is the one that
// is unprotected — try_stmt builds it as finally_frame(f, -1, rho), commented "this frame has
// no handlers" — so region < 0 is precisely "the table will not run this one for me".
//
// So: inline the unprotected finallies, and STOP at the first frame whose handlers will catch
// this throw, because from there propagation does the rest. Each body is compiled under its
// PARENT ρ, like every other inlined finally, so a throw inside a finally does not re-enter it.
fun walk_finally_for_throw(r: rho, tail: ir_root) -> ir_root {
    match (r) {
        rho_root => tail
      | loop_frame(break_target: _, continue_target: _, parent: p) =>
            walk_finally_for_throw(p, tail)
      | try_frame(region: rid, parent: p) =>
            rid >= 0 ? tail : walk_finally_for_throw(p, tail)
      | finally_frame(body: b, region: rid, parent: p) =>
            rid >= 0
              ? tail
              : { let inner = walk_finally_for_throw(p, tail);
                  gen(b, p, effect, single(inner), inner); }
    };
}

// Build the body normal-exit chain: optionally inline finally, then
// reach l_join. Compiled with `parent_rho` (NOT body_rho) — this
// inline copy of finally executes when the body falls through, and
// any return/break/continue inside it walks the *parent's* finally
// stack, not its own.
fun try_inline_finally(finally_body: ast.stmt, parent_rho: rho,
                        l_join: ir_root) -> ir_root {
    finally_body == nil
      ? l_join
      : gen(finally_body, parent_rho, effect, single(l_join), l_join);
}

// Build the per-handler chain: ExceptionEntry → handler body → exit.
// Recursion threads `entry_chain` through each catch in source order.
// The first catch wraps body_compiled, becoming the INNERMOST TR (per
// ascending handler order). body_rho carries the
// finally_frame (when finally exists) so return/throw inside a catch
// runs the right finally bodies.
fun build_catch_chain(catches: list<ast.catch_clause>, idx: int,
                       try_start: ir_root, body_rho: rho,
                       parent_rho: rho, l_join: ir_root,
                       finally_body: ast.stmt,
                       entry_chain: ir_root, region: int) -> ir_root {
    idx >= catches.count
      ? entry_chain
      : { let cc             = catches[idx];
          let catch_class_id = sema_catch_class_id(cc);
          let catch_type     = sema_catch_cp_classref(cc);
          let ex_slot        = sema_catch_slot(cc);
          let handler_exit   = try_inline_finally(finally_body,
                                                   parent_rho, l_join);
          let handler_body   = gen(cc.body, body_rho, effect,
                                    single(handler_exit), handler_exit);
          let handler_entry  = build ir.ExceptionEntry(ex_slot,
                                  catch_class_id, handler_body);
          // The region id stamps this handler as one of `region`'s. A Throw in the body
          // recorded the same id (record_throw_regions, off ρ), so the escape lattice
          // joins the two — the handler nodes do not exist when the Throw is built, and
          // that is exactly why the join is on an id and not on a node.
          let _              = record_try_region(try_start, handler_entry,
                                                  catch_type, region);
          let new_chain      = build ir.TryRegion(handler_entry, entry_chain);
          build_catch_chain(catches, idx + 1, try_start, body_rho,
                             parent_rho, l_join, finally_body, new_chain,
                             region); };
}

// Build a forward chain of stmts ending in `after` — each stmt
// runs in effect/single(next) context. Returns the head spine
// (= stmts[idx]'s head, or `after` if idx >= count). Used by
// switch case bodies, which terminate in either a fall-through
// to the next case's body or a Goto(Lbreak).
fun chain_case_body(stmts: list<ast.stmt>, idx: int,
                    after: ir_root, rho: rho) -> ir_root {
    idx >= stmts.count
      ? after
      : { let tail = chain_case_body(stmts, idx + 1, after, rho);
          gen(stmts[idx], rho, effect, single(tail), tail); };
}

// Build all switch case bodies right-to-left, each chained for
// fall-through. Returns body_heads in AST source order — head[i]
// is the spine head of cases[i]'s body. The last case's body
// terminates in `after_last` (typically Goto(Lbreak)); each prior
// case falls through to the next case's body via the chain.
fun chain_switch_cases(cases: list<ast.switch_case>, idx: int,
                        after_last: ir_root, rho: rho) -> list<ir_root> {
    idx >= cases.count
      ? []
      : { let rest = chain_switch_cases(cases, idx + 1, after_last, rho);
          let next_head = rest.count == 0 ? after_last : rest[0];
          let here = chain_case_body(cases[idx].stmts, 0, next_head, rho);
          [here] + rest; };
}

// Build the SIR tree for a defunctionalised `tree_op` applied to a
// loaded operand. Each variant's fields carry exactly the SIR ctor's
// non-operand args; the operand is the `value` parameter.
// `r` is here for the ALLOCATING variants only: JLS §11.1 specifies OutOfMemoryError at an
// array creation ("some limitation on a resource is exceeded, such as using too much
// memory"), and ClassConstructOp `call_ref`s a constructor. They are excepting points, so
// they record their region — regardless of whether the current backend can deliver an OOM
// (ours traps; that is a VM conformance bug, not a licence to assume `new` cannot throw).
fun build_tree_op(op: tree_op, value: ir_root, r: rho) -> ir_root {
    match (op) {
        ArrayLengthOp                       => build ir.ArrayLength(value)
      | GetFieldOp(dt: dt, cls_id: c, cp: cp) =>
            build ir.GetField(dt, value, c, cp)
      | NewArrayOp(at: at)                  =>
            { let n = build ir.NewArray(at, value);
              let _ = record_except_regions(n, r); n; }
      | NewRefArrayOp(eref: eref)           =>
            { let n = build ir.NewRefArray(0, value, eref);
              let _ = record_except_regions(n, r); n; }
      | CheckCastOp(at: at, cp: cp)         => build ir.CheckCast(value, at, cp)
      | InstanceOfOp(at: at, cp: cp)        => build ir.InstanceOf(value, at, cp)
      | S2IOp                               => build ir.S2I(value)
      | I2SOp                               => build ir.I2S(value)
      | S2BOp                               => build ir.S2B(value)
      | I2BOp                               => build ir.I2B(value)
      | I2COp                               => build ir.I2C(value)
      | I2LOp                               => build ir.I2L(value)
      | I2FOp                               => build ir.I2F(value)
      | I2DOp                               => build ir.I2D(value)
      | L2IOp                               => build ir.L2I(value)
      | L2FOp                               => build ir.L2F(value)
      | L2DOp                               => build ir.L2D(value)
      | F2IOp                               => build ir.F2I(value)
      | F2LOp                               => build ir.F2L(value)
      | F2DOp                               => build ir.F2D(value)
      | D2IOp                               => build ir.D2I(value)
      | D2LOp                               => build ir.D2L(value)
      | D2FOp                               => build ir.D2F(value)
      | MoveF2IOp                           => build ir.MoveF2I(value)
      | MoveI2FOp                           => build ir.MoveI2F(value)
      | MoveD2LOp                           => build ir.MoveD2L(value)
      | MoveL2DOp                           => build ir.MoveL2D(value)
      | F64SqrtOp                           => build ir.F64Sqrt(value)
      | F64FloorOp                          => build ir.F64Floor(value)
      | F64CeilOp                           => build ir.F64Ceil(value)
      | F64NearestOp                        => build ir.F64Nearest(value)
      | ClassInstantiableOp                 => build ir.ClassInstantiable(value)
      | ClassConstructOp                    =>
            { let n = build ir.ClassConstruct(value);   // call_ref's a ctor — it excepts
              let _ = record_except_regions(n, r); n; }
      | L2BOp                               => build ir.I2B(build ir.L2I(value))
      | L2SOp                               => build ir.I2S(build ir.L2I(value))
      | L2COp                               => build ir.I2C(build ir.L2I(value))
      | F2BOp                               => build ir.I2B(build ir.F2I(value))
      | F2SOp                               => build ir.I2S(build ir.F2I(value))
      | F2COp                               => build ir.I2C(build ir.F2I(value))
      | D2BOp                               => build ir.I2B(build ir.D2I(value))
      | D2SOp                               => build ir.I2S(build ir.D2I(value))
      | D2COp                               => build ir.I2C(build ir.D2I(value))
    };
}

// Pick the right delivery primitive for the op kind. Pure trees
// (numeric narrowing/widening) deliver via cg_store — no side
// effects to wrap. Effectful trees (NPE candidates, allocations,
// type checks) deliver via cg_deliver_effectful so the side effect
// runs even when the value is dropped.
fun deliver_tree(kind: delivery_kind, value: ir_root,
                  delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    match (kind) {
        Pure       => cg_store(value, delta, gamma, Lnext)
      | Effectful  => cg_deliver_effectful(value, delta, gamma, Lnext)
    };
}

// Single-operand spill-or-simple: build the right tree around a
// simple operand or — for non-simple operands — spill via a fresh
// temp of `op_dt`. Replaces 10+ duplicated helpers (array_length,
// instance_field_acc, prim/ref-new_array, ref_cast, instance_of,
// cast_to_byte/short/int) — each call site now passes a tree_op
// tag plus delivery_kind. JLS §15.7.1 left-first ordering is
// trivially preserved (single-operand, no reorder risk).
fun spill_or_simple(op: tree_op, kind: delivery_kind,
                     operand: ast.expr, op_dt: ir.datatype,
                     rho: rho, delta: delta, gamma: gamma,
                     Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(op_dt);
    let head = deliver_tree(kind,
                 build_tree_op(op, build ir.LoadLocal(t, op_dt, nil), rho),
                 delta, gamma, Lnext);
    // A reference operand spilled to `t` types the slot from its proven referent
    // (expr_ref) so the op's reloaded receiver/operand is concretely typed.
    let dst = match (op_dt) {
        DtRef  => locref(t, expr_ref(operand))
      | _other => loc(t, op_dt)
    };
    gen(operand, rho, dst, single(head), head);
}

// JLS §5.2 assignment conversion at a value-delivery point: deliver `v` to
// (delta, gamma), inserting the implicit widening to `to_dt` when `v` is narrower.
// assign_conv decides via the one type authority (lat_num_conv); only widenings
// reach a valid assignment context (narrowing needs an explicit cast, which sema
// rejects here). Identity / non-numeric → a plain gen (no conversion node).
fun cg_deliver_conv(v: ast.expr, to_dt: ir.datatype, rho: rho,
                    delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    match (assign_conv(v, to_dt)) {
        CastI2L => spill_or_simple(I2LOp, Pure, v, sema_data_type_or(v, DtInt),   rho, delta, gamma, Lnext)
      | CastI2F => spill_or_simple(I2FOp, Pure, v, sema_data_type_or(v, DtInt),   rho, delta, gamma, Lnext)
      | CastI2D => spill_or_simple(I2DOp, Pure, v, sema_data_type_or(v, DtInt),   rho, delta, gamma, Lnext)
      | CastL2F => spill_or_simple(L2FOp, Pure, v, sema_data_type_or(v, DtLong),  rho, delta, gamma, Lnext)
      | CastL2D => spill_or_simple(L2DOp, Pure, v, sema_data_type_or(v, DtLong),  rho, delta, gamma, Lnext)
      | CastF2D => spill_or_simple(F2DOp, Pure, v, sema_data_type_or(v, DtFloat), rho, delta, gamma, Lnext)
      | _other  => gen(v, rho, delta, gamma, Lnext)
    };
}

// A conditional arm (JLS §15.25): when the arms differ in numeric type, binary
// numeric promotion converts BOTH to the result type. The ternary rule delivers
// each arm straight to `delta`, so a narrower arm (e.g. the `0` in
// `cond ? aLong : 0`) must widen to the destination's dt first; for a non-value
// destination (effect / predicate pair / ref) there is nothing to convert.
fun ternary_arm(arm: ast.expr, rho: rho, delta: delta,
                 gamma: gamma, Lnext: ir_root) -> ir_root {
    match (delta) {
        loc(slot: _, dt: d) => cg_deliver_conv(arm, d, rho, delta, gamma, Lnext)
      | _other              => gen(arm, rho, delta, gamma, Lnext)
    };
}

// Width-correct integer literal leaves for a guard's compare (LoadConst only
// tiles as i32.const; a long needs LoadLongConst for its i64.const).
fun zero_const(dt: ir.datatype) -> ir_root {
    match (dt) {
        DtLong => build ir.LoadLongConst(0)
      | _other => build ir.LoadConst(0, dt)
    };
}
fun neg_one_const(dt: ir.datatype) -> ir_root {
    match (dt) {
        DtLong => build ir.LoadLongConst(0 - 1)
      | _other => build ir.LoadConst(0 - 1, dt)
    };
}

// The INT_MIN/-1 arm of a guarded integer division (JLS §15.17.2: `MIN_VALUE / -1`
// WRAPS to MIN_VALUE, while WASM's i32.div_s TRAPS on it — so on `divisor == -1` we
// compute `-a` instead of dividing). REM never traps on -1 and needs no such arm.
//
// RECORDED like every other guard: this is a branch the LOWERING inserted, which a
// proof can remove (the range lattice showing the divisor cannot be -1), and the stage
// that knows is the one that says so. It THROWS NOTHING — both arms produce the value —
// which is why throw_on_true is 0 here and means nothing for this kind.
fun div_overflow_arm(t_a: int, t_b: int, lhs_dt: ir.datatype, rhs_dt: ir.datatype,
                     ct: ir.datatype, delta: delta, gamma: gamma,
                     Lnext: ir_root) -> ir_root {
    let br = build ir.Branch(
                 build ir.Eq(build ir.LoadLocal(t_b, rhs_dt, nil), neg_one_const(rhs_dt)),
                 cg_store(build ir.Neg(ct,
                              cg_promote(build ir.LoadLocal(t_a, lhs_dt, nil), lhs_dt, ct)),
                          delta, gamma, Lnext),
                 cg_store(build ir.Div(ct,
                              cg_promote(build ir.LoadLocal(t_a, lhs_dt, nil), lhs_dt, ct),
                              cg_promote(build ir.LoadLocal(t_b, rhs_dt, nil), rhs_dt, ct)),
                          delta, gamma, Lnext));
    let _ = record_guard(br, 6, t_b, 0 - 1, 0);   // divisor == -1; throws on NEITHER arm
    br;
}

// A §15 implicit-exception guard's throw arm: synthesize `throw new <exc>()` —
// New the class, run its no-arg ctor (§12.5), then Throw the ref. This is the
// SAME New/ctor/Throw IR the frontend emits for a source `throw new X()`; GC
// construction is in-module WASM, never a host call.
// It takes ρ for the same reason `throw e` does: a §15 exception thrown inside a try
// that catches it never leaves the method, so its object does not escape (§6). The
// regions enclosing this guard are on ρ — RECORD them. (Threading ρ through the guard
// helpers is the price of that; recovering the enclosure by walking the SIR afterwards
// is not an option — §8.)
// JLS §11.4: a VM-detected exception carries the reason. The spec's worked program prints
// `java.lang.ArithmeticException` with the message "/ by zero", so a guard that constructed
// its exception with the no-arg ctor could not produce the specified output.
//
// `new Exc(new String(<pooled char[]>))`. The message's code units go in the module's
// constant data and the char[] is one array.new_data — the same path a §10.6 constant
// initializer takes, which is what makes a synthesized literal expressible here at all
// (`rule string_lit` panics by design: sema desugars AST literals, and a guard has no AST).
//
// Falls back to the no-arg form when either constructor is missing, so a runtime whose
// exception class lacks a (String) ctor still gets a throw rather than a call to nothing.
fun throw_new_msg(exc_class: int, msg: string, r: rho) -> ir_root {
    let ctor_cp = sema_string_arg_ctor_index(exc_class);
    let str_cls = sema_string_class_id();
    let str_cp  = sema_string_chars_ctor_index();
    (ctor_cp < 0 or str_cls < 0 or str_cp < 0)
      ? throw_new_noarg(exc_class, r)
      : { let t_obj = ddcg_alloc_temp(DtRef);
          let t_str = ddcg_alloc_temp(DtRef);
          let t_arr = ddcg_alloc_temp(DtRef);

          let throw_node = build ir.Throw(build ir.LoadLocal(t_obj, DtRef, nil));
          let _          = record_except_regions(throw_node, r);

          // new Exc(t_str)
          let exc_args: list<ir_root> = [build ir.LoadLocal(t_str, DtRef,
                                               build ir.ClassRef(str_cls))];
          let exc_ctor = build ir.InvokeSpecial(build ir.LoadLocal(t_obj, DtRef, nil),
                                                exc_class, ctor_cp, exc_args, DtShort);
          let _        = record_except_regions(exc_ctor, r);
          let exc_new  = build ir.New(exc_class);
          let _        = record_except_regions(exc_new, r);
          let after_exc = build ir.StoreLocal(t_obj, DtRef, build ir.ClassRef(exc_class),
                              exc_new, build ir.ExprEffect(exc_ctor, 1, throw_node));

          // new String(t_arr)
          let str_args: list<ir_root> = [build ir.LoadLocal(t_arr, DtRef, nil)];
          let str_ctor = build ir.InvokeSpecial(build ir.LoadLocal(t_str, DtRef, nil),
                                                str_cls, str_cp, str_args, DtShort);
          let _        = record_except_regions(str_ctor, r);
          let str_new  = build ir.New(str_cls);
          let _        = record_except_regions(str_new, r);
          let after_str = build ir.StoreLocal(t_str, DtRef, build ir.ClassRef(str_cls),
                              str_new, build ir.ExprEffect(str_ctor, 1, after_exc));

          // the char[] itself, out of the constant-data pool
          build_primarray_data_into(t_arr, AtChar, 0 - 1,
                                    const_string_offset(msg), const_string_length(msg),
                                    rho_in_loop(r), after_str, r); };
}

fun throw_new_noarg(exc_class: int, r: rho) -> ir_root {
    let ctor_cp    = sema_noarg_ctor_index(exc_class);
    let t_obj      = ddcg_alloc_temp(DtRef);
    let no_args: list<ir_root> = [];
    let throw_node = build ir.Throw(build ir.LoadLocal(t_obj, DtRef, nil));
    let _          = record_except_regions(throw_node, r);
    // The exception object's OWN allocation and ctor are excepting points too (§11.1) —
    // an enclosing handler can be reached from them, before this throw ever runs.
    let exc_new    = build ir.New(exc_class);
    let _          = record_except_regions(exc_new, r);
    let after_new  = ctor_cp < 0
        ? throw_node
        : { let ctor = build ir.InvokeSpecial(build ir.LoadLocal(t_obj, DtRef, nil),
                                              exc_class, ctor_cp, no_args, DtShort);
            let _    = record_except_regions(ctor, r);
            build ir.ExprEffect(ctor, 1, throw_node); };
    build ir.StoreLocal(t_obj, DtRef, build ir.ClassRef(exc_class),
                        exc_new, after_new);
}

// javelina.simd.Mem bounds: a Java-visible memory
// access NEVER traps the VM. `addr < 0 || (long)addr + width > memory.size *
// 64Ki` throws the catchable base IndexOutOfBoundsException (a §7.5.3
// java.lang type) BEFORE the raw wasm op — which is then in-bounds by
// construction. Long math so a large addr cannot wrap past the limit; the
// separate `addr < 0` arm because a negative addr widens negative and would
// pass the sum check.
fun mem_bounds_guard(t_addr: int, width: int, ok: ir_root, r: rho) -> ir_root {
    // The §15 ARRAY SHAPE: the tested side is the addr slot alone (through
    // one I2L), the width folded into the bound — `(long)addr > limit − w`
    // ⟺ `(long)addr + w > limit`, exact in i64 both ways. The bound is an
    // addr-free expression, congruent across adjacent guards through the
    // MemSize memory-input keying, which is what lets the optimizer's
    // symbolic-bound consumer fold the SECOND guard the way it folds a
    // second `i >= a.length`.
    let hi = build ir.Branch(
        build ir.Gt(build ir.I2L(build ir.LoadLocal(t_addr, DtInt, nil)),
                    build ir.Sub(DtLong,
                        build ir.Mul(DtLong,
                            build ir.I2L(build ir.MemSize()),
                            build ir.LoadLongConst(65536)),
                        build ir.LoadLongConst(width))),
        throw_new_noarg(sema_index_oob_exc_id(), r),
        ok);
    let _ = record_guard(hi, 8, t_addr, 0 - 1, 1);   // addr > limit-width; throws on TRUE
    let lo = build ir.Branch(
        build ir.Lt(build ir.LoadLocal(t_addr, DtInt, nil), build ir.LoadConst(0, DtInt)),
        throw_new_noarg(sema_index_oob_exc_id(), r),
        hi);
    let _ = record_guard(lo, 8, t_addr, 0 - 1, 1);   // addr < 0; throws on TRUE
    lo;
}

// The memory.fill/copy range form: base >= 0, len >= 0, (long)base + len <= limit.
fun mem_range_guard(t_base: int, t_len: int, ok: ir_root, r: rho) -> ir_root {
    // The §15 ARRAY SHAPE, as mem_bounds_guard: the tested side is the base slot
    // alone (through one I2L), len folded into the bound — `(long)base > limit − len`
    // ⟺ `(long)base + len > limit`, exact in i64 and evaluated with base, len ≥ 0
    // (the lo/ln arms below run first). The bound is base-free, so the GT-false-edge
    // mint puts base's symbolic upper bound in place and a second range op with the
    // same len folds this guard through the existing symbolic-bound consumer — the
    // way mem_bounds_guard's second access folds. A sum on the tested side (the old
    // shape) carried no per-slot bound and never folded.
    let hi = build ir.Branch(
        build ir.Gt(build ir.I2L(build ir.LoadLocal(t_base, DtInt, nil)),
                    build ir.Sub(DtLong,
                        build ir.Mul(DtLong,
                            build ir.I2L(build ir.MemSize()),
                            build ir.LoadLongConst(65536)),
                        build ir.I2L(build ir.LoadLocal(t_len, DtInt, nil)))),
        throw_new_noarg(sema_index_oob_exc_id(), r),
        ok);
    let _ = record_guard(hi, 8, t_base, 0 - 1, 1);   // (long)base > limit-len; throws on TRUE
    let ln = build ir.Branch(
        build ir.Lt(build ir.LoadLocal(t_len, DtInt, nil), build ir.LoadConst(0, DtInt)),
        throw_new_noarg(sema_index_oob_exc_id(), r),
        hi);
    let _ = record_guard(ln, 8, t_len, 0 - 1, 1);    // len < 0; throws on TRUE
    let lo = build ir.Branch(
        build ir.Lt(build ir.LoadLocal(t_base, DtInt, nil), build ir.LoadConst(0, DtInt)),
        throw_new_noarg(sema_index_oob_exc_id(), r),
        ln);
    let _ = record_guard(lo, 8, t_base, 0 - 1, 1);   // base < 0; throws on TRUE
    lo;
}

// JLS §15.13.1 null-check: `if (t_a == null) throw new NullPointerException()` else
// continue to `ok`. Emitted right after the receiver ref is spilled (before the
// index/value), so a null array raises NPE without evaluating them.
fun null_guard(t_a: int, ok: ir_root, r: rho) -> ir_root {
    let br = build ir.Branch(
        build ir.Eq(build ir.LoadLocal(t_a, DtRef, nil), build ir.LoadNull()),
        throw_new_noarg(sema_null_pointer_exc_id(), r),
        ok);
    let _ = record_guard(br, 0, t_a, 0 - 1, 1);   // NPE; throws on TRUE (a == null)
    br;
}

// JLS §15.13.1 bounds-check: `if (i < 0 || i >= a.length) throw new
// ArrayIndexOutOfBoundsException()` else `ok`. a is known non-null here.
fun bounds_guard(t_a: int, t_i: int, eref: ir_root, width: ir.datatype, ok: ir_root,
                 r: rho) -> ir_root {
    let hi = build ir.Branch(
        build ir.Ge(build ir.LoadLocal(t_i, DtInt, nil),
                    build ir.ArrayLength(array_backing(t_a, eref, width))),
        throw_new_noarg(sema_array_index_exc_id(), r),
        ok);
    let _ = record_guard(hi, 2, t_i, t_a, 1);     // i >= a.length; throws on TRUE
    let lo = build ir.Branch(
        build ir.Lt(build ir.LoadLocal(t_i, DtInt, nil), build ir.LoadConst(0, DtInt)),
        throw_new_noarg(sema_array_index_exc_id(), r),
        hi);
    let _ = record_guard(lo, 1, t_i, 0 - 1, 1);   // i < 0; throws on TRUE
    lo;
}

// JLS §10.10: before a covariant reference-array element store, call
// Class.arrayStoreCheck(a.elementClass, v) — it throws ArrayStoreException if v's runtime
// class is not assignable to the array's ACTUAL element type (a static ref.test can't:
// the target is a runtime Class). A no-op if the prelude lacks the method.
fun arraystore_guard(t_a: int, t_v: int, ok: ir_root, r: rho) -> ir_root {
    arraystore_check_method() < 0
      ? ok
      : { let ec   = build ir.GetField(DtRef, build ir.LoadLocal(t_a, DtRef, nil),
                        refarray_class(), refarray_elem_field());
          let args = [ec, build ir.LoadLocal(t_v, DtRef, nil)];
          let call = build ir.InvokeStatic(arraystore_check_class(),
                        arraystore_check_method(), args, DtShort);
          // It THROWS ArrayStoreException from inside the callee (§10.10) — an excepting
          // CALL, and the one guard whose exception is not an explicit Throw arm.
          let _    = record_except_regions(call, r);
          let eff  = build ir.ExprEffect(call, 1, ok);
          // RECORDED like every other guard — it is a check the LOWERING inserted, which a
          // proof can remove. It is a CALL and not a Branch, which is exactly why it was
          // never recorded before and why every array-store check went uncounted: the
          // sidecar's shape assumed a Branch. The stage that knows says so; the
          // consumer and the census read the node's tag to see whether it survived.
          let _ = record_guard(eff, 7, t_v, t_a, 0);
          eff; };
}

// spill_or_simple for a REFERENCE RECEIVER the op then dereferences (instance
// field get, array length): null-check the spilled receiver first (JLS §15.11 /
// §10.7: null.field / null.length throw NullPointerException).
fun spill_or_simple_nullck(op: tree_op, kind: delivery_kind,
                            operand: ast.expr, rho: rho, delta: delta,
                            gamma: gamma, Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(DtRef);
    let head = deliver_tree(kind,
                 build_tree_op(op, build ir.LoadLocal(t, DtRef, nil), rho),
                 delta, gamma, Lnext);
    let guarded = null_guard(t, head, rho);
    gen(operand, rho, locref(t, expr_ref(operand)), single(guarded), guarded);
}

// JLS §15.10.1 negative-size check: `if (n < 0) throw new NegativeArraySizeException()`
// else continue to the allocation `ok`.
fun neg_size_guard(t_n: int, ok: ir_root, r: rho) -> ir_root {
    let br = build ir.Branch(
        build ir.Lt(build ir.LoadLocal(t_n, DtInt, nil), build ir.LoadConst(0, DtInt)),
        throw_new_noarg(sema_neg_array_size_exc_id(), r),
        ok);
    let _ = record_guard(br, 3, t_n, 0 - 1, 1);   // n < 0; throws on TRUE
    br;
}

// JLS §20.18.16 System.arraycopy range checks — throw the BASE IndexOutOfBoundsException
// (NOT the array subclass), in overflow-safe order: srcOff/dstOff/len >= 0, then
// srcOff > src.length / dstOff > dst.length (so length-off can't underflow), then
// len > src.length-srcOff / len > dst.length-dstOff. `arr` supplies the element ref for
// the backing-length reads (both arrays share the overlay). src/dst known non-null here.
fun arraycopy_bounds(t_src: int, t_so: int, t_dst: int, t_do: int, t_len: int,
                     arr: ast.expr, width: ir.datatype, ok: ir_root,
                     r: rho) -> ir_root {
    let ioob = sema_index_oob_exc_id();
    let c7 = build ir.Branch(
               build ir.Gt(build ir.LoadLocal(t_len, DtInt, nil),
                 build ir.Sub(DtInt, build ir.ArrayLength(array_backing(t_dst, array_elem_ref(arr), width)),
                   build ir.LoadLocal(t_do, DtInt, nil))),
               throw_new_noarg(ioob, r), ok);
    let c6 = build ir.Branch(
               build ir.Gt(build ir.LoadLocal(t_do, DtInt, nil),
                 build ir.ArrayLength(array_backing(t_dst, array_elem_ref(arr), width))),
               throw_new_noarg(ioob, r), c7);
    let c5 = build ir.Branch(
               build ir.Gt(build ir.LoadLocal(t_len, DtInt, nil),
                 build ir.Sub(DtInt, build ir.ArrayLength(array_backing(t_src, array_elem_ref(arr), width)),
                   build ir.LoadLocal(t_so, DtInt, nil))),
               throw_new_noarg(ioob, r), c6);
    let c4 = build ir.Branch(
               build ir.Gt(build ir.LoadLocal(t_so, DtInt, nil),
                 build ir.ArrayLength(array_backing(t_src, array_elem_ref(arr), width))),
               throw_new_noarg(ioob, r), c5);
    let c3 = build ir.Branch(
               build ir.Lt(build ir.LoadLocal(t_len, DtInt, nil), build ir.LoadConst(0, DtInt)),
               throw_new_noarg(ioob, r), c4);
    let c2 = build ir.Branch(
               build ir.Lt(build ir.LoadLocal(t_do, DtInt, nil), build ir.LoadConst(0, DtInt)),
               throw_new_noarg(ioob, r), c3);
    build ir.Branch(
      build ir.Lt(build ir.LoadLocal(t_so, DtInt, nil), build ir.LoadConst(0, DtInt)),
      throw_new_noarg(ioob, r), c2);
}

// spill_or_simple for a single-dimension array SIZE: spill the size, guard it
// negative (§15.10.1), then allocate (NewArray / NewRefArray).
fun spill_or_simple_negsize(op: tree_op, operand: ast.expr, rho: rho,
                             delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(DtInt);
    let head = deliver_tree(Effectful,
                 build_tree_op(op, build ir.LoadLocal(t, DtInt, nil), rho),
                 delta, gamma, Lnext);
    let guarded = neg_size_guard(t, head, rho);
    gen(operand, rho, loc(t, DtInt), single(guarded), guarded);
}

// JLS §10.7 — Array.length intrinsic. Not a real field; lowers to
// SIR_ARRAYLENGTH, which BURS picks the typed `arraylength` opcode for.
fun array_length_acc(obj: ast.expr,
                      rho: rho, delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    // Both a PrimArray and a RefArray are struct overlays — spill the ref, null-check,
    // then ArrayLength of the backing (array_backing: PrimBacking for prim, RefArray.data
    // for ref).
    let t_a  = ddcg_alloc_temp(DtRef);
    let len  = build ir.ArrayLength(array_backing(t_a, array_elem_ref(obj), sema_array_elem_dt(obj)));
    let head = cg_deliver_effectful(len, delta, gamma, Lnext);
    let checked = null_guard(t_a, head, rho);
    gen(obj, rho, locref(t_a, expr_ref(obj)), single(checked), checked);
}

// JLS §15.11.1 — static field read. Inlines static-final primitives
// (§15.28). When obj has side effects (`expr.STATIC_FIELD`), evaluate
// obj first in effect context — the receiver's effects are observable
// even though only the static field's value is delivered.
// JLS §12.4.2 init barrier: before an active use of `cls`, ensure it is initialized. A void
// InvokeStatic($ensure_init) spine statement (reuses the InvokeStatic node + its tile — no new node,
// no per-emit-site codegen), gated by the sema needs_init authority. Constant static reads never reach
// a barrier — sema inlines them to LoadConst, so they never become a GetStatic (§12.4.1).
fun init_barrier(cls: int, cont: ir_root, r: rho) -> ir_root {
    let ei = sema_ensure_init_cp(cls);   // -1 when the class has no $ensure_init (needs no init, or a
    ei < 0                               // needs_init class with no source, e.g. a synthesized overlay)
      ? cont
      : { let no_args: list<ir_root> = [];
          let inv = build ir.InvokeStatic(cls, ei, no_args, DtInt);
          // §11.1's "an error occurs in loading or linking (§12.2, §12.3)": class init throws
          // ExceptionInInitializerError / NoClassDefFoundError, and $ensure_init rethrows them.
          // It is a CALL, and it excepts.
          let _   = record_except_regions(inv, r);
          build ir.ExprEffect(inv, 1, cont); };
}

fun static_field_acc(obj: ast.expr, node: ast.expr,
                      rho: rho, delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    let dt = sema_field_acc_dt(node);
    let cp = sema_field_index(node);
    // A static field belongs to its DECLARING class (the global + the §12.4.1 init both key off it):
    // `cp` is the field's position in its owner, so `Sub.f` / `SubIface.f` must read the owner, not the
    // access type. (Direct access `T.f` has owner == access type, so unchanged.)
    let class_id = sema_field_decl_class(node);
    let (folded, k) = fold_const_expr(node);      // §13.1: the use IS the value
    let value_tree = folded
      ? k
      : build ir.GetStatic(dt, class_id, cp);
    let delivered = sema_may_have_effects(obj)
      ? { let head = cg_deliver_effectful(value_tree, delta, gamma, Lnext);
          gen(obj, rho, effect, single(head), head); }
      : cg_deliver_effectful(value_tree, delta, gamma, Lnext);
    folded ? delivered : init_barrier(class_id, delivered, rho);
}

// JLS §15.11.1 — instance field read. Spills obj to a temp when
// non-simple so the GetField tree can pull the receiver from a load.
fun instance_field_acc(obj: ast.expr, node: ast.expr,
                        rho: rho, delta: delta, gamma: gamma,
                        Lnext: ir_root) -> ir_root {
    spill_or_simple_nullck(GetFieldOp(sema_field_acc_dt(node),
                                sema_field_decl_class(node),
                                sema_field_index(node)),
                    Effectful, obj,
                    rho, delta, gamma, Lnext);
}

// Reference cast (class or array) — emits CheckCast(obj, atype, cp).
// Spill obj if non-simple.
// JLS §15.16 checked reference cast. CheckCast lowers to `ref.cast_null`, which
// PASSES null (Java `(T)null` == null) and valid casts but TRAPS a bad cast — Java
// throws a CATCHABLE ClassCastException. So guard first: throw only when the operand
// is non-null AND not an instance of the target; otherwise the cast can't trap.
fun emit_ref_cast(at: ir.atype, cp: int, op: ast.expr,
                   rho: rho, delta: delta, gamma: gamma,
                   Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(DtRef);
    let ok_null = cg_deliver_effectful(
        build ir.CheckCast(build ir.LoadLocal(t, DtRef, nil), at, cp), delta, gamma, Lnext);
    let ok_inst = cg_deliver_effectful(
        build ir.CheckCast(build ir.LoadLocal(t, DtRef, nil), at, cp), delta, gamma, Lnext);
    let cast_ck = build ir.Branch(
        build ir.InstanceOf(build ir.LoadLocal(t, DtRef, nil), at, cp),
        ok_inst,
        throw_new_noarg(sema_class_cast_exc_id(), rho));
    // NB: this one throws on the FALSE arm (not an instance) — the opposite of
    // every other guard, which is exactly why the arm is recorded, not assumed.
    let _ = record_guard(cast_ck, 5, t, 0 - 1, 0);
    let guard = build ir.Branch(
        build ir.Eq(build ir.LoadLocal(t, DtRef, nil), build ir.LoadNull()),
        ok_null,
        cast_ck);
    // ok_null and ok_inst both deliver the cast value and continue to the same γ.
    // For a single-label γ that shared continuation L is a MERGE label (§2.1) —
    // record it keyed on the guard so the structurer emits the cast's tail once,
    // not per diamond arm (two casts per branch × an if-else-if chain otherwise
    // compounds). ret/pair γ: no shared re-emittable tail (see the div guard).
    let _ = match (gamma) { single(L) => record_scope(guard, L, 3) | _other => 0 };
    // The spill temp's REF type is the operand's own descriptor, EXCEPT a `null` literal has
    // none (expr_ref = nil, because the null type names no class) — then type it from the
    // cast's TARGET, which is what the CheckCast on both arms narrows to. Without this the
    // slot is a DtRef with no typeidx and the backend refuses the module: `(String) null` is
    // legal Java (§5.5 — "a null reference may be cast to any reference type") and did not
    // compile. Same rule as chain_call_args below.
    let oref = expr_ref(op);
    gen(op, rho, locref(t, oref == nil ? build ir.ClassRef(cp) : oref), single(guard), guard);
}

// Right-to-left chain of arg evaluations into pre-allocated temps,
// each delivering value to its t_args[idx] slot then jumping to the
// chain built so far. Receiver, if any, is appended by the caller.
fun chain_call_args(args: list<ast.expr>, idx: int,
                     t_args: list<int>, arg_dts: list<ir.datatype>,
                     dcl: int, cp: int,
                     after: ir_root, rho: rho) -> ir_root {
    idx < 0
      ? after
      : { // arg_dts[idx] is the PARAM type, so cg_deliver_conv applies JLS §5.3
          // method-invocation conversion (e.g. int→long) into the param-typed slot.
          // The spill temp's REF type is the arg's own descriptor, EXCEPT a `null`
          // literal has none (expr_ref = nil) — then the slot is still a param-type
          // reference, so type it from the param (the (dcl, cp) authority).
          let aref = expr_ref(args[idx]);
          let eref = aref == nil ? sema_param_ref(dcl, cp, idx) : aref;
          let chain = cg_deliver_conv(args[idx], arg_dts[idx], rho,
                            vloc(t_args[idx], arg_dts[idx], eref),
                            single(after), after);
          chain_call_args(args, idx - 1, t_args, arg_dts, dcl, cp, chain, rho); };
}

// Build the right SIR_INVOKE_* variant for the resolved sema kind.
// Static omits the receiver; the others take recv_load.
//   0 STATIC | 1 VIRTUAL | 2 SPECIAL | 3 INTERFACE
fun build_invoke_node(kind: int, target_class: int, cp: int,
                       recv_load: ir_root, arg_loads: list<ir_root>,
                       dt: ir.datatype, r: rho) -> ir_root {
    let call = kind == 0
      ? build ir.InvokeStatic(target_class, cp, arg_loads, dt)
      : (kind == 2
          ? build ir.InvokeSpecial(recv_load, target_class, cp,
                                    arg_loads, dt)
          : (kind == 3
              ? build ir.InvokeInterface(recv_load, target_class, cp,
                                          arg_loads, dt)
              : build ir.InvokeVirtual(recv_load, target_class, cp,
                                        arg_loads, dt)));
    // THE call site. Whatever the callee throws lands in an enclosing handler of THIS
    // method (§11.1: the callee's exceptions propagate; StackOverflowError is raised at
    // the invocation), so the handler must see the state HERE (§11.3.1, precise).
    let _ = record_except_regions(call, r);
    call;
}

// Tail of the call chain: void invokes wrap in ExprEffect to drop
// the result; non-void invokes deliver via cg_deliver_effectful so
// δ/γ get the value.
fun call_delivery(invoke_node: ir_root, is_void: bool, dt: ir.datatype,
                   delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    is_void
      ? build ir.ExprEffect(invoke_node, 1, cg_jump(gamma, Lnext))
      : cg_deliver_effectful(invoke_node, delta, gamma, Lnext);
}

// Right-to-left chain: each elems[idx] evaluates into a fresh temp,
// then ArrayStore writes the temp into t_arr[idx], chaining into the
// chain built so far. Recursion base case (idx < 0) returns `after`.
// `eref` is the array's CONTEXTUAL element descriptor (JLS §10.6: the component type comes
// from the target, not from the literals). It types the per-element temp and the store, in
// place of the element expression's own descriptor — because `null` has the null type (§4.1)
// and carries no descriptor at all, so `String[] x = { "p", null, "q" };` left the temp slot
// untyped and the assembler rejected the module rather than guess `ref Object`.
fun chain_array_init(elems: list<ast.expr>, idx: int, t_arr: int,
                      arr_dt: ir.datatype, eref: ir_root, after: ir_root,
                      rho: rho) -> ir_root {
    idx < 0
      ? after
      : { let t_elem = ddcg_alloc_temp(arr_dt);
          // Both overlays store into their `data` backing: a reference array into
          // RefArray.data, a primitive array into the per-width PrimArray overlay's data.
          let arr_op = arr_dt == DtRef
            ? build ir.GetField(DtRef, build ir.LoadLocal(t_arr, DtRef, nil),
                                refarray_class(), refarray_data_field())
            : build ir.GetField(DtRef, build ir.LoadLocal(t_arr, DtRef, nil),
                                primarray_class_dt(arr_dt), primarray_data_field());
          let store  = build ir.ArrayStore(arr_dt,
                          arr_op,
                          build ir.LoadConst(idx, DtInt),
                          build ir.LoadLocal(t_elem, arr_dt, nil),
                          after, eref);
          // JLS §10.6/§5.2: each initializer element is assignment-converted to
          // the element type (int literal → long/float/double element, etc.);
          // ref elements need no numeric conversion.
          let chain  = match (arr_dt) {
              DtRef  => gen(elems[idx], rho, locref(t_elem, eref),
                            single(store), store)
            | _other => cg_deliver_conv(elems[idx], arr_dt, rho, loc(t_elem, arr_dt),
                            single(store), store)
          };
          chain_array_init(elems, idx - 1, t_arr, arr_dt, eref, chain, rho); };
}

// InstanceOf emit. Same spill shape as ref cast but the result is
// SHORT (a 0/1 boolean), not the ref itself.
fun emit_instance_of(at: ir.atype, cp: int, op: ast.expr,
                      rho: rho, delta: delta, gamma: gamma,
                      Lnext: ir_root) -> ir_root {
    spill_or_simple(InstanceOfOp(at, cp), Effectful, op, DtRef,
                    rho, delta, gamma, Lnext);
}

// §15.19.2 reference-array instanceof: a static ref.test to the shared RefArray struct can't
// tell String[] from Integer[], so the element check is the RUNTIME `arrayClass.isInstance(x)`
// (Class.isInstance null-guards internally and defers to assignableFrom's §10.2 covariance).
fun emit_array_instanceof(array_class: int, op: ast.expr,
                          rho: rho, delta: delta, gamma: gamma,
                          Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(DtRef);
    let call = build ir.InvokeStatic(class_reflect_id(), class_is_instance_method(),
                    [build ir.LoadClass(array_class), build ir.LoadLocal(t, DtRef, nil)], DtShort);
    let _ = record_except_regions(call, rho);   // a CALL like any other (§11.1) — and the one
                                                 // place its target is recorded for the import list
    let deliver = cg_deliver_effectful(call, delta, gamma, Lnext);
    gen(op, rho, locref(t, expr_ref(op)), single(deliver), deliver);
}

// §5.5/§15.16 reference-array checkcast: null passes; otherwise the runtime element-precise
// `arrayClass.isInstance(x)` guards a structural ref.cast to the RefArray overlay (which then
// succeeds, x having been confirmed the right array type). A failure throws ClassCastException.
fun emit_array_cast(array_class: int, op: ast.expr,
                    rho: rho, delta: delta, gamma: gamma,
                    Lnext: ir_root) -> ir_root {
    let t = ddcg_alloc_temp(DtRef);
    // Every reference/multi-dim array is the RefArray overlay; the structural narrowing is to it.
    let ok_null = cg_deliver_effectful(
        build ir.CheckCast(build ir.LoadLocal(t, DtRef, nil), ir.AtClass, refarray_class()), delta, gamma, Lnext);
    let ok_inst = cg_deliver_effectful(
        build ir.CheckCast(build ir.LoadLocal(t, DtRef, nil), ir.AtClass, refarray_class()), delta, gamma, Lnext);
    let is_inst = build ir.InvokeStatic(class_reflect_id(), class_is_instance_method(),
                    [build ir.LoadClass(array_class), build ir.LoadLocal(t, DtRef, nil)], DtShort);
    let _ = record_except_regions(is_inst, rho);   // a CALL like any other (§11.1) — and the one
                                                    // place its target is recorded for the import list
    let guard = build ir.Branch(
        build ir.Eq(build ir.LoadLocal(t, DtRef, nil), build ir.LoadNull()),
        ok_null,
        build ir.Branch(is_inst, ok_inst, throw_new_noarg(sema_class_cast_exc_id(), rho)));
    // Same diamond as emit_ref_cast: ok_null/ok_inst share the γ continuation —
    // record it as a MERGE label for single-label γ (§2.1).
    let _ = match (gamma) { single(L) => record_scope(guard, L, 3) | _other => 0 };
    // Same null-literal rule as emit_ref_cast: the target here is the RefArray overlay both
    // arms narrow to. `(String[]) null` has no descriptor of its own either.
    let oref = expr_ref(op);
    gen(op, rho, locref(t, oref == nil ? build ir.ClassRef(refarray_class()) : oref),
        single(guard), guard);
}

// ── JLS §15.10 array creation (incl. multi-dimensional) ───────────────────
// `dims` holds one entry per bracket level; the leading `sized` non-NULL entries
// are allocated, trailing `[]` levels left null (jagged). A single sized dim is
// one array.new_default. For multiple sized dims, the sizes are evaluated once
// left-to-right (JLS §15.10.1) into temps, then each non-innermost level is
// filled by a synthesized loop allocating the sub-array per slot.

// Allocate `n` fresh int temps for the dimension sizes.
fun alloc_sz_temps(n: int) -> list<int> {
    n <= 0 ? [] : [ddcg_alloc_temp(DtInt)] + alloc_sz_temps(n - 1);
}

// §15.10.1: after all dimension sizes are evaluated, throw NegativeArraySizeException
// if ANY is negative — chain a neg-size guard over t_sz[k..sized) before allocating.
fun neg_size_guard_all(t_sz: list<int>, k: int, sized: int, ok: ir_root,
                       r: rho) -> ir_root {
    k >= sized ? ok
               : neg_size_guard(t_sz[k],
                                neg_size_guard_all(t_sz, k + 1, sized, ok, r), r);
}

// §10 RefArray: the array OPERAND for a ref-array op. A reference array is a
// RefArray struct, so its operand is `RefArray.data` (the backing top-ref array)
// via GetField; a primitive array (eref nil) is a concrete array — the operand is
// the array itself. `t_a` holds the (already spilled + null-checked) array ref.
fun array_backing(t_a: int, eref: ir_root, width: ir.datatype) -> ir_root {
    eref == nil
      ? build ir.GetField(DtRef, build ir.LoadLocal(t_a, DtRef, nil),
                          primarray_class_dt(width), primarray_data_field())  // prim: (per-width PrimArray).data → (array W)
      : build ir.GetField(DtRef, build ir.LoadLocal(t_a, DtRef, nil),
                          refarray_class(), refarray_data_field());           // ref: RefArray.data
}

// §10.2 / §15.10: `new T[size]` for a REFERENCE element T — build the RefArray
// wrapper: t_ra = new RefArray(); t_ra.data = new backing[size]. The backing is the
// top-ref array (NewRefArray with nil eref → array.new_default of the anyref array).
// elementClass stays null here (write-only until the §10.10 ArrayStore check). Mirrors
// new_expr's spill-then-init shape. §15.10.1 negative-size check on the evaluated size.
// Build `t_ra = new RefArray(); [t_ra.elementClass = <elem_class>.class;] t_ra.data =
// new backing[size]` (size an already-built i32 tree), chaining into `next`. Returns the
// head. `elem_class` is the component type's class id for the §10.10 ArrayStore check, or
// -1 to leave elementClass null (primitive/nested-array element — §10.8 array Class later).
fun build_refarray_into(t_ra: int, size: ir_root, elem_class: int, array_class: int,
                        in_loop: int, next: ir_root, r: rho) -> ir_root {
    let rc = refarray_class();
    // §10.8: overwrite the shared-overlay field-0 header with this array type's Class object.
    let hdr = array_class < 0 ? next
              : build ir.SetHeader(build ir.LoadLocal(t_ra, DtRef, build ir.ClassRef(rc)),
                                   build ir.LoadClass(array_class), rc, next);
    // The allocation node CARRIES ITS TYPE — the analysis names one abstract object per
    // allocation site and reads the site's type off the node (`array.new τ@site`).
    // NewRefArray's class_id IS the element class (see codegen_wasm.burg §10 RefArray);
    // codegen ignores it — the backing is always the one covariant top-ref array type,
    // because WASM-GC arrays are invariant while Java's are not — but γ types the node
    // from it, which is what gives an array value an exact component type. Passing 0 here
    // threw τ away at the site and left every array object untyped.
    let backing  = build ir.NewRefArray(elem_class, size, nil);
    let _        = record_alloc(backing, in_loop);
    let _        = record_except_regions(backing, r);   // §11.1: OOM is specified AT the `new`
    let set_data = build ir.PutField(DtRef,
                      build ir.LoadLocal(t_ra, DtRef, build ir.ClassRef(rc)),
                      rc, refarray_data_field(),
                      backing, hdr);
    let set_ec = elem_class < 0
        ? set_data
        : build ir.PutField(DtRef,
                      build ir.LoadLocal(t_ra, DtRef, build ir.ClassRef(rc)),
                      rc, refarray_elem_field(),
                      build ir.LoadClass(elem_class), set_data);
    let wrapper = build ir.New(rc);
    let _       = record_alloc(wrapper, in_loop);
    let _       = record_except_regions(wrapper, r);
    build ir.StoreLocal(t_ra, DtRef, build ir.ClassRef(rc), wrapper, set_ec);
}

fun cg_ref_array_new(size: ast.expr, elem_class: int, array_class: int, rho: rho, delta: delta,
                     gamma: gamma, Lnext: ir_root) -> ir_root {
    let rc    = refarray_class();
    let t_ra  = ddcg_alloc_temp(DtRef);
    let t_sz  = ddcg_alloc_temp(DtInt);
    let deliver = cg_store(build ir.LoadLocal(t_ra, DtRef, build ir.ClassRef(rc)),
                           delta, gamma, Lnext);
    let alloc   = build_refarray_into(t_ra, build ir.LoadLocal(t_sz, DtInt, nil), elem_class,
                                      array_class, rho_in_loop(rho), deliver, rho);
    let guarded = neg_size_guard(t_sz, alloc, rho);
    gen(size, rho, loc(t_sz, DtInt), single(guarded), guarded);
}

// §10.7 `new W[size]` for a PRIMITIVE element W — build the PrimArray wrapper:
// t_pa = new PrimArray(); t_pa.data = new (array W)[size] (a concrete array widened into
// the anyref data field). Mirrors build_refarray_into.
fun build_primarray_into(t_pa: int, atype: ir.atype, array_class: int, size: ir_root,
                         in_loop: int, next: ir_root, r: rho) -> ir_root {
    let pc = primarray_class_atype(atype);
    let hdr = array_class < 0 ? next   // §10.8: point field-0 at this array type's Class object
              : build ir.SetHeader(build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(pc)),
                                   build ir.LoadClass(array_class), pc, next);
    let backing  = build ir.NewArray(atype, size);
    let _        = record_alloc(backing, in_loop);
    let _        = record_except_regions(backing, r);   // §11.1: OOM is specified AT the `new`
    let set_data = build ir.PutField(DtRef,
                      build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(pc)),
                      pc, primarray_data_field(),
                      backing, hdr);
    let wrapper = build ir.New(pc);
    let _       = record_alloc(wrapper, in_loop);
    let _       = record_except_regions(wrapper, r);
    build ir.StoreLocal(t_pa, DtRef, build ir.ClassRef(pc), wrapper, set_data);
}

// The constant-contents twin of build_primarray_into: identical overlay (wrapper, header,
// `data` field), but the backing arrives already filled, so there is nothing to store after.
fun build_primarray_data_into(t_pa: int, atype: ir.atype, array_class: int,
                              byte_off: int, count: int,
                              in_loop: int, next: ir_root, r: rho) -> ir_root {
    let pc = primarray_class_atype(atype);
    let hdr = array_class < 0 ? next   // §10.8: point field-0 at this array type's Class object
              : build ir.SetHeader(build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(pc)),
                                   build ir.LoadClass(array_class), pc, next);
    let backing  = build ir.ArrayNewData(atype, 0, byte_off, count);
    let _        = record_alloc(backing, in_loop);
    let _        = record_except_regions(backing, r);   // §11.1: OOM is specified AT the `new`
    let set_data = build ir.PutField(DtRef,
                      build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(pc)),
                      pc, primarray_data_field(),
                      backing, hdr);
    let wrapper = build ir.New(pc);
    let _       = record_alloc(wrapper, in_loop);
    let _       = record_except_regions(wrapper, r);
    build ir.StoreLocal(t_pa, DtRef, build ir.ClassRef(pc), wrapper, set_data);
}

fun cg_prim_array_new(size: ast.expr, atype: ir.atype, array_class: int, rho: rho, delta: delta,
                      gamma: gamma, Lnext: ir_root) -> ir_root {
    let t_pa  = ddcg_alloc_temp(DtRef);
    let t_sz  = ddcg_alloc_temp(DtInt);
    let deliver = cg_store(build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(primarray_class_atype(atype))),
                           delta, gamma, Lnext);
    let alloc   = build_primarray_into(t_pa, atype, array_class,
                                       build ir.LoadLocal(t_sz, DtInt, nil),
                                       rho_in_loop(rho), deliver, rho);
    let guarded = neg_size_guard(t_sz, alloc, rho);
    gen(size, rho, loc(t_sz, DtInt), single(guarded), guarded);
}

// Build the allocation for the array at `level` (0 = outer). Its element is the
// base wrapped (rank-1-level) times — a primitive (eref nil → array.new of the
// base atype) or a reference/array (NewRefArray with the element referent). The
// innermost sized level just allocates (default-init); outer levels allocate then
// loop i in [0,size): t_arr[i] = <level+1>, delivering the filled array.
// `in_loop` says whether the allocations THIS level emits can run more than once.
// It is 1 when the whole `new` sits inside a user loop (ρ said so), and it is ALWAYS
// 1 for level > 0: an outer level fills itself by looping over its elements, so every
// inner level is emitted INSIDE that generated loop and its site produces one object
// per iteration. `new int[2][2][2]` is the case in point — the level-1 and level-2
// sites are summaries of 2 and 4 objects. Recording it here is the only honest place:
// we are the stage that emits the loop.
fun cg_alloc_level(node: ast.expr, level: int, sized: int, rank: int,
                   t_sz: list<int>, in_loop: int, rho: rho,
                   delta: delta, gamma: gamma,
                   Lnext: ir_root) -> ir_root {
    let eref  = array_eref_at(node, rank - 1 - level);
    let size  = build ir.LoadLocal(t_sz[level], DtInt, nil);
    level == sized - 1
      // Innermost sized level: a primitive leaf is one concrete array; a reference leaf
      // is the RefArray wrapper. Deliver it.
      ? (eref == nil
           ? { let t_pa = ddcg_alloc_temp(DtRef);
               let deliver = cg_store(build ir.LoadLocal(t_pa, DtRef, build ir.ClassRef(primarray_class_atype(array_base_atype(node)))),
                                      delta, gamma, Lnext);
               build_primarray_into(t_pa, array_base_atype(node), array_class_at(node, rank - level),
                                    size, in_loop, deliver, rho); }
           : { let t_ra = ddcg_alloc_temp(DtRef);
               let deliver = cg_store(build ir.LoadLocal(t_ra, DtRef, build ir.ClassRef(refarray_class())),
                                      delta, gamma, Lnext);
               build_refarray_into(t_ra, size, array_elem_class_at(node, rank - level - 1),
                                   array_class_at(node, rank - level), in_loop, deliver, rho); })
      // Outer level: its elements are arrays (a reference array), so it is a RefArray;
      // allocate the wrapper, then loop i in [0,size): t_arr.data[i] = <level+1>.
      : { let t_arr = ddcg_alloc_temp(DtRef);
          let t_i   = ddcg_alloc_temp(DtInt);
          let t_sub = ddcg_alloc_temp(DtRef);
          let exit  = cg_store(build ir.LoadLocal(t_arr, DtRef, nil), delta, gamma, Lnext);
          let Ltop  = build ir.Nop(nil);
          let back  = build ir.StoreLocal(t_i, DtInt, nil,
                         build ir.Add(DtInt, build ir.LoadLocal(t_i, DtInt, nil),
                                      build ir.LoadConst(1, DtInt)),
                         Ltop);
          let store = build ir.ArrayStore(DtRef,
                         array_backing(t_arr, eref, DtRef),
                         build ir.LoadLocal(t_i, DtInt, nil),
                         build ir.LoadLocal(t_sub, DtRef, nil),
                         back, eref);
          // The inner level is emitted INSIDE the fill loop built just above, so its
          // site runs once per element — a SUMMARY, whatever ρ said about the outside.
          let body  = cg_alloc_level(node, level + 1, sized, rank, t_sz, 1, rho,
                         locref(t_sub, eref), single(store), store);
          let _ = sir_set_next(Ltop, build ir.Branch(
                         build ir.Lt(build ir.LoadLocal(t_i, DtInt, nil),
                                     build ir.LoadLocal(t_sz[level], DtInt, nil)),
                         ddcg_label(body), ddcg_label(exit)));
          let _ = record_scope(Ltop, exit, 1);
          let init_i = build ir.StoreLocal(t_i, DtInt, nil,
                         build ir.LoadConst(0, DtInt), Ltop);
          build_refarray_into(t_arr, size, array_elem_class_at(node, rank - level - 1),
                              array_class_at(node, rank - level), in_loop, init_i, rho); };
}

// Evaluate the sized dimension expressions into t_sz left-to-right, then run the
// nested allocation (`alloc_head`). JLS §15.10.1: all dim exprs first, in order.
fun cg_eval_dims(node: ast.expr, t_sz: list<int>, k: int, sized: int,
                 alloc_head: ir_root, rho: rho) -> ir_root {
    k >= sized
      ? alloc_head
      : { let rest = cg_eval_dims(node, t_sz, k + 1, sized, alloc_head, rho);
          gen(array_dim(node, k), rho, loc(t_sz[k], DtInt), single(rest), rest); };
}

fun cg_new_array(node: ast.expr, rho: rho, delta: delta, gamma: gamma,
                 Lnext: ir_root) -> ir_root {
    let sized = array_sized_dims(node);
    let rank  = array_rank(node);
    let arr = sized <= 1
      ? { let eref = array_eref_at(node, rank - 1);
          eref == nil
            ? cg_prim_array_new(array_dim(node, 0), array_base_atype(node), array_class_id(node), rho, delta, gamma, Lnext)
            : cg_ref_array_new(array_dim(node, 0), array_elem_class(node), array_class_id(node), rho, delta, gamma, Lnext); }
      : { let t_sz = alloc_sz_temps(sized);
          let alloc_head = cg_alloc_level(node, 0, sized, rank, t_sz, rho_in_loop(rho), rho,
                              delta, gamma, Lnext);
          let guarded    = neg_size_guard_all(t_sz, 0, sized, alloc_head, rho);
          cg_eval_dims(node, t_sz, 0, sized, guarded, rho); };
    init_barrier(array_elem_class(node), arr, rho);   // §12.4.1 (JLS 1.0): creating an array of element class T inits T
}



// JLS §15.18.1 string concatenation, defunctionalized: `l + r` (both/either String) →
//   new StringBuffer().append(l).append(r).toString()
// as SIR — a fresh SB temp, the ctor, one append per operand (append returns `this`,
// so the result is dropped via ExprEffect), then toString() delivered to (δ, γ).
// Nested concats (a+b+c = (a+b)+c) recurse: an operand that is itself a concat gens
// as a String. Driven by the string_concat rule below.
fun build_concat(l: ast.expr, r: ast.expr,
                  rho: rho, delta: delta, gamma: gamma, Lnext: ir_root) -> ir_root {
    let sb      = sema_string_buffer_id();
    let init_cp = sema_sb_ctor_index();
    let tostr   = sema_sb_tostring_index();
    let app_l   = sema_sb_append_index(l);
    let app_r   = sema_sb_append_index(r);
    let pldt    = sema_param_dt(sb, app_l, 0);   // append(l)'s param type (drives §5.3 delivery)
    let prdt    = sema_param_dt(sb, app_r, 0);
    // A ref param's temp needs a concrete descriptor from the PARAM class (String or
    // Object) — a null operand has none of its own; nil for a primitive param.
    let lpc = sema_sb_append_param_class(l);
    let rpc = sema_sb_append_param_class(r);
    let ldesc = lpc < 0 ? nil : build ir.ClassRef(lpc);
    let rdesc = rpc < 0 ? nil : build ir.ClassRef(rpc);
    let t_sb = ddcg_alloc_temp(DtRef);
    let t_l  = ddcg_alloc_temp(pldt);
    let t_r  = ddcg_alloc_temp(prdt);
    // arg lists (the ddcg has no inline list literal as a call arg — build via `+ [x]`)
    let no_args: list<ir_root>     = [];
    let l_args = no_args + [build ir.LoadLocal(t_l, pldt, nil)];
    let r_args = no_args + [build ir.LoadLocal(t_r, prdt, nil)];
    // Every call and the allocation below are EXCEPTING points (§11.1) — the handler of an
    // enclosing region merges the state at each (§11.3.1, precise).
    // toString() → deliver the String result to (δ, γ)
    let tostr_call = build ir.InvokeVirtual(build ir.LoadLocal(t_sb, DtRef, nil),
                          sb, tostr, no_args, DtRef);
    let _ = record_except_regions(tostr_call, rho);
    let deliver = cg_deliver_effectful(tostr_call, delta, gamma, Lnext);
    // append(r) — returns `this`, dropped
    let ar = build ir.InvokeVirtual(build ir.LoadLocal(t_sb, DtRef, nil),
                  sb, app_r, r_args, DtRef);
    let _ = record_except_regions(ar, rho);
    let after_r = build ir.ExprEffect(ar, 0, deliver);
    let al = build ir.InvokeVirtual(build ir.LoadLocal(t_sb, DtRef, nil),
                  sb, app_l, l_args, DtRef);
    let _ = record_except_regions(al, rho);
    let after_l = build ir.ExprEffect(al, 0, after_r);
    // new StringBuffer().<init>()  (ctor is void — DtShort legacy convention)
    let ctor = build ir.InvokeSpecial(build ir.LoadLocal(t_sb, DtRef, nil),
                  sb, init_cp, no_args, DtShort);
    let _ = record_except_regions(ctor, rho);
    let after_ctor = build ir.ExprEffect(ctor, 1, after_l);
    let sb_new     = build ir.New(sb);
    let _          = record_except_regions(sb_new, rho);
    let after_new  = build ir.StoreLocal(t_sb, DtRef, build ir.ClassRef(sb),
                          sb_new, after_ctor);
    // evaluate operands left-to-right into their append-param-typed temps
    let after_rhs = cg_deliver_conv(r, prdt, rho, vloc(t_r, prdt, rdesc),
                          single(after_new), after_new);
    cg_deliver_conv(l, pldt, rho, vloc(t_l, pldt, ldesc),
                          single(after_rhs), after_rhs);
}

RULES

rule int_lit : ast.IntLit(value: v) {
    cg_store(build ir.LoadConst(v, dest_dt(delta, gamma)),
             delta, gamma, Lnext);
}

rule bool_lit : ast.BoolLit(value: v) {
    cg_store(build ir.LoadConst(v ? 1 : 0, DtShort), delta, gamma, Lnext);
}

rule null_lit : ast.NullLit() {
    cg_store(build ir.LoadNull(), delta, gamma, Lnext);
}

// §3.10.5 string literal. It must NOT reach codegen: sema rewrites every StringLit into
// `new String(chars).intern()` once §15.27 has had its chance to fold constant String
// expressions — folding is why the node survives the parser at all, and interning is why the
// folded result is a literal rather than a fresh object. Reaching here means that rewrite was
// skipped, which would silently produce a program with no String in it.
rule string_lit : ast.StringLit(chars: _) {
    panic_unreachable("string_lit: sema must desugar StringLit to new String(chars).intern()");
}

// char literal: an int32-representable constant, carried with DtChar.
rule char_lit : ast.CharLit(value: v) {
    cg_store(build ir.LoadConst(v, DtChar), delta, gamma, Lnext);
}

// long/float/double literals: width-carrying constant leaves.
rule long_lit : ast.LongLit(value: v) {
    cg_store(build ir.LoadLongConst(v), delta, gamma, Lnext);
}
rule float_lit : ast.FloatLit(value: v) {
    cg_store(build ir.LoadFloatConst(v), delta, gamma, Lnext);
}
rule double_lit : ast.DoubleLit(value: v) {
    cg_store(build ir.LoadDoubleConst(v), delta, gamma, Lnext);
}

// Bare `super` used as a value reference compiles same as `this`
// (both load slot 0, the receiver).
rule this_or_super : ast.This(), ast.Super() {
    cg_store(build ir.LoadThis(DtRef, current_class_id()), delta, gamma, Lnext);
}

// JLS §15.23/§15.24 — short-circuit And/Or have a γ-aware emit path
// in `binary_logical`. JLS §15.7.1 left-first ordering for the rest
// is preserved by binop_spilled (LHS captures before RHS evaluates,
// so `x + (x = 5)` reads pre-mod x).
rule binary_and : ast.Binary(op: And, lhs: l, rhs: r) {
    binary_logical(And, l, r, rho, delta, gamma, Lnext);
}
rule binary_or  : ast.Binary(op: Or,  lhs: l, rhs: r) {
    binary_logical(Or,  l, r, rho, delta, gamma, Lnext);
}

// JLS §15.18.1: `+` with a String operand is string concatenation. sema typed the
// node String; the ddcg DEFUNCTIONALIZES it (via build_concat, defined with the other
// helpers) into new StringBuffer().append(l).append(r).toString(). The guard falls
// through to the numeric binary rules when the `+` is not a concatenation.
rule string_concat : ast.Binary(op: Add, lhs: l, rhs: r) where sema_binary_is_concat(node) {
    build_concat(l, r, rho, delta, gamma, Lnext);
}
// Dybvig §3.2 Figure 8 case 1: both operands simple — emit the binop
// directly with inlined operand trees, no temps. Common for everyday
// `n == 0`, `i < len`, `a + b` — values that otherwise spill into two
// dead temp slots that click then has to GVN/DSE away.
rule binary_arith_ss : ast.Binary(op: op, lhs: l, rhs: r)
                       where is_simple_operand(l) and is_simple_operand(r)
                         and not is_guarded_intdiv(node) {
    let dt     = sema_data_type(node);
    let lhs_dt = sema_data_type_or(l, dt);
    let rhs_dt = sema_data_type_or(r, dt);
    let ct     = binop_ct(op, lhs_dt, rhs_dt);
    cg_store(binop_op_node(op, ct,
                            cg_promote(cg_operand_tree(l, lhs_dt), lhs_dt, ct),
                            cg_promote(cg_operand_tree(r, rhs_dt), rhs_dt, ct), rho),
             delta, gamma, Lnext);
}

// Dybvig §3.2 Figure 8 case 2: LHS constant-immutable, RHS complex —
// spill RHS to a temp, inline LHS. The case-2 RHS-first evaluation
// order would corrupt a slot-reading LHS if RHS mutates that slot
// (`x + (x = 5)`, JLS §15.7.1); restrict LHS to is_constant_operand
// to keep the left-first capture observable.
rule binary_arith_sc : ast.Binary(op: op, lhs: l, rhs: r)
                       where is_constant_operand(l) and not is_simple_operand(r)
                         and not is_guarded_intdiv(node) {
    let dt     = sema_data_type(node);
    let lhs_dt = sema_data_type_or(l, dt);
    let rhs_dt = sema_data_type_or(r, dt);
    let ct     = binop_ct(op, lhs_dt, rhs_dt);
    let t_rhs  = ddcg_alloc_temp(rhs_dt);
    let binop_head = cg_store(
        binop_op_node(op, ct,
                       cg_promote(cg_operand_tree(l, lhs_dt), lhs_dt, ct),
                       cg_promote(build ir.LoadLocal(t_rhs, rhs_dt, expr_ref(r)), rhs_dt, ct),
                       rho),
        delta, gamma, Lnext);
    gen(r, rho, vloc(t_rhs, rhs_dt, expr_ref(r)), single(binop_head), binop_head);
}

// Dybvig §3.2 Figure 8 case 3: LHS complex, RHS simple — spill LHS
// to a temp so JLS §15.7.1 captures it BEFORE the binop reads it
// (matters when LHS has side effects, e.g. `(i=3) * 2`); inline RHS.
rule binary_arith_cs : ast.Binary(op: op, lhs: l, rhs: r)
                       where not is_simple_operand(l) and is_simple_operand(r)
                         and not is_guarded_intdiv(node) {
    let dt     = sema_data_type(node);
    let lhs_dt = sema_data_type_or(l, dt);
    let rhs_dt = sema_data_type_or(r, dt);
    let ct     = binop_ct(op, lhs_dt, rhs_dt);
    let t_lhs  = ddcg_alloc_temp(lhs_dt);
    let binop_head = cg_store(
        binop_op_node(op, ct,
                       cg_promote(build ir.LoadLocal(t_lhs, lhs_dt, expr_ref(l)), lhs_dt, ct),
                       cg_promote(cg_operand_tree(r, rhs_dt), rhs_dt, ct),
                       rho),
        delta, gamma, Lnext);
    gen(l, rho, vloc(t_lhs, lhs_dt, expr_ref(l)), single(binop_head), binop_head);
}

// Dybvig §3.2 Figure 8 case 4: both operands complex — full spill.
// LHS captures to t_lhs before RHS evaluates, then the binop pulls
// both temps.
rule binary_arith : ast.Binary(op: op, lhs: l, rhs: r)
                    where not is_guarded_intdiv(node) {
    let dt     = sema_data_type(node);
    let lhs_dt = sema_data_type_or(l, dt);
    let rhs_dt = sema_data_type_or(r, dt);
    binop_spilled(op, l, r, lhs_dt, rhs_dt, rho, delta, gamma, Lnext);
}

// JLS §15.16.2 — integer / and % with a divisor-zero guard. Both operands spill
// (the guard branches on the divisor temp); on divisor==0 an ArithmeticException
// is thrown via the same New/ctor/Throw the frontend emits for `throw new X()`.
// For DIV, divisor==-1 takes `-a` to avoid WASM's INT_MIN/-1 overflow trap (Java
// wraps: MIN_VALUE / -1 == MIN_VALUE); REM never traps on -1 so needs no such arm.
rule binary_intdiv_guarded : ast.Binary(op: op, lhs: l, rhs: r)
                             where is_guarded_intdiv(node) {
    // Spill each operand at ITS OWN width, promote on read (§5.6.2) — the divisor
    // may be narrower than the result (`longLimit / intRadix`). The zero/-1 checks
    // run at the divisor's own width; the op reads both promoted to the result type.
    let dt     = sema_data_type(node);
    let lhs_dt = sema_data_type_or(l, dt);
    let rhs_dt = sema_data_type_or(r, dt);
    let ct     = binop_ct(op, lhs_dt, rhs_dt);
    let t_a    = ddcg_alloc_temp(lhs_dt);
    let t_b    = ddcg_alloc_temp(rhs_dt);
    let div_arm = match (op) {
        Div => div_overflow_arm(t_a, t_b, lhs_dt, rhs_dt, ct, delta, gamma, Lnext)
      | _rem => cg_store(build ir.Rem(ct,
                             cg_promote(build ir.LoadLocal(t_a, lhs_dt, nil), lhs_dt, ct),
                             cg_promote(build ir.LoadLocal(t_b, rhs_dt, nil), rhs_dt, ct)),
                         delta, gamma, Lnext)
    };
    // §11.4's worked output names the message as well as the class.
    let throw_arm = throw_new_msg(sema_arithmetic_exc_id(), "/ by zero", rho);
    let guard = build ir.Branch(
                    build ir.Eq(build ir.LoadLocal(t_b, rhs_dt, nil), zero_const(rhs_dt)),
                    throw_arm, div_arm);
    let _ = record_guard(guard, 4, t_b, 0 - 1, 1);   // divisor == 0; throws on TRUE
    // The guard's value arms (Neg/Div, or the sole Rem store) each deliver to δ and
    // converge on the SAME continuation. Record it as a MERGE label (§2.1) keyed by
    // the guard head, ONLY when that continuation is a single label L — the common
    // `local = a / b;`, where cg_store(single(L)) makes both arms' stores continue to
    // the one node L. The structurer emits L once; the arms reach it via the if/else
    // merge (no re-emitting the whole tail per arm — 8 sequential guarded divisions
    // otherwise blow up a civil-date calc to 305 KB). Other γ: for `ret` each arm
    // mints its OWN Return (cg_store ret ⇒ build ir.Return) — nothing shared, record
    // nothing; `pair` shares Lt/Lf, not the arm nodes. NEVER record a node synthesized
    // from cg_jump(γ) — that fabricates one on the ret/pair paths and miscompiles.
    let _ = match (gamma) {
        single(L) => record_scope(guard, L, 3)
      | _other    => 0
    };
    let rhs_chain = gen(r, rho, vloc(t_b, rhs_dt, expr_ref(r)), single(guard), guard);
    gen(l, rho, vloc(t_a, lhs_dt, expr_ref(l)), single(rhs_chain), rhs_chain);
}

// Ident lowering split per SEMA_IDENT_* kind. Locals and params share
// a body (both are LoadLocal); instance/static fields each get their
// own. The catch-all rule fires when sema didn't resolve the ident
// (also reported as a sema error; codegen falls through to LoadConst
// 0 defensively).
rule ident_local : ast.Ident() where ident_is_local_or_param(node) {
    cg_store(build ir.LoadLocal(sema_ident_slot(node),
                                 sema_ident_dt(node), sema_ident_ref(node)),
             delta, gamma, Lnext);
}
rule ident_instance_field : ast.Ident() where ident_is_instance_field(node) {
    cg_deliver_effectful(
        build ir.GetField(sema_ident_dt(node),
                          build ir.LoadThis(DtRef, current_class_id()),
                          sema_field_decl_class(node),
                          sema_field_index(node)),
        delta, gamma, Lnext);
}
rule ident_static_field_rule : ast.Ident() where ident_is_static_field(node) {
    ident_static_field(node, rho, delta, gamma, Lnext);
}
rule ident_unresolved : ast.Ident() {
    // Class-name idents (`T` in `T.staticField` / `T.staticMethod()`)
    // pass sema as `jt_class` but don't get an ident_kinds entry —
    // they're namespace markers, not value references. The enclosing
    // FieldAccess / MethodCall handles the actual lowering and only
    // compiles the obj in effect context if sema_may_have_effects
    // says so (and class names don't). Defensive LoadConst(0) here
    // covers any path that does ask for a value, matching legacy.
    cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext);
}

// JLS §14.6 — empty statement (`;`). No effect; just propagate to
// the parent's continuation.
rule empty : ast.Empty() { cg_jump(gamma, Lnext); }

// JLS §14.2 — block executes statements in textual order. Empty
// block falls through (no SIR). Non-empty: reverse-chain build per
// Dybvig §0.2 Figure 5.
rule block : ast.Block(stmts: ss) {
    ss.count == 0
      ? cg_jump(gamma, Lnext)
      : chain_block_stmts(ss, 0, ss.count - 1, rho, delta, gamma, Lnext);
}

// JLS §14.8 — expression statement evaluates its expression and
// discards the result. δ=effect; parent γ flows through.
rule expr_stmt : ast.ExprStmt(e: e) {
    gen(e, rho, effect, gamma, Lnext);
}

// JLS §14.17 — return without value (in void method) is a direct terminator.
//
// With a value, the choice is made by walking the WHOLE ρ chain, not by looking at the
// innermost frame: a `return` deep inside a loop still has to run every pending finally
// (§14.20.2), and still sits inside any enclosing try_table.
//
//   - Unprotected (no try_frame / finally_frame anywhere in ρ): deliver the value with
//     γ=ret, so cg_store emits Return(value, dt) and burg may tile a direct
//     Return(Invoke…) as `return_call` (the tail-call form).
//   - Protected: spill the value to a temp, walk ρ compiling every finally crossed, and
//     end in Return(LoadLocal(temp)). This shape can never tile as `return_call` — which
//     is the point. A tail call pops the current frame BEFORE the callee runs, taking this
//     frame's try_table handlers with it, so `try { return f(); } catch (E e) {…}` would
//     not catch an E thrown by f. It also gives the pending finallys somewhere to run.
rule return_stmt : ast.Return(value: v) {
    v == nil
      ? walk_finally_for_return(rho, build ir.ReturnVoid())
      : rho_in_protected(rho) == 0
          // Deliver with γ=ret, inserting the §5.2 widening to the method's return type.
          ? cg_deliver_conv(v, current_return_dt(), rho, effect, ret, Lnext)
          : { let dt    = current_return_dt();
              // `return null` carries no ref descriptor — type the spill temp from the return type.
              let rref  = expr_ref(v) == nil ? current_return_ref() : expr_ref(v);
              let t_ret = ddcg_alloc_temp(dt);
              let ret_node = build ir.Return(
                               build ir.LoadLocal(t_ret, dt, rref), dt);
              let fin_chain = walk_finally_for_return(rho, ret_node);
              cg_deliver_conv(v, dt, rho, vloc(t_ret, dt, rref),
                              single(fin_chain), fin_chain); };
}

// JLS §15.15 unary minus / bitwise complement / logical complement.
// Pos is a no-op (operand inherits parent dest). For the others:
//   - constant fold `-IntLit(v)` → `LoadConst(-v)` (matches legacy)
//   - cancellation fold `--x` → `x`, `!!x` → `x` (Neg / LogNot only;
//     BitNot is excluded — legacy plays safe around byte-precision
//     intermediates)
// JLS §15.15 — unary expressions, split per op into Treecc-style
// per-case rules. Pos is a no-op; Pre/Post Inc/Dec hand off to
// `incdec_emit` (which itself dispatches further on the target's
// AST shape); Neg/BitNot/LogNot route through `unary_op` which
// applies fold + cancellation + simple/spill emit.
rule unary_pos      : ast.Unary(op: Pos, e: inner) {
    gen(inner, rho, delta, gamma, Lnext);
}
// Pre/Post Inc/Dec — JLS §15.14, §15.15. Target dispatch via
// nested AST patterns + sema disambiguation (where-clauses for
// ident sub-cases the AST tag can't distinguish — local vs
// instance-field vs static-field). One rule per (op × target):
// six target shapes (ident-local, ident-instance-field,
// ident-static-field, FieldAccess-static, FieldAccess-instance,
// ArrayAccess) × four op variants = 24 rules.
//
// ──── Local / param ────
rule unary_pre_inc_local : ast.Unary(op: PreInc, e: inner)
                            where target_is_ident(inner) and ident_is_local_or_param(inner) {
    pre_local(sema_ident_slot(inner), sema_ident_dt(inner), 1,
              delta, gamma, Lnext);
}
rule unary_pre_dec_local : ast.Unary(op: PreDec, e: inner)
                            where target_is_ident(inner) and ident_is_local_or_param(inner) {
    pre_local(sema_ident_slot(inner), sema_ident_dt(inner), 0 - 1,
              delta, gamma, Lnext);
}
rule unary_post_inc_local : ast.Unary(op: PostInc, e: inner)
                             where target_is_ident(inner) and ident_is_local_or_param(inner) {
    post_local(sema_ident_slot(inner), sema_ident_dt(inner), 1,
               delta, gamma, Lnext);
}
rule unary_post_dec_local : ast.Unary(op: PostDec, e: inner)
                             where target_is_ident(inner) and ident_is_local_or_param(inner) {
    post_local(sema_ident_slot(inner), sema_ident_dt(inner), 0 - 1,
               delta, gamma, Lnext);
}

// ──── Unqualified Ident → static field (current class) ────
rule unary_pre_inc_ident_static_field : ast.Unary(op: PreInc, e: inner)
                                          where target_is_ident(inner) and ident_is_static_field(inner) {
    pre_ident_field(inner, true, sema_ident_dt(inner), 1,
                    current_class_id(), delta, gamma, Lnext);
}
rule unary_pre_dec_ident_static_field : ast.Unary(op: PreDec, e: inner)
                                          where target_is_ident(inner) and ident_is_static_field(inner) {
    pre_ident_field(inner, true, sema_ident_dt(inner), 0 - 1,
                    current_class_id(), delta, gamma, Lnext);
}
rule unary_post_inc_ident_static_field : ast.Unary(op: PostInc, e: inner)
                                           where target_is_ident(inner) and ident_is_static_field(inner) {
    post_ident_field(inner, true, sema_ident_dt(inner), 1,
                     current_class_id(), delta, gamma, Lnext);
}
rule unary_post_dec_ident_static_field : ast.Unary(op: PostDec, e: inner)
                                           where target_is_ident(inner) and ident_is_static_field(inner) {
    post_ident_field(inner, true, sema_ident_dt(inner), 0 - 1,
                     current_class_id(), delta, gamma, Lnext);
}

// ──── Unqualified Ident → instance field (this.field) ────
rule unary_pre_inc_ident_instance_field : ast.Unary(op: PreInc, e: inner)
                                            where target_is_ident(inner) and ident_is_instance_field(inner) {
    pre_ident_field(inner, false, sema_ident_dt(inner), 1,
                    current_class_id(), delta, gamma, Lnext);
}
rule unary_pre_dec_ident_instance_field : ast.Unary(op: PreDec, e: inner)
                                            where target_is_ident(inner) and ident_is_instance_field(inner) {
    pre_ident_field(inner, false, sema_ident_dt(inner), 0 - 1,
                    current_class_id(), delta, gamma, Lnext);
}
rule unary_post_inc_ident_instance_field : ast.Unary(op: PostInc, e: inner)
                                             where target_is_ident(inner) and ident_is_instance_field(inner) {
    post_ident_field(inner, false, sema_ident_dt(inner), 1,
                     current_class_id(), delta, gamma, Lnext);
}
rule unary_post_dec_ident_instance_field : ast.Unary(op: PostDec, e: inner)
                                             where target_is_ident(inner) and ident_is_instance_field(inner) {
    post_ident_field(inner, false, sema_ident_dt(inner), 0 - 1,
                     current_class_id(), delta, gamma, Lnext);
}

// ──── FieldAccess → static field (Cls.STATIC) ────
rule unary_pre_inc_field_static : ast.Unary(op: PreInc, e: inner)
                                    where target_is_static_field(inner) {
    pre_field_static(inner, sema_field_acc_dt(inner), 1,
                     sema_field_obj_class_id(inner), rho,
                     delta, gamma, Lnext);
}
rule unary_pre_dec_field_static : ast.Unary(op: PreDec, e: inner)
                                    where target_is_static_field(inner) {
    pre_field_static(inner, sema_field_acc_dt(inner), 0 - 1,
                     sema_field_obj_class_id(inner), rho,
                     delta, gamma, Lnext);
}
rule unary_post_inc_field_static : ast.Unary(op: PostInc, e: inner)
                                     where target_is_static_field(inner) {
    post_field_static(inner, sema_field_acc_dt(inner), 1,
                      sema_field_obj_class_id(inner), rho,
                      delta, gamma, Lnext);
}
rule unary_post_dec_field_static : ast.Unary(op: PostDec, e: inner)
                                     where target_is_static_field(inner) {
    post_field_static(inner, sema_field_acc_dt(inner), 0 - 1,
                      sema_field_obj_class_id(inner), rho,
                      delta, gamma, Lnext);
}

// ──── FieldAccess → instance field (obj.field) ────
rule unary_pre_inc_field_instance : ast.Unary(op: PreInc, e: inner)
                                      where target_is_instance_field(inner) {
    pre_field_instance(field_acc_obj(inner), inner,
                       sema_field_acc_dt(inner), 1,
                       sema_field_obj_class_id(inner),
                       rho, delta, gamma, Lnext);
}
rule unary_pre_dec_field_instance : ast.Unary(op: PreDec, e: inner)
                                      where target_is_instance_field(inner) {
    pre_field_instance(field_acc_obj(inner), inner,
                       sema_field_acc_dt(inner), 0 - 1,
                       sema_field_obj_class_id(inner),
                       rho, delta, gamma, Lnext);
}
rule unary_post_inc_field_instance : ast.Unary(op: PostInc, e: inner)
                                       where target_is_instance_field(inner) {
    post_field_instance(field_acc_obj(inner), inner,
                        sema_field_acc_dt(inner), 1,
                        sema_field_obj_class_id(inner),
                        rho, delta, gamma, Lnext);
}
rule unary_post_dec_field_instance : ast.Unary(op: PostDec, e: inner)
                                       where target_is_instance_field(inner) {
    post_field_instance(field_acc_obj(inner), inner,
                        sema_field_acc_dt(inner), 0 - 1,
                        sema_field_obj_class_id(inner),
                        rho, delta, gamma, Lnext);
}

// ──── ArrayAccess → arr[idx] ────
rule unary_pre_inc_array : ast.Unary(op: PreInc, e: inner)
                            where target_is_array_access(inner) {
    pre_array_access(array_acc_arr(inner), array_acc_index(inner),
                     sema_array_acc_dt(inner), 1,
                     rho, delta, gamma, Lnext);
}
rule unary_pre_dec_array : ast.Unary(op: PreDec, e: inner)
                            where target_is_array_access(inner) {
    pre_array_access(array_acc_arr(inner), array_acc_index(inner),
                     sema_array_acc_dt(inner), 0 - 1,
                     rho, delta, gamma, Lnext);
}
rule unary_post_inc_array : ast.Unary(op: PostInc, e: inner)
                             where target_is_array_access(inner) {
    post_array_access(array_acc_arr(inner), array_acc_index(inner),
                      sema_array_acc_dt(inner), 1,
                      rho, delta, gamma, Lnext);
}
rule unary_post_dec_array : ast.Unary(op: PostDec, e: inner)
                             where target_is_array_access(inner) {
    post_array_access(array_acc_arr(inner), array_acc_index(inner),
                      sema_array_acc_dt(inner), 0 - 1,
                      rho, delta, gamma, Lnext);
}
rule unary_op_rule  : ast.Unary(op: op, e: inner) {
    // Catch-all for Neg / BitNot / LogNot — kept generic in op since
    // unary_op's internal fold/cancellation logic dispatches on op.
    unary_op(op, inner, rho, delta, gamma, Lnext);
}

// JLS §10.7 + §15.11.1 — FieldAccess split per sub-form. Array.length
// is an intrinsic (sir_array_length, not get_field). Static fields
// emit GetStatic with optional inline-from-constant; instance fields
// emit GetField with obj spill when non-simple. Order matters: the
// array-length guard fires before the static/instance distinction.
rule field_access_array_length : ast.FieldAccess(obj: obj, field: f)
                                 where fieldacc_is_array_length(node) {
    array_length_acc(obj, rho, delta, gamma, Lnext);
}
rule field_access_static : ast.FieldAccess(obj: obj, field: f)
                            where fieldacc_is_static(node) {
    static_field_acc(obj, node, rho, delta, gamma, Lnext);
}
rule field_access_instance : ast.FieldAccess(obj: obj, field: f) {
    instance_field_acc(obj, node, rho, delta, gamma, Lnext);
}

// JLS §15.13 — array element read. Spills arr / idx to temps when
// non-simple, JLS-order (arr first, then index). ArrayLoad is BURS-
// dispatched on the element dt: aaload / baload / saload / iaload.

// JLS §15.10 — array creation (incl. multi-dimensional). Lowering built by the
// cg_new_array fun family (defined before the RULES section).
rule new_array : ast.NewArray(element: el, dims: ds) {
    cg_new_array(node, rho, delta, gamma, Lnext);
}

// JLS §15.16 — cast. Sema's `sema_cast_kind` returns the
// emission case directly (one variant per conv opcode + per atype/cp
// combination). ddcgc enforces match exhaustiveness. The src_dt
// lookup stays in the rule body since it's used by every numeric-
// conv arm and cleaner to compute once.
rule cast : ast.Cast(ty: ty, e: inner) {
    let src_dt = sema_data_type_or(inner, sema_data_type(node));
    match (sema_cast_kind(node)) {
        CastIdentity      => gen(inner, rho, delta, gamma, Lnext)
      | CastS2I           => spill_or_simple(S2IOp, Pure, inner, src_dt,
                                              rho, delta, gamma, Lnext)
      | CastI2S           => spill_or_simple(I2SOp, Pure, inner, src_dt,
                                              rho, delta, gamma, Lnext)
      | CastS2B           => spill_or_simple(S2BOp, Pure, inner, src_dt,
                                              rho, delta, gamma, Lnext)
      | CastI2B           => spill_or_simple(I2BOp, Pure, inner, src_dt,
                                              rho, delta, gamma, Lnext)
      | CastI2C => spill_or_simple(I2COp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastI2L => spill_or_simple(I2LOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastI2F => spill_or_simple(I2FOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastI2D => spill_or_simple(I2DOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2I => spill_or_simple(L2IOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2F => spill_or_simple(L2FOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2D => spill_or_simple(L2DOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2I => spill_or_simple(F2IOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2L => spill_or_simple(F2LOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2D => spill_or_simple(F2DOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2I => spill_or_simple(D2IOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2L => spill_or_simple(D2LOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2F => spill_or_simple(D2FOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2B => spill_or_simple(L2BOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2S => spill_or_simple(L2SOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastL2C => spill_or_simple(L2COp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2B => spill_or_simple(F2BOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2S => spill_or_simple(F2SOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastF2C => spill_or_simple(F2COp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2B => spill_or_simple(D2BOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2S => spill_or_simple(D2SOp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      | CastD2C => spill_or_simple(D2COp, Pure, inner, src_dt, rho, delta, gamma, Lnext)
      // §5.5 class/interface + precise primitive-array cast: ref.cast the overlay struct (cp is
      // the value class the lattice resolved). Reference/multi-dim arrays go through the runtime
      // Class.isInstance guard (element-precise) before the structural ref.cast to RefArray.
      | CastClass(cp: cp) => emit_ref_cast(ir.AtClass, cp, inner,
                                            rho, delta, gamma, Lnext)
      | CastArrayReflect(cp: ac) =>
            emit_array_cast(ac, inner, rho, delta, gamma, Lnext)
      | CastNoop          => gen(inner, rho, delta, gamma, Lnext)
    };
}

// JLS §15.20.2 — instanceof. Sema classifies; ddcg matches with
// exhaustiveness. ClassType / NameType / QualifiedName all collapse
// into InstanceOfClass at sema time, so ddcg sees one variant for
// "class instanceof" regardless of how the source named the type.
rule instance_of : ast.InstanceOf(e: inner, ty: ty) {
    match (sema_instanceof_kind(node)) {
        InstanceOfClass(cp: cp) => emit_instance_of(ir.AtClass, cp, inner,
                                                     rho, delta, gamma, Lnext)
      | InstanceOfArrayReflect(cp: ac) =>
            emit_array_instanceof(ac, inner, rho, delta, gamma, Lnext)
      | InstanceOfAlwaysFalse   =>
            cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext)
    };
}

// JLS §14.20 — try / catch / finally. The body executes under
// `body_rho` which wraps the parent ρ with a finally_frame when a
// finally is present, so return/break/continue inside the body
// automatically run the finally before transferring out. Each catch
// handler also compiles under body_rho for the same reason.
//
// Normal-exit paths (body falls through, handler falls through) get
// an explicit inline finally chain ending at l_join — there is
// no built-in "run finally on normal exit," so we splice it.
//
// The catch-all rethrow (when finally exists) wraps everything in
// an outer TryRegion: any uncaught exception lands in the catch-all,
// runs finally, then re-throws. This matches §6.9.1's "catch_type=0"
// finally sentinel.
//
// TryRegion chain order: typed catches in source order (innermost-
// first wraps body, getting smallest handler_pc); catch-all wraps
// last, getting the largest handler_pc.
rule try_stmt : ast.Try(body: body, catches: catches, finally_: f) {
    // l_join: where all normal-exit paths converge. Falls through to the parent's continuation
    // derived from γ — but only if the try statement can complete normally at all. §14.19: it can
    // iff (the try block can complete normally or some catch block can) and (any finally can too).
    // When it cannot, no path leaves this statement, so l_join has no successor and the parent's
    // continuation is never built. `try { for(;;) {…} } finally {…}` is the case that forces this:
    // both the try block and the statement lack a normal completion.
    let l_join = sema_can_complete_normally(node)
      ? build ir.Nop(match (gamma) {
            single(L)  => L
          | ret        => build ir.ReturnVoid()
          | _other     => Lnext
        })
      : nil;

    // This try's REGION ID — allocated HERE, before the body is compiled, because the
    // Throws inside the body must name the region while its ExceptionEntry handlers do
    // not exist yet (they are built below, wrapping the compiled body). The handler rows
    // carry the same id; the escape lattice joins on it. Spec §6.
    let region = next_region_id();

    // The try BODY is inside the try_table, so it is protected either way: finally_frame
    // when there is a finally (it also carries the body to run on the way out), else a
    // payload-free try_frame. Both carry `region` — a Throw in the body IS covered by
    // this try's handlers.
    //
    // Catch bodies are emitted PAST the try_table's end, so they are NOT protected by it
    // — they only inherit a pending finally, if any. Their frame therefore carries region
    // -1: "this frame has no handlers". A Throw in a catch body records no row for it and
    // is covered only by whatever ENCLOSES this try, which is exactly what ρ's parent
    // chain already says. Claiming `region` here would tell the escape lattice that a
    // throw from a catch body is caught by the try it just escaped from — fail-OPEN, and
    // wrong.
    let body_rho = f == nil
      ? try_frame(region, rho)
      : finally_frame(f, region, rho);
    let catch_rho = f == nil
      ? rho
      : finally_frame(f, 0 - 1, rho);

    // Normal exits run finally inline (compiled under PARENT rho so
    // any return/throw inside finally walks the parent's pending
    // finally stack — not this one, which is being executed).
    let normal_exit   = try_inline_finally(f, rho, l_join);
    let body_compiled = gen(body, body_rho, effect,
                              single(normal_exit), normal_exit);
    // Not a control merge — nothing branches here. It is the try REGION's start anchor: a stable,
    // addressable node whose emitted position `record_try_region` carries to the backend. (The body's
    // own head may be a value node, which has no position of its own.)
    let try_start     = build ir.Nop(body_compiled);

    // Wrap with each typed catch (innermost-first build = source
    // order). After this, entry_chain has all typed handlers in
    // ascending handler_pc layout.
    let after_catches = build_catch_chain(catches, 0, try_start,
                                            catch_rho, rho, l_join,
                                            f, try_start, region);

    // The outermost region is ALWAYS the catch-all: it is where an exception matching no
    // typed catch lands. Its body runs finally (if any) inline, then re-throws (Throw) —
    // the rethrow-on-no-match. It is NOT a catch clause (JLS §11.3: an exception matching
    // no catch clause LEAVES the try; the finally runs "during propagation"), so its
    // ExceptionEntry carries catch_class_id = -1 — the asdl's "no type info (finally /
    // throwable-catch)". Anything asking "does this handler catch?" reads that.
    //
    // Its LANDING TYPE is still (ref null Throwable) — but that is a REPRESENTATION
    // question, and it is the type lattice's to answer (lat_handler_landing_class), not
    // ours to smuggle through the semantic field. Writing throw_id here is what erased the
    // -1 and cost §6's escape rule its only way to tell a real catch from this one.
    //
    // The RETHROW is recorded against the PARENT ρ, not this region: it runs INSIDE this
    // try's handler, so this try cannot catch it — it leaves the statement, and only an
    // enclosing region can. (The exception object it re-throws therefore escapes unless
    // something further out catches it, which is precisely what ρ's parent chain says.)
    let result = { let ex_tmp     = ddcg_alloc_temp(DtRef);
          let throw_id   = sema_throwable_class_id();
          let rethrow    = build ir.Throw(
                             build ir.LoadLocal(ex_tmp, DtRef,
                               build ir.ClassRef(throw_id)));
          let _          = record_except_regions(rethrow, rho);
          let fin_except = f == nil
                             ? rethrow
                             : gen(f, rho, effect, single(rethrow), rethrow);
          let catchall   = build ir.ExceptionEntry(ex_tmp, 0 - 1,
                                                    fin_except);
          let _          = record_try_region(try_start, catchall, 0, region);
          build ir.TryRegion(catchall, after_catches); };
    // Carry l_join forward keyed by the OUTERMOST try-region node (the one the
    // backend first meets), as the if does with its test head. Chained inner
    // catch regions get no record — they inherit l_join via the region `stop`.
    let _ = record_scope(result, l_join, 0);
    // The handlers exist NOW — stamp the exception continuation onto every node
    // recorded excepting under this region (spec §1's γ, on the node itself).
    let _ = patch_excepts(region, result);
    result;
}

// JLS §14.18 — `throw e`. Spills e to a ref temp when non-simple,
// then emits SIR_THROW. No finally walk — the JVM exception table
// installs catch-all handlers for try/finally, which run finally
// before re-throwing.
rule throw_stmt : ast.Throw(e: e) {
    let t_e = ddcg_alloc_temp(DtRef);
    let throw_node = build ir.Throw(build ir.LoadLocal(t_e, DtRef, nil));
    // §6: the regions enclosing this throw, straight off ρ. WE know them.
    let _ = record_except_regions(throw_node, rho);
    // §14.18.2: any pending finally this throw is NOT protected by runs before it propagates.
    // The value is evaluated FIRST — the try completes abruptly "because of a throw of a value
    // V", so V exists before the finally runs, which is why the chain is gen(e) → finallies →
    // Throw and not the other way round.
    let fin_chain = walk_finally_for_throw(rho, throw_node);
    gen(e, rho, locref(t_e, expr_ref(e)), single(fin_chain), fin_chain);
}

// JLS §15.12 — `super.m(args)`. invokespecial on parent class with
// `this` as receiver. SIR encodes the return type as DtShort
// regardless of actual return (legacy convention), since cg_deliver
// uses dt to drive the spine StoreLocal.
rule super_call : ast.SuperCall(method: m, args: as) {
    let parent = sema_super_parent_class_id();
    (not sema_super_method_resolved(node)) or (parent < 0)
      ? cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext)
      : { let cp        = sema_method_index(node);
          let cp_safe   = cp >= 0 ? cp : 0;
          // §15.11 invokespecial targets the resolved super method's DECLARING class, which
          // may be an ANCESTOR of the immediate super (e.g. Hashtable→super.clone() resolves to
          // Object.clone, declared in Object, not the immediate super Dictionary). The class and
          // the method index must name the SAME class — using the immediate super here pairs a
          // grandparent's index with the parent's methods vec (a wrong-class funcref).
          let decl      = sema_method_decl_class(node);
          let scls      = decl >= 0 ? decl : parent;
          let dt        = sema_invoke_dt(node);
          let is_void   = sema_invoke_is_void(node);
          let t_args:    list<int>         = [];
          let arg_dts:   list<ir.datatype> = [];
          let arg_loads: list<ir_root>     = [];
          for (i, _) in as {
              let adt = sema_param_dt(scls, cp_safe, i);   // param type → §5.3 widening
              let ts  = ddcg_alloc_temp(adt);
              t_args    := t_args + [ts];
              arg_dts   := arg_dts + [adt];
              arg_loads := arg_loads + [build ir.LoadLocal(ts, adt, nil)];
          }
          let invoke  = build ir.InvokeSpecial(
                          build ir.LoadLocal(0, DtRef, nil),
                          scls, cp_safe,
                          arg_loads, DtShort);
          let _        = record_except_regions(invoke, rho);
          let delivery = call_delivery(invoke, is_void, dt,
                                        delta, gamma, Lnext);
          chain_call_args(as, as.count - 1, t_args, arg_dts, scls, cp_safe, delivery, rho); };
}

// `super(args)` / `this(args)` constructor invocation. Always void;
// invokespecial on the resolved class with `this` as receiver.
rule constructor_call : ast.ConstructorCall(args: as) {
    let target_class = sema_ctor_call_target_class(node);
    target_class < 0
      ? cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext)
      : { let cp        = sema_method_index(node);
          let cp_safe   = cp >= 0 ? cp : 0;
          let t_args:    list<int>         = [];
          let arg_dts:   list<ir.datatype> = [];
          let arg_loads: list<ir_root>     = [];
          for (i, _) in as {
              let adt = sema_param_dt(target_class, cp_safe, i);   // param type → §5.3 widening
              let ts  = ddcg_alloc_temp(adt);
              t_args    := t_args + [ts];
              arg_dts   := arg_dts + [adt];
              arg_loads := arg_loads + [build ir.LoadLocal(ts, adt, nil)];
          }
          let invoke  = build ir.InvokeSpecial(
                          build ir.LoadLocal(0, DtRef, nil),
                          target_class, cp_safe,
                          arg_loads, DtShort);
          let _ = record_except_regions(invoke, rho);
          let tail = match (gamma) {
              ret        => build ir.ReturnVoid()
            | single(L)  => L
            | _other     => Lnext
          };
          let effect = build ir.ExprEffect(invoke, 1, tail);
          chain_call_args(as, as.count - 1, t_args, arg_dts, target_class, cp_safe, effect, rho); };
}

// JLS §15.9 — `new C(args)`. Allocates a fresh ref into t_obj, then
// (when sema resolved a constructor CP) invokes <init> with t_obj as
// receiver and args, finally delivers t_obj as the value. Args
// evaluate left-to-right per JLS §15.12.4.4. Constructors return
// void → ExprEffect drops the result.
rule new_expr : ast.New(class_: cls, args: as) {
    let target_class = sema_new_target_class(node);
    target_class < 0
      ? cg_store(build ir.LoadNull(), delta, gamma, Lnext)
      : { let ctor_cp  = sema_new_ctor_cp(node);
          // Receiver before args (legacy alloc order).
          let t_obj    = ddcg_alloc_temp(DtRef);
          let delivery = cg_store(build ir.LoadLocal(t_obj, DtRef, nil),
                                   delta, gamma, Lnext);
          // The New node carries the CLASS id (struct.new $class) — never a
          // method index.
          let new_node = build ir.New(target_class);
          // We are the stage that knows whether this site sits in a loop (ρ says
          // so). One abstract object per SITE, so a looping site is a SUMMARY.
          let _ = record_alloc(new_node, rho_in_loop(rho));
          // …and ρ also says which regions enclose it. §11.1 specifies OutOfMemoryError
          // AT the allocation ("some limitation on a resource is exceeded"), so this is an
          // excepting point and an enclosing handler merges the state here (§11.3.1).
          let _ = record_except_regions(new_node, rho);
          let cons = ctor_cp < 0
            ? build ir.StoreLocal(t_obj, DtRef, expr_ref(node), new_node, delivery)
            : { let t_args:    list<int>         = [];
                let arg_dts:   list<ir.datatype> = [];
                let arg_loads: list<ir_root>     = [];
                for (i, _) in as {
                    let adt = sema_param_dt(target_class, ctor_cp, i);   // param type → §5.3 widening
                    let ts  = ddcg_alloc_temp(adt);
                    t_args    := t_args + [ts];
                    arg_dts   := arg_dts + [adt];
                    arg_loads := arg_loads + [build ir.LoadLocal(ts, adt, nil)];
                }
                let init_call = build ir.InvokeSpecial(
                                    build ir.LoadLocal(t_obj, DtRef, nil),
                                    target_class, ctor_cp,
                                    arg_loads, DtShort);
                let _ = record_except_regions(init_call, rho);
                let init_effect = build ir.ExprEffect(init_call, 1, delivery);
                let chain = chain_call_args(as, as.count - 1,
                                             t_args, arg_dts, target_class, ctor_cp,
                                             init_effect, rho);
                build ir.StoreLocal(t_obj, DtRef, expr_ref(node), new_node, chain); };
          init_barrier(target_class, cons, rho); };   // §12.4.1: `new T` initializes T
}

// JLS §15.12 — method invocation. The §0.2 receiver-first lowering:
//   evaluate receiver into t_recv, then args left-to-right into
//   t_args[i], finally invoke. Spilling everything to temps preserves
//   JLS §15.12.4.4 evaluation order under non-simple sub-expressions.
// Static methods skip the receiver. Void methods drop the value via
// ExprEffect; non-void deliver to (δ, γ) via cg_deliver_effectful.
// §20.18.16 System.arraycopy(src, srcOff, dst, dstOff, len) → a `SIR_ARRAYCOPY` (WASM
// array.copy) intrinsic. Width/backing come from the static SRC array type (as[0]); both
// arrays share the overlay (the incompatible-type / erased-Object case is deferred). JLS
// order: eval the 5 args left-to-right into temps → NPE(src) → NPE(dst) → IndexOutOfBounds
// (offsets/len) → array.copy (overlap-safe). arraycopy is void → continue via cg_jump.
// java.lang.Float/Double raw bit accessors → a typed bitcast (Move* node), not a call.
// The single argument is the value; the Move node reinterprets its bits into the other domain.
rule move_intrinsic : ast.MethodCall(obj: rcvr, method: m, args: as)
                      where sema_is_move_intrinsic(node) {
    match (sema_move_intrinsic_kind(node)) {
        1      => spill_or_simple(MoveF2IOp, Pure, as[0], DtFloat,  rho, delta, gamma, Lnext)
      | 2      => spill_or_simple(MoveI2FOp, Pure, as[0], DtInt,    rho, delta, gamma, Lnext)
      | 3      => spill_or_simple(MoveD2LOp, Pure, as[0], DtDouble, rho, delta, gamma, Lnext)
      | _other => spill_or_simple(MoveL2DOp, Pure, as[0], DtLong,   rho, delta, gamma, Lnext)
    };
}

// §20.11 Math.sqrt/floor/ceil/rint → the f64 wasm opcode (all take one double operand).
rule math_intrinsic : ast.MethodCall(obj: rcvr, method: m, args: as)
                      where sema_is_math_intrinsic(node) {
    match (sema_math_intrinsic_kind(node)) {
        1      => spill_or_simple(F64SqrtOp,    Pure, as[0], DtDouble, rho, delta, gamma, Lnext)
      | 2      => spill_or_simple(F64FloorOp,   Pure, as[0], DtDouble, rho, delta, gamma, Lnext)
      | 3      => spill_or_simple(F64CeilOp,    Pure, as[0], DtDouble, rho, delta, gamma, Lnext)
      | _other => spill_or_simple(F64NearestOp, Pure, as[0], DtDouble, rho, delta, gamma, Lnext)
    };
}

// javelina.simd — every generated intrinsic lowers inline to its SIMD family
// node; the op payload is the WOP_* value off the generated table, the lane /
// const / mask immediates were validated and stashed by sema (a constant has
// no effects, so skipping its evaluation preserves JLS 15.12.4.4 order).
// Value args spill to temps left-to-right, mirroring spill_or_simple; Pure —
// SIMD value ops cannot throw, so no exception region is recorded.
rule simd_intrinsic : ast.MethodCall(obj: rcvr, method: m, args: as)
                      where sema_is_simd_intrinsic(node) {
    let op = sema_simd_op(node);
    match (sema_simd_family(node)) {
        1  => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdBin(op,
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtV128, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtV128), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 2  => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdUn(op,
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 3  => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.SimdShift(op,
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtInt, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtInt), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 4  => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtV128);
                let t2 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdTern(op,
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtV128, nil),
                               build ir.LoadLocal(t2, DtV128, nil)), delta, gamma, Lnext);
                let m2 = gen(as[2], rho, loc(t2, DtV128), single(head), head);
                let m1 = gen(as[1], rho, loc(t1, DtV128), single(m2), m2);
                gen(as[0], rho, loc(t0, DtV128), single(m1), m1); }
      | 5  => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdTestI(op,
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 6  => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.SimdSplatI(op,
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtInt), single(head), head); }
      | 7  => { let t0 = ddcg_alloc_temp(DtLong);
                let head = deliver_tree(Pure, build ir.SimdSplatL(op,
                               build ir.LoadLocal(t0, DtLong, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtLong), single(head), head); }
      | 8  => { let t0 = ddcg_alloc_temp(DtFloat);
                let head = deliver_tree(Pure, build ir.SimdSplatF(op,
                               build ir.LoadLocal(t0, DtFloat, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtFloat), single(head), head); }
      | 9  => { let t0 = ddcg_alloc_temp(DtDouble);
                let head = deliver_tree(Pure, build ir.SimdSplatD(op,
                               build ir.LoadLocal(t0, DtDouble, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtDouble), single(head), head); }
      | 10 => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdExtractI(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 11 => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdExtractL(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 12 => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdExtractF(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 13 => { let t0 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdExtractD(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtV128), single(head), head); }
      | 14 => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.SimdReplaceI(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtInt, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtInt), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 15 => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtLong);
                let head = deliver_tree(Pure, build ir.SimdReplaceL(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtLong, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtLong), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 16 => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtFloat);
                let head = deliver_tree(Pure, build ir.SimdReplaceF(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtFloat, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtFloat), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 17 => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtDouble);
                let head = deliver_tree(Pure, build ir.SimdReplaceD(op, sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtV128, nil),
                               build ir.LoadLocal(t1, DtDouble, nil)), delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtDouble), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
      | 18 => { let n = build ir.SimdConst(0, 0);
                let _ = sema_simd_fill(n, node);
                deliver_tree(Pure, n, delta, gamma, Lnext); }
      // v128 linear-memory ops over the I/O-floor staging memory. Loads are
      // values (mutable reads — the MemLoad8 posture); stores are spine
      // statements (the memstore8_intrinsic shape). align rides the node.
      | 20 => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.SimdMemLoad(op, sema_simd_align(node),
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                gen(as[0], rho, loc(t0, DtInt), single(grd), grd); }
      | 21 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtV128);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.SimdMemStore(op, sema_simd_align(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtV128, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtV128), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      | 22 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtV128);
                let head = deliver_tree(Pure, build ir.SimdMemLoadLane(op, sema_simd_align(node),
                               sema_simd_lane(node),
                               build ir.LoadLocal(t0, DtInt, nil),
                               build ir.LoadLocal(t1, DtV128, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                let mid = gen(as[1], rho, loc(t1, DtV128), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(mid), mid); }
      | 23 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtV128);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.SimdMemStoreLane(op, sema_simd_align(node),
                                sema_simd_lane(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtV128, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtV128), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      // Scalar linear-memory family (op selects the width/sign variant).
      | 24 => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.MemLoadI(op, sema_simd_align(node),
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                gen(as[0], rho, loc(t0, DtInt), single(grd), grd); }
      | 25 => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.MemLoadL(op, sema_simd_align(node),
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                gen(as[0], rho, loc(t0, DtInt), single(grd), grd); }
      | 26 => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.MemLoadF(op, sema_simd_align(node),
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                gen(as[0], rho, loc(t0, DtInt), single(grd), grd); }
      | 27 => { let t0 = ddcg_alloc_temp(DtInt);
                let head = deliver_tree(Pure, build ir.MemLoadD(op, sema_simd_align(node),
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), head, rho);
                gen(as[0], rho, loc(t0, DtInt), single(grd), grd); }
      | 28 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtInt);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.MemStoreI(op, sema_simd_align(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtInt, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtInt), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      | 29 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtLong);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.MemStoreL(op, sema_simd_align(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtLong, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtLong), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      | 30 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtFloat);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.MemStoreF(op, sema_simd_align(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtFloat, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtFloat), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      | 31 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtDouble);
                let done  = cg_jump(gamma, Lnext);
                let store = build ir.MemStoreD(op, sema_simd_align(node),
                                build ir.LoadLocal(t0, DtInt, nil),
                                build ir.LoadLocal(t1, DtDouble, nil), done);
                let grd = mem_bounds_guard(t0, sema_simd_awidth(node), store, rho);
                let dv = gen(as[1], rho, loc(t1, DtDouble), single(grd), grd);
                gen(as[0], rho, loc(t0, DtInt), single(dv), dv); }
      | 32 => { deliver_tree(Pure, build ir.MemSize(), delta, gamma, Lnext); }
      | 33 => { let t0 = ddcg_alloc_temp(DtInt);
                // Effectful: grow MUTATES the memory size — a statement-
                // position call must execute, never be dropped by effect-δ.
                let head = deliver_tree(Effectful, build ir.MemGrow(
                               build ir.LoadLocal(t0, DtInt, nil)), delta, gamma, Lnext);
                gen(as[0], rho, loc(t0, DtInt), single(head), head); }
      | 34 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtInt);
                let t2 = ddcg_alloc_temp(DtInt);
                let done = cg_jump(gamma, Lnext);
                let fill = build ir.MemFill(build ir.LoadLocal(t0, DtInt, nil),
                               build ir.LoadLocal(t1, DtInt, nil),
                               build ir.LoadLocal(t2, DtInt, nil), done);
                let grd = mem_range_guard(t0, t2, fill, rho);
                let d2 = gen(as[2], rho, loc(t2, DtInt), single(grd), grd);
                let d1 = gen(as[1], rho, loc(t1, DtInt), single(d2), d2);
                gen(as[0], rho, loc(t0, DtInt), single(d1), d1); }
      | 35 => { let t0 = ddcg_alloc_temp(DtInt); let t1 = ddcg_alloc_temp(DtInt);
                let t2 = ddcg_alloc_temp(DtInt);
                let done = cg_jump(gamma, Lnext);
                let copy = build ir.MemCopy(build ir.LoadLocal(t0, DtInt, nil),
                               build ir.LoadLocal(t1, DtInt, nil),
                               build ir.LoadLocal(t2, DtInt, nil), done);
                let gsrc = mem_range_guard(t1, t2, copy, rho);
                let gdst = mem_range_guard(t0, t2, gsrc, rho);
                let d2 = gen(as[2], rho, loc(t2, DtInt), single(gdst), gdst);
                let d1 = gen(as[1], rho, loc(t1, DtInt), single(d2), d2);
                gen(as[0], rho, loc(t0, DtInt), single(d1), d1); }
      | _other => { let t0 = ddcg_alloc_temp(DtV128); let t1 = ddcg_alloc_temp(DtV128);
                let n = build ir.SimdShuffle(0, 0,
                            build ir.LoadLocal(t0, DtV128, nil),
                            build ir.LoadLocal(t1, DtV128, nil));
                let _ = sema_simd_fill(n, node);
                let head = deliver_tree(Pure, n, delta, gamma, Lnext);
                let mid = gen(as[1], rho, loc(t1, DtV128), single(head), head);
                gen(as[0], rho, loc(t0, DtV128), single(mid), mid); }
    };
}

// §20.3.6 the two Class.newInstance helpers, called only as `this.instantiable()` / `this.construct()`
// inside Class.newInstance — so the receiver is `this` (the Class), always non-null, no spill. The
// node operates on that receiver: instantiable? reads the factory funcref's nullness (i32), construct
// call_ref's it (ref). Both are private, so the receiver is the implicit `this`; `obj` is nil here.
rule class_intrinsic : ast.MethodCall(obj: rcvr, method: m, args: as)
                       where sema_is_class_intrinsic(node) {
    let self = build ir.LoadThis(DtRef, current_class_id());
    match (sema_class_intrinsic_kind(node)) {
        1      => cg_store(build ir.ClassInstantiable(self), delta, gamma, Lnext)
      | _other => cg_store(build ir.ClassConstruct(self),    delta, gamma, Lnext)
    };
}

rule arraycopy_intrinsic : ast.MethodCall(obj: rcvr, method: m, args: as)
                           where sema_is_arraycopy(node) {
    let src_arg = as[0];
    let width   = sema_array_elem_dt(src_arg);

    let t_src = ddcg_alloc_temp(DtRef);
    let t_so  = ddcg_alloc_temp(DtInt);
    let t_dst = ddcg_alloc_temp(DtRef);
    let t_do  = ddcg_alloc_temp(DtInt);
    let t_len = ddcg_alloc_temp(DtInt);

    let done = cg_jump(gamma, Lnext);
    let copy = build ir.ArrayCopy(width,
                 array_backing(t_dst, array_elem_ref(src_arg), width),
                 build ir.LoadLocal(t_do, DtInt, nil),
                 array_backing(t_src, array_elem_ref(src_arg), width),
                 build ir.LoadLocal(t_so, DtInt, nil),
                 build ir.LoadLocal(t_len, DtInt, nil),
                 done);
    let bounds  = arraycopy_bounds(t_src, t_so, t_dst, t_do, t_len, src_arg, width, copy,
                                    rho);
    let guarded = null_guard(t_src, null_guard(t_dst, bounds, rho), rho);

    // Evaluate the 5 args left-to-right into their temps, then run the guarded copy. BOTH
    // ref temps are typed from the CONCRETE src array descriptor (expr_ref(src_arg)) — not the
    // arg's own descriptor: a `null` literal dst has none (JLS §15.17.1.1 style), and dst is
    // the same overlay type as src in the concrete case, so its temp needs a valid typeidx.
    let d4 = cg_deliver_conv(as[4], DtInt, rho, loc(t_len, DtInt), single(guarded), guarded);
    let d3 = cg_deliver_conv(as[3], DtInt, rho, loc(t_do, DtInt), single(d4), d4);
    let d2 = cg_deliver_conv(as[2], DtRef, rho, vloc(t_dst, DtRef, expr_ref(src_arg)), single(d3), d3);
    let d1 = cg_deliver_conv(as[1], DtInt, rho, loc(t_so, DtInt), single(d2), d2);
    cg_deliver_conv(as[0], DtRef, rho, vloc(t_src, DtRef, expr_ref(src_arg)), single(d1), d1);
}

rule method_call : ast.MethodCall(obj: rcvr, method: m, args: as)
                   where not sema_is_arraycopy(node) and not sema_is_move_intrinsic(node)
                     and not sema_is_math_intrinsic(node) and not sema_is_class_intrinsic(node)
                     and not sema_is_simd_intrinsic(node) {
    let kind = sema_invoke_kind(node);
    kind < 0
      ? cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext)
      : { // The invoke carries the method's DEFINING class, not the receiver's
          // static type — `cp` (sema_method_index) is the method's index in its
          // defining class, so wasm_vtable_slot/wasm_func_index/functype must read
          // that same class (field 0 / the vtable are inherited, so an ancestor
          // class works for the struct.get; an inherited or interface call would
          // otherwise index the wrong methods vec). One (class, method) authority.
          let target_class = sema_method_decl_class(node);
          let cp           = sema_method_index(node);
          let dt           = sema_invoke_dt(node);
          let is_void      = sema_invoke_is_void(node);
          let has_receiver = kind != 0;

          // Receiver before args (legacy allocation order — preserves
          // slot numbers across the diff harness).
          let t_recv = has_receiver ? ddcg_alloc_temp(DtRef) : 0;
          let recv_load = has_receiver
              ? build ir.LoadLocal(t_recv, DtRef, nil)
              : nil;

          let t_args:    list<int>         = [];
          let arg_dts:   list<ir.datatype> = [];
          let arg_loads: list<ir_root>     = [];
          for (i, _) in as {
              let adt = sema_param_dt(target_class, cp, i);   // param type → §5.3 widening
              let ts  = ddcg_alloc_temp(adt);
              t_args    := t_args + [ts];
              arg_dts   := arg_dts + [adt];
              arg_loads := arg_loads + [build ir.LoadLocal(ts, adt, nil)];
          }
          let invoke_node = build_invoke_node(kind, target_class, cp,
                                                recv_load, arg_loads, dt, rho);
          let delivery   = call_delivery(invoke_node, is_void, dt,
                                          delta, gamma, Lnext);
          let args_chain = chain_call_args(as, as.count - 1,
                                            t_args, arg_dts, target_class, cp, delivery, rho);
          has_receiver
            ? (rcvr == nil
                /* Unqualified `m(...)` = `this.m(...)`. In a VIRTUAL method `this`
                 * (slot 0) is typed at the root class, so spill it via LoadThis,
                 * which re-narrows to the current class — storing the raw (ref root)
                 * LoadLocal(0) into the (ref current) receiver temp would mistype. */
                ? build ir.StoreLocal(t_recv, DtRef, build ir.ClassRef(current_class_id()),
                                      build ir.LoadThis(DtRef, current_class_id()),
                                      args_chain)
                /* §15.12.4.4: a null receiver throws NPE before the args evaluate. */
                : { let checked = null_guard(t_recv, args_chain, rho);
                    gen(rcvr, rho, locref(t_recv, expr_ref(rcvr)),
                        single(checked), checked); })
            : init_barrier(target_class, args_chain, rho); };   // §12.4.1: a static call initializes the declaring class
}

// JLS §10.6 — array initializer. Allocates a fresh array of the
// contextual element type, then stores each element by index into
// a temp slot for the array reference. Chain runs right-to-left so
// the StoreLocal of t_arr ends up at the spine head and the result
// (a LoadLocal of t_arr) lands at the tail.
// JLS §10.6, the constant case. Every element is a §15.27 constant and the element type is
// primitive, so the contents go in the module's data segment and ONE array.new_data builds the
// backing — no per-element store. This is the shape every string literal takes, so a literal's
// cost stops scaling with its LENGTH in both emitted bytes and compile time.
//
// The overlay is still built the ordinary way — a PrimArray wrapper whose `data` field holds
// the wasm array — because that is what every other array operation reads. Only the fill changes.
rule array_init_const : ast.ArrayInit(elems: es) where arrayinit_is_const(node) {
    let t_arr    = ddcg_alloc_temp(DtRef);
    let atype    = sema_arrayinit_atype(node);
    let delivery = cg_store(build ir.LoadLocal(t_arr, DtRef, nil), delta, gamma, Lnext);
    build_primarray_data_into(t_arr, atype, array_class_id(node),
                              const_data_offset(node), es.count,
                              rho_in_loop(rho), delivery, rho);
}

rule array_init : ast.ArrayInit(elems: es) where not arrayinit_is_const(node) {
    // A reference element type (class, or a nested array for a multi-dim init) carries
    // a ref descriptor and must allocate via NewRefArray so the array's element type is
    // the concrete reference; only a primitive element uses the atype-tagged NewArray.
    let eref   = array_elem_ref(node);
    let arr_dt = eref == nil ? sema_arrayinit_dt(node) : DtRef;
    let t_arr  = ddcg_alloc_temp(DtRef);
    let delivery = cg_store(build ir.LoadLocal(t_arr, DtRef, nil),
                             delta, gamma, Lnext);
    let chain    = chain_array_init(es, es.count - 1, t_arr, arr_dt, eref,
                                     delivery, rho);
    let size     = build ir.LoadConst(es.count, DtInt);
    // A primitive array is one concrete allocation; a reference array is the RefArray
    // wrapper (t_arr = new RefArray(); t_arr.data = new backing[count]) then the fill.
    eref == nil
      ? build_primarray_into(t_arr, sema_arrayinit_atype(node), array_class_id(node), size,
                             rho_in_loop(rho), chain, rho)
      : build_refarray_into(t_arr, size, array_elem_class(node), array_class_id(node),
                            rho_in_loop(rho), chain, rho);
}

// JLS §15.11.2 — `super.f`. Resolves the field through the parent
// chain; receiver is `this` (slot 0). For static super-fields the
// receiver is dropped and we emit GetStatic on the parent class.
rule super_access : ast.SuperAccess(field: f) {
    let parent = sema_super_parent_class_id();
    let dt     = sema_super_field_dt(node);
    let cp     = sema_super_field_cp(node);
    parent < 0
      ? cg_store(build ir.LoadConst(0, DtShort), delta, gamma, Lnext)
      : (sema_super_field_is_static(node)
          ? cg_deliver_effectful(build ir.GetStatic(dt, parent, cp),
                                  delta, gamma, Lnext)
          : cg_deliver_effectful(
              build ir.GetField(dt, build ir.LoadThis(DtRef, current_class_id()), parent, cp),
              delta, gamma, Lnext));
}

// JLS §15.25 — conditional (?:). Same shape as if as statement, but
// the value of the chosen arm is delivered to the parent (δ, γ). When
// γ=ret, each arm terminates in its own Return — no join needed.
// Otherwise arms inherit Lnext=Ljoin and their tail's .next falls
// through to Ljoin via cg_jump's L==Lnext rule — no explicit Goto.
rule ternary : ast.Ternary(test: t, then: th, else_: el) {
    match (gamma) {
        ret => { let rdt = current_return_dt();     // §15.25: arms promote to the return type
                 let Lthen = ddcg_label(cg_deliver_conv(th, rdt, rho, delta, gamma, Lnext));
                 let Lelse = ddcg_label(cg_deliver_conv(el, rdt, rho, delta, gamma, Lnext));
                 gen(t, rho, effect, pair(Lthen, Lelse), Lnext); }
      | _other => { let join_cont = cg_jump(gamma, Lnext);
                    let Ljoin = build ir.Nop(join_cont);
                    let Lthen = ddcg_label(ternary_arm(th, rho, delta, single(Ljoin), Ljoin));
                    let Lelse = ddcg_label(ternary_arm(el, rho, delta, single(Ljoin), Ljoin));
                    let test = gen(t, rho, effect, pair(Lthen, Lelse), Lnext);
                    let _ = record_scope(test, Ljoin, 0);  // join keyed by test head (as if_stmt)
                    test; }
    };
}

rule array_access_read : ast.ArrayAccess(arr: arr, index: idx) {
    let dt = sema_array_acc_dt(node);
    let t_a = ddcg_alloc_temp(DtRef);
    let t_i = ddcg_alloc_temp(DtInt);
    let tree = build ir.ArrayLoad(dt,
                 array_backing(t_a, array_elem_ref(arr), dt),
                 build ir.LoadLocal(t_i, DtInt, nil), array_elem_ref(arr));
    let head = cg_deliver_effectful(tree, delta, gamma, Lnext);
    // §15.13.1: bounds-check (array is non-null here), then the load. Null-check
    // fires earlier — right after the array ref is spilled, before the index.
    let bounds = bounds_guard(t_a, t_i, array_elem_ref(arr), dt, head, rho);
    let i_chain = gen(idx, rho, loc(t_i, DtInt), single(bounds), bounds);
    let checked = null_guard(t_a, i_chain, rho);
    gen(arr, rho, locref(t_a, expr_ref(arr)), single(checked), checked);
}

// JLS §15.26 — assignment. Dispatches on the target's shape:
//   Ident → local/param (gen-into-loc fast path) or field of current
//           class (put_field/put_static via temp spill)
//   FieldAccess → static (optional v-simple fast path) or instance
//                 (obj+v simple fast path, otherwise spill both)
//   ArrayAccess → spill a/i/v then ArrayStore (JLS §15.26.2 order)
//   SuperAccess → instance field on parent class with `this` receiver
// JLS §15.26.2 — compound assignment `target op= value`. Desugars
// to `target = target op value` with capture-LHS-first semantics.
// Const fast path: `local += int_lit` / `local -= int_lit` (when
// the delta fits in int16) emits a single Inc — that's inside
// compound_local. Per-target-shape rules below split the dispatch
// per the same shape rubric as `assign`.
rule compound_local_rule : ast.CompoundAssign(target: t, op: op, value: v)
                            where target_is_ident(t) and
                                  ident_is_local_or_param(t) {
    compound_local(sema_ident_slot(t), sema_ident_dt(t),
                   op, v, rho, delta, gamma, Lnext);
}
rule compound_ident_static_field_rule : ast.CompoundAssign(target: t, op: op, value: v)
                                         where target_is_ident(t) and
                                               ident_is_static_field(t) {
    compound_ident_field(t, true, op, v, rho, delta, gamma, Lnext);
}
rule compound_ident_instance_field_rule : ast.CompoundAssign(target: t, op: op, value: v)
                                           where target_is_ident(t) and
                                                 ident_is_instance_field(t) {
    compound_ident_field(t, false, op, v, rho, delta, gamma, Lnext);
}
rule compound_field_static_rule : ast.CompoundAssign(target: t, op: op, value: v)
                                   where target_is_static_field(t) {
    let dt     = sema_field_acc_dt(t);
    let cls_id = sema_field_obj_class_id(t);
    compound_field_static(t, op, v, dt, cls_id, rho, delta, gamma, Lnext);
}
rule compound_field_instance_rule : ast.CompoundAssign(target: t, op: op, value: v)
                                     where target_is_instance_field(t) {
    let dt     = sema_field_acc_dt(t);
    /* struct.set indexes the field in its DECLARING class (sema_field_index is decl-class-relative),
     * exactly as the read (instance_field_acc) does — NOT the receiver's static type, which for an
     * inherited field gives field_abs a wrong base. §15.11: field access is not virtual. */
    let cls_id = sema_field_decl_class(t);
    compound_field_instance(field_acc_obj(t), t, op, v, dt, cls_id,
                            rho, delta, gamma, Lnext);
}
rule compound_array_rule : ast.CompoundAssign(target: t, op: op, value: v)
                            where target_is_array_access(t) {
    let arr_dt = sema_array_acc_dt(t);
    compound_array(array_acc_arr(t), array_acc_index(t),
                   op, v, arr_dt, rho, delta, gamma, Lnext);
}
rule compound_other : ast.CompoundAssign(target: t, op: op, value: v) {
    panic_unreachable("compound_assign: invalid lvalue — sema gap");
}

// JLS §15.26 — assignment. Split into per-target-shape rules. The
// nested constructor patterns in the rule heads filter on target's
// AST shape; field-access splits further (static vs instance) via
// where-guard on a sema-side classifier. The outer head also binds
// `t` so the body can pass the matched target to helpers expecting
// the FieldAccess/ArrayAccess/SuperAccess node directly.
rule assign_ident : ast.Assign(target: t, value: v)
                     where target_is_ident(t) {
    assign_ident_target(t, v, rho, delta, gamma, Lnext);
}
rule assign_static_field_rule : ast.Assign(target: t, value: v)
                                 where target_is_static_field(t) {
    let dt     = sema_field_acc_dt(t);
    let cls_id = sema_field_obj_class_id(t);
    assign_static_field(t, v, dt, cls_id, rho, delta, gamma, Lnext);
}
rule assign_instance_field_rule : ast.Assign(target: t, value: v)
                                   where target_is_instance_field(t) {
    let dt     = sema_field_acc_dt(t);
    /* The field's DECLARING class (matches the read + sema_field_index's decl-relative index);
     * the receiver's static type would mis-base field_abs for an inherited field. §15.11. */
    let cls_id = sema_field_decl_class(t);
    assign_instance_field(field_acc_obj(t), t, v, dt, cls_id,
                          rho, delta, gamma, Lnext);
}
rule assign_array_rule : ast.Assign(target: t, value: v)
                          where target_is_array_access(t) {
    let arr_dt = sema_array_acc_dt(t);
    assign_array(array_acc_arr(t), array_acc_index(t),
                 v, arr_dt, rho, delta, gamma, Lnext);
}
rule assign_super_field_rule : ast.Assign(target: t, value: v)
                                where target_is_super_access(t) {
    assign_super_field(t, v, rho, delta, gamma, Lnext);
}
rule assign_other : ast.Assign(target: t, value: v) {
    panic_unreachable("assign: invalid lvalue — sema gap");
}

// JLS §14.12 — while loop. Per Dybvig §0.2 Figure 5, `while T B`
// desugars to `loop (if T B break)`. The SIR shape has a back-edge:
//   Ltop:    test → Branch(true→body, false→Goto(Lbreak))
//   body:    body's chain → Goto(Ltop)
//   Lbreak:  parent's continuation
//
// Body's tail Goto(Ltop) is the back-edge — Ltop is forward-declared
// as Nop(nil) so the body can reference it before test_spine exists.
// sir_set_next stitches Ltop's next to test_spine after both are
// built. Both back-edge and false-arm exit are explicit Gotos, never
// fall-throughs (any join is multi-predecessor; BURS layout puts
// Ltop/Lbreak nowhere adjacent to where the arms end).
//
// Break/Continue support requires loop-frame state (push/pop) — those
// remain in DESUGARED until that state lands. Bodies that reach
// Break or Continue panic via the desugared-handler path.
// A Nop is a LABEL ANCHOR for a control merge — it emits no bytes, it gives the merge an identity
// the structurer resolves `br` depths against. So a Nop exists iff there is a merge:
//   - Ltop  : loop entry ∪ back-edge          — always a merge.
//   - Lbreak: the breaks ∪ the loop's fall-through — a merge only if the loop can complete
//             normally (§14.19). When it cannot, there is no exit, hence no anchor: `nil`.
// And §14.19's constant-true condition is the same fact codegen needs: `while (true)` has no test
// to evaluate, exactly like `for (;;)`. Emitting `i32.const 1` + Branch would put a dead edge into
// the graph, keeping an exit anchor alive that nothing reaches.
rule while_stmt : ast.While(test: t, body: b) {
    let Lbreak    = sema_can_complete_normally(node)
                      ? build ir.Nop(cg_jump(gamma, Lnext))
                      : nil;
    let Ltop      = build ir.Nop(nil);
    let body_rho  = loop_frame(Lbreak, Ltop, rho);
    let body_spine = gen(b, body_rho, effect, single(Ltop), nil);
    let test_spine = sema_is_constant_true(t)
        ? body_spine
        : gen(t, rho, effect, pair(body_spine, Lbreak), body_spine);
    let _ = sir_set_next(Ltop, test_spine);
    let _ = record_scope(Ltop, Lbreak, 1);
    Ltop;
}

// JLS §14.14 — for-loop. `for(init; test; update) body` lowers to
//   init;
//   loop (if test (sequence body update) break)
//
// SIR shape:
//   init   →  Ltop                              (init's tail Goto's Ltop)
//   Ltop:     test → Branch(true→body, false→Goto(Lbreak))
//   body:     body chain → Goto(Lupdate)
//   Lupdate:  update chain → Goto(Ltop)
//   Lbreak:   parent's continuation
//
// Update chain is forward-iterated via chain_for_updates: each
// update except the last falls through to the next; the last emits
// an explicit Goto(Ltop). Empty-update fast path: Lupdate.next is
// just a Goto(Ltop). Missing test fast path: Ltop.next is body
// directly (unconditional loop).
//
// Break/Continue support waits on loop-frame state (Phase 2f
// continuation). Until then, bodies that hit Break/Continue panic.
rule for_stmt : ast.For(init: i, test: t, update: u, body: b) {
    let Ltop     = build ir.Nop(nil);
    let Lupdate  = build ir.Nop(nil);
    // §14.19, same rule as `while`: absent (or constant-true) condition and no break that exits
    // the loop ⇒ it cannot complete normally ⇒ its exit is not a merge, so it gets no anchor.
    let Lbreak   = sema_can_complete_normally(node)
                     ? build ir.Nop(cg_jump(gamma, Lnext))
                     : nil;
    let body_rho = loop_frame(Lbreak, Lupdate, rho);
    let update_head = u.count == 0
        ? Ltop
        : chain_for_updates(u, 0, u.count - 1, Ltop, body_rho);
    let _ = sir_set_next(Lupdate, update_head);
    let body_spine = gen(b, body_rho, effect, single(Lupdate), nil);
    // No condition, or the constant `true`: no test to evaluate, no false edge (§14.19).
    let test_spine = t == nil
        ? body_spine
        : sema_is_constant_true(t)
            ? body_spine
            : gen(t, rho, effect, pair(body_spine, Lbreak), body_spine);
    let _ = sir_set_next(Ltop, test_spine);
    let _ = record_scope(Ltop, Lbreak, 1);
    // Lupdate is the CONTINUE target: the body falls through to it, and every
    // `continue` jumps to it — so control converges there. That is a merge the
    // OPTIMIZER must know about (nothing may be lifted across it as if the step
    // were forced). Kind 4 = CONTINUE, NOT 3 = MERGE: a MERGE is the structurer's
    // emit-once label, and claiming one here makes emit_spine re-emit forever.
    let _ = record_scope(Lupdate, Lupdate, 4);
    i == nil
      ? Ltop
      : gen(i, rho, effect, single(Ltop), nil);
}

// JLS §14.11 — switch statement. Lowers to SIR_SWITCH which BURS
// emits as stableswitch / itableswitch / slookupswitch /
// ilookupswitch based on selector width and case density.
//   - Lbreak: parent's continuation; all `break;` and the default
//     fall-through target this single Nop
//   - Body chain: cases compiled right-to-left, fall-through
//     between adjacent cases (last body Goto's Lbreak)
//   - case_targets/case_values arrays: sorted ascending by sema
//   - DEFAULT_ONLY degeneracy short-circuits — emit selector for
//     side effects only, then jump to default body or Lbreak
// Lbreak is the switch's exit merge: every `break`, the last group's fall-out, and — when the block
// has no `default:` label — the br_table's default landing all arrive there. §14.19 (with §14.9's
// missing fifth disjunct) says the switch can complete normally iff at least one of those exists, so
// when it cannot there is no merge and no anchor. Note the interlock: a switch that cannot complete
// normally necessarily HAS a `default:` label, so build_switch_node never needs Lbreak for the
// br_table's default target in that case.
rule switch_stmt : ast.Switch(selector: sel, cases: cs) {
    let Lbreak    = sema_can_complete_normally(node)
                      ? build ir.Nop(cg_jump(gamma, Lnext))
                      : nil;
    let body_rho  = loop_frame(Lbreak, nil, rho);
    let sel_dt    = sema_switch_selector_dt(node);
    sema_switch_is_default_only(node)
      ? { let default_idx = sema_switch_default_idx(node);
          let default_head = default_idx < 0
              ? Lbreak
              : chain_case_body(cs[default_idx].stmts, 0, Lbreak, body_rho);
          gen(sel, rho, effect, single(ddcg_label(default_head)),
              ddcg_label(default_head)); }
      : { let body_heads  = chain_switch_cases(cs, 0, Lbreak, body_rho);
          let t_sel       = ddcg_alloc_temp(sel_dt);
          let switch_node = build_switch_node(node, body_heads, Lbreak,
              build ir.LoadLocal(t_sel, sel_dt, nil), sel_dt);
          // Sidecar: the WASM structured emit frames the br_table from the
          // Switch node and brs `break` to Lbreak (kind 2 = switch scope).
          let _ = record_scope(switch_node, Lbreak, 2);
          gen(sel, rho, loc(t_sel, sel_dt),
              single(switch_node), switch_node); };
}

// JLS §14.13 — do-while loop. Test runs after body; continue targets
// Lcont (the test) so partial-iteration semantics match Java.
//   Ltop:    body's chain → Lcont
//   Lcont:   test → Branch(true→Goto(Ltop), false→Lbreak)
//   Lbreak:  parent's continuation (γ.L directly, no wrap — see note)
//
// Note on Lbreak: unlike while-loop's Lbreak (which wraps γ.L in a
// Nop), here Lbreak is just γ.L. The diff harness preserves this
// asymmetry — match legacy. For γ=ret, emit a ReturnVoid as Lbreak;
// for γ=pair (defensive — stmt context shouldn't see pair), use Lnext.
//
// Body uses Lnext=Lcont, allowing tail fall-through (no extra Goto).
// Lcont is forward-declared and back-patched once test_branch exists;
// Ltop similarly back-patches to body.
rule do_while_stmt : ast.DoWhile(test: t, body: b) {
    // §14.19: `do … while (true);` with no break that exits it cannot complete normally, so its
    // exit is not a merge and gets no anchor. A constant-true tail test is an unconditional
    // back-edge — no test, no false edge.
    let Lbreak = sema_can_complete_normally(node)
      ? match (gamma) {
            single(L)    => L
          | ret          => build ir.ReturnVoid()
          | pair(Lt, Lf) => Lnext
        }
      : nil;
    let Ltop     = build ir.Nop(nil);
    let Lcont    = build ir.Nop(nil);
    let body_rho = loop_frame(Lbreak, Lcont, rho);
    let test_spine = sema_is_constant_true(t)
        ? Ltop
        : gen(t, rho, effect, pair(Ltop, Lbreak), Ltop);
    let _ = sir_set_next(Lcont, test_spine);
    let body_spine = gen(b, body_rho, effect, single(Lcont), Lcont);
    let _ = sir_set_next(Ltop, body_spine);
    // Sidecar: the WASM structured emit frames `loop $top` from Ltop and brs
    // breaks to Lbreak (kind 1 = loop scope) — same as while/for. Unlike them
    // the test is at the loop TAIL (on_true = Ltop is a back-edge), which the
    // backend's Branch handler distinguishes via loop_scope_at(on_true).
    let _ = record_scope(Ltop, Lbreak, 1);
    // Lcont is the CONTINUE target — same rule as `for`'s Lupdate: a merge for
    // the optimizer, kind 4, never the structurer's MERGE label.
    let _ = record_scope(Lcont, Lcont, 4);
    Ltop;
}

// JLS §14.9 — if-then-else statement. Per Dybvig §0.2 Figure 5
// adapted to a CPS graph + BURS layout:
//   Ljoin = Nop(parent-continuation)
//   Lthen = label(gen then  with γ=single(Ljoin), Lnext=nil)
//   Lelse = label(gen else  with γ=single(Ljoin), Lnext=nil)
//          OR a fresh Goto(Ljoin) wrapped in a Nop when there's no else
//   gen test with γ=pair(Lthen, Lelse), Lnext=Lnext
//
// Lnext=nil for the arms forces explicit Goto(Ljoin) at each arm tail
// rather than fall-through — fall-through is unsafe at any join, and
// BURS layout requires each arm to be its own subgraph terminating in
// a real Goto so the layout pass can place them correctly.
// Ljoin is where the arms converge. §14.19: an if-then-else can complete normally iff one of its
// arms can, and an if-then always can (the false path reaches the join). So Ljoin is a merge unless
// BOTH arms complete abruptly, in which case nothing arrives and there is no anchor to build. The
// backend then has no reason to ask whether the arms fell through — the frontend already knows.
rule if_stmt : ast.If(test: t, then: th, else_: el) {
    let join_cont = cg_jump(gamma, Lnext);
    let Ljoin = sema_can_complete_normally(node) ? build ir.Nop(join_cont) : nil;
    let Lthen = ddcg_label(gen(th, rho, delta, single(Ljoin), nil));
    let Lelse = el == nil
        ? Ljoin
        : ddcg_label(gen(el, rho, delta, single(Ljoin), nil));
    let test = gen(t, rho, effect, pair(Lthen, Lelse), Lnext);
    // Carry the if's control destination forward — Ljoin is the γ both arms
    // inherit (Dybvig Fig.5) — keyed by the test HEAD, so the backend READS it
    // (one sidecar scan by node, no merge-finding walk). Short-circuit && / ||
    // intermediate branches (Fig.7) get no record: they thread the SAME γ,
    // which the backend already carries as the region `stop`.
    let _ = record_scope(test, Ljoin, 0);
    test;
}

// JLS §14.4 — local variable declaration. Iterates declarators in
// textual order, initializing each that has an initializer.
rule local_var_decl : ast.LocalVarDecl(ty: t, decls: ds) {
    let var_dt = match (t) {
        ast.IntType()    => DtInt
      | ast.ByteType()   => DtByte
      | ast.BoolType()   => DtByte
      | ast.ShortType()  => DtShort
      | ast.CharType()   => DtChar
      | ast.LongType()   => DtLong
      | ast.FloatType()  => DtFloat
      | ast.DoubleType() => DtDouble
      | ast.ClassType()  => DtRef
      | ast.ArrayType()  => DtRef
      | _other           => DtShort
    };
    let last = last_init_index(ds);
    last < 0
      ? cg_jump(gamma, Lnext)
      : chain_decls(ds, 0, last, var_dt, rho, delta, gamma, Lnext);
}

// JLS §14.15 — break. Sema resolved the loop-frame depth at analysis
// (finally_frames between current point and target are crossed but
// don't count toward depth). walk_for_break compiles each crossed
// finally body before the Goto to the target's break_target.
rule break_stmt : ast.Break() {
    let depth = sema_break_target_depth(node);
    depth < 0
      ? cg_jump(gamma, Lnext)
      : match (rho_skip(rho, depth)) {
            rho_root => cg_jump(gamma, Lnext)
          | finally_frame(body: _, region: _, parent: _) => cg_jump(gamma, Lnext)
          | try_frame(region: _, parent: _) => cg_jump(gamma, Lnext)
          | loop_frame(break_target: bt, continue_target: _, parent: _) =>
                walk_for_break(rho, depth, ddcg_label(bt))
        };
}

// JLS §14.16 — continue. Same depth-walk; uses continue_target
// instead. Labeled-block frames have nil continue_target — sema
// rejects `continue label;` against them at analysis time, so we
// only encounter loop frames here.
rule continue_stmt : ast.Continue() {
    let depth = sema_continue_target_depth(node);
    depth < 0
      ? cg_jump(gamma, Lnext)
      : match (rho_skip(rho, depth)) {
            rho_root => cg_jump(gamma, Lnext)
          | finally_frame(body: _, region: _, parent: _) => cg_jump(gamma, Lnext)
          | try_frame(region: _, parent: _) => cg_jump(gamma, Lnext)
          | loop_frame(break_target: _, continue_target: ct, parent: _) =>
                ct == nil
                  ? cg_jump(gamma, Lnext)
                  : walk_for_break(rho, depth, ddcg_label(ct))
        };
}

// JLS §14.7 — labeled statement. Sema resolved labels to depths,
// so the label string itself is unused at codegen time. For loop/
// switch bodies, just delegate (the inner loop pushes its own
// frame). For block bodies, push our own labeled-block frame so
// breaks targeting this label have something to land on.
rule labeled_stmt : ast.Labeled(body: b) {
    let body_is_loop_or_switch = match (b) {
        ast.While()   => true
      | ast.DoWhile() => true
      | ast.For()     => true
      | ast.Switch()  => true
      | _other        => false
    };
    body_is_loop_or_switch
      ? gen(b, rho, delta, gamma, Lnext)
      : { let Lbreak = match (gamma) {
              single(L)    => L
            | ret          => build ir.ReturnVoid()
            | pair(Lt, Lf) => Lnext
          };
          let body_rho = loop_frame(Lbreak, nil, rho);
          gen(b, body_rho, delta, gamma, Lnext); };
}
