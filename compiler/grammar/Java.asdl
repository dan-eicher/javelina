// Java.asdl — AST for Java 1.0
//
// Module name "java" → constructor prefix java_xxx()
// Generated by: asdl -i Java.asdl -t c.inja -o java_ast.h -lang c

module ast {

    type ident   = "const char*"
    type int32   = "int32_t"
    type int64   = "int64_t"
    type float32 = "float"
    type float64 = "double"

    // ── Compilation unit ─────────────────────────────────────

    program = Program(name ?package_, import *imports, type_decl *types)

    import = SingleImport(ident *parts)
           | WildcardImport(ident *parts)

    // ── Top-level declarations ───────────────────────────────

    type_decl = ClassDecl(ident name, name ?super_class, name *interfaces,
                          modifier *mods, member *members)
              | InterfaceDecl(ident name, name *extends_,
                              modifier *mods, member *members)

    // ── Members ──────────────────────────────────────────────

    member = FieldDecl(type ty, var_decl *decls, modifier *mods)
           | MethodDecl(type ret, ident name, param *params,
                        name *throws_, stmt ?body, modifier *mods)
           | ConstructorDecl(ident name, param *params,
                             name *throws_, stmt body, modifier *mods)
           | StaticInit(stmt body)

    var_decl = VarDecl(ident name, int32 dims, expr ?init)

    param = Param(type ty, ident name)

    modifier = Public | Protected | Private | Static | Final
             | Abstract | Synchronized | Transient | Volatile | Native

    // ── Names (possibly qualified) ───────────────────────────

    name = SimpleName(ident id)
         | QualifiedName(name qualifier, ident id)

    // ── Types ────────────────────────────────────────────────

    type = ByteType | ShortType | IntType | LongType
         | CharType | FloatType | DoubleType
         | BoolType | VoidType
         | ClassType(name name)
         | ArrayType(type element)

    // ── Statements ───────────────────────────────────────────

    stmt = Block(stmt *stmts)
         | LocalVarDecl(type ty, var_decl *decls, modifier *mods)
         | ExprStmt(expr e)
         | If(expr test, stmt then, stmt ?else_)
         | While(expr test, stmt body)
         | DoWhile(stmt body, expr test)
         | For(stmt ?init, expr ?test, expr *update, stmt body)
         | Switch(expr selector, switch_case *cases)
         | Try(stmt body, catch_clause *catches, stmt ?finally_)
         | Throw(expr e)
         | Return(expr ?value)
         | Break(ident ?label)
         | Continue(ident ?label)
         | Labeled(ident label, stmt body)
         | Empty

    switch_case  = SwitchCase(expr ?value, stmt *stmts)
    catch_clause = CatchClause(type ty, ident name, stmt body)

    // ── Expressions ──────────────────────────────────────────

    expr = IntLit(int32 value)
         | LongLit(int64 value)
         | FloatLit(float32 value)
         | DoubleLit(float64 value)
         | CharLit(int32 value)
         | BoolLit(bool value)
         // 3.10.5. `chars` is the ArrayInit of UTF-16 code units the literal denotes. The node
         // survives into sema so 15.27 can fold a constant String expression and 3.10.5 can
         // intern the result; the parser used to desugar straight to new String(chars).intern(),
         // which left no literal for either rule to see. sema desugars it after folding.
         | StringLit(expr chars)
         | NullLit
         | Ident(ident name)
         | FieldAccess(expr obj, ident field)
         | ArrayAccess(expr arr, expr index)
         | MethodCall(expr ?obj, ident method, expr *args)
         | New(name class_, expr *args)
         | NewArray(type element, expr *dims)
         | ArrayInit(expr *elems)
         | Cast(type ty, expr e)
         | InstanceOf(expr e, type ty)
         | Unary(unop op, expr e)
         | Binary(binop op, expr lhs, expr rhs)
         | Assign(expr target, expr value)
         | CompoundAssign(binop op, expr target, expr value)
         | Ternary(expr test, expr then, expr else_)
         | This
         | Super
         | SuperAccess(ident field)
         | SuperCall(ident method, expr *args)
         | ConstructorCall(bool is_super, expr *args)
         attributes (int32 etype)  // effective Java type tag (JT_* enum)

    unop = Pos | Neg | BitNot | LogNot | PreInc | PreDec | PostInc | PostDec

    binop = Add | Sub | Mul | Div | Rem
          | Shl | Shr | Ushr
          | BitAnd | BitOr | BitXor
          | Eq | Ne | Lt | Gt | Le | Ge
          | And | Or
}
